    a
        owl:NamedIndividual ,
        cmns-ra:Registry ;
    rdfs:label "National Center for Biotechnology Information Gene Database" ;
    skos:definition "registry published by the National Center For Biotechnology Information that integrates information from a wide range of species" ;
    cmns-av:abbreviation "Gene" ;
    cmns-av:directSource <https://www.ncbi.nlm.nih.gov/gene> ;
    cmns-dsg:hasTextualName "National Center for Biotechnology Information Gene Database" ;
