idmp-nara:NationalCancerInstituteThesaurus
    a
        owl:NamedIndividual ,
        cmns-ra:Registry ;
    rdfs:label "National Cancer Institute Thesaurus" ;
    skos:definition "registry that provides reference terminology for many NCI and other systems that is widely used across the healthcare industry as the basis for vocabulary and terminology work" ;
    skos:note "It covers vocabulary for clinical care, translational and basic research, and public information and administrative activities." ;
    cmns-av:abbreviation "NCIt" ;
    cmns-av:directSource <https://ncithesaurus.nci.nih.gov/ncitbrowser/> ;
    cmns-dsg:hasTextualName "NCI Thesaurus" ;
    cmns-org:isManagedBy idmp-nara:NationalCancerInstituteRegistrationAuthority ;
.

