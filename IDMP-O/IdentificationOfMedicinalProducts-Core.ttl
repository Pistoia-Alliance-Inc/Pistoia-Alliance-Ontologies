idmp-spor:hasSPORDomain
    a owl:ObjectProperty ;
    rdfs:label "has SPOR domain" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:range idmp-spor:SPOR-Domain ;
    rdfs:subPropertyOf
        cmns-cls:isClassifiedBy ,
        cmns-cxtdsg:isApplicableIn ;
    skos:definition "indicates the domain in which a particular substance or product is used from a Substances Products Organisations Referentials (SPOR) perspective" ;
.

idmp-spor:hasSPOROtherName
    a owl:ObjectProperty ;
    rdfs:label "has SPOR other name" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:range idmp-spor:SPORTermName ;
    rdfs:subPropertyOf cmns-dsg:hasName ;
    skos:definition "provides an alternate name of a given term" ;
.

idmp-spor:hasSPORShortName
    a owl:ObjectProperty ;
    rdfs:label "has SPOR short name" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:range idmp-spor:SPORTermName ;
    rdfs:subPropertyOf cmns-dsg:hasName ;
    skos:definition "provides an abbreviated name of a given term" ;
.

idmp-spor:hasSPORStatus
    a owl:ObjectProperty ;
    rdfs:label "has SPOR status" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:range idmp-spor:SPOR-RecordStatus ;
    rdfs:subPropertyOf cmns-cls:isClassifiedBy ;
    skos:definition "indicates the status of the vocabulary term in Substances Products Organisations Referentials (SPOR)" ;
.

idmp-spor:hasSPORTermDescription
    a owl:ObjectProperty ;
    rdfs:label "has SPOR term description" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:range idmp-spor:SPORTermDescription ;
    rdfs:subPropertyOf cmns-dsg:isDescribedBy ;
    skos:definition "provides a language-specific statement describing the term" ;
.

idmp-spor:hasSPORTermName
    a owl:ObjectProperty ;
    rdfs:label "has SPOR term name" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:range idmp-spor:SPORTermName ;
    rdfs:subPropertyOf cmns-dsg:hasName ;
    skos:definition "provides the name of a given term" ;
.

idmp-spor:hasSPORVisibility
    a owl:ObjectProperty ;
    rdfs:label "has SPOR visibility" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:range idmp-spor:SPOR-DataClassification ;
    rdfs:subPropertyOf cmns-cls:isCharacterizedBy ;
    skos:definition "characterizes the vocabulary term with respect to whether or not it is public, has restricted access, or other visibility in Substances Products Organisations Referentials (SPOR)" ;
.

idmp-meddra:MedDRAHighLevelGroupTerm
    a owl:Class ;
    rdfs:label "MedDRA high level group term" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:allValuesFrom idmp-meddra:MedDRASystemOrganClass ;
            owl:onProperty cmns-col:isMemberOf ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom idmp-meddra:MedDRAHighLevelTerm ;
            owl:onProperty cmns-col:hasMember ;
        ] ,
        [
            a owl:Restriction ;
            owl:hasValue idmp-meddra:MedDRATermClassifier-HighLevelGroupTerm ;
            owl:onProperty cmns-cls:isClassifiedBy ;
        ] ,
        idmp-meddra:MedDRATerm ;
    skos:definition "term that groups related high level terms" ;
.

idmp-meddra:MedDRAHighLevelTerm
    a owl:Class ;
    rdfs:label "MedDRA high level term" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:allValuesFrom idmp-meddra:MedDRAPreferredTerm ;
            owl:onProperty cmns-col:hasMember ;
        ] ,
        [
            a owl:Restriction ;
            owl:hasValue idmp-meddra:MedDRATermClassifier-HighLevelTerm ;
            owl:onProperty cmns-cls:isClassifiedBy ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom idmp-meddra:MedDRAHighLevelGroupTerm ;
            owl:onProperty cmns-col:isMemberOf ;
        ] ,
        idmp-meddra:MedDRATerm ;
    skos:definition "term that groups related preferred terms based upon anatomy, pathology, physiology, etiology or function" ;
.

idmp-meddra:MedDRAIdentifier
    a owl:Class ;
    rdfs:label "MedDRA identifier" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:onClass idmp-meddra:MedDRATerm ;
            owl:onProperty cmns-id:identifies ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        ] ,
        [
            a owl:Restriction ;
            owl:hasValue idmp-meddra:MedicalDictionaryForRegulatoryActivities ;
            owl:onProperty cmns-ra:isRegisteredIn ;
        ] ,
        cmns-ra:RegisteredIdentifier ;
    skos:definition "identifier for terms defining medical condition that are registered in the Medical Dictionary for Regulatory Activities registry" ;
    skos:note "The MedDRA code is an eight digit numeric code. MedDRA codes are unique and are never reused." ;
    cmns-av:synonym "MedDRA code" ;
.

idmp-meddra:MedDRALowestLevelTerm
    a owl:Class ;
    rdfs:label "MedDRA lowest level term" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass idmp-meddra:MedDRAPreferredTerm ;
            owl:onProperty cmns-col:isMemberOf ;
        ] ,
        [
            a owl:Restriction ;
            owl:hasValue idmp-meddra:MedDRATermClassifier-LowestLevelTerm ;
            owl:onProperty cmns-cls:isClassifiedBy ;
        ] ,
        idmp-dtp:ISO21090-ConceptDescriptor ,
        idmp-meddra:MedDRATerm ;
    skos:definition "most specific designation (term) that is registered in the Medical Dictionary for Regulatory Activities registry" ;
    skos:note "MedDRA LLTs can be used in ISO IDMP as concept descriptors in many places. Some jurisdictions require the use of MedDRA LLTs for specific properties in ISO IDMP." ;
.

idmp-meddra:MedDRAMaintenanceAndSupportServicesOrganization
    a
        owl:NamedIndividual ,
        cmns-org:Organization ;
    rdfs:label "MedDRA Maintenance and Support Services Organization" ;
    skos:definition "organization under the oversight of the ICH MedDRA Management Committee, the key function of the MSSO is to maintain, distribute, and support MedDRA on behalf of MedDRA users" ;
    cmns-av:abbreviation
        "MSSO" ,
        "MedDRA MSSO" ;
    cmns-av:adaptedFrom "https://www.meddra.org/about-meddra/organisation/msso" ;
    cmns-org:isSubUnitOf idmp-ra:InternationalCouncilForHarmonisationOfTechnicalRequirementsForPharmaceuticalsForHumanUse ;
.

idmp-meddra:MedDRAPreferredTerm
    a owl:Class ;
    rdfs:label "MedDRA preferred term" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:hasSelf true ;
            owl:onProperty cmns-col:hasMember ;
        ] ,
        [
            a owl:Restriction ;
            owl:hasValue idmp-meddra:MedDRATermClassifier-PreferredTerm ;
            owl:onProperty cmns-cls:isClassifiedBy ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom
                [
                    a owl:Class ;
                    owl:unionOf (
                        idmp-meddra:MedDRAHighLevelTerm
                        idmp-meddra:MedDRAPreferredTerm
                    ) ;
                ] ;
            owl:onProperty cmns-col:isMemberOf ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty cmns-col:hasMember ;
            owl:someValuesFrom idmp-meddra:MedDRALowestLevelTerm ;
        ] ,
        idmp-dtp:ISO21090-ConceptDescriptor ,
        idmp-meddra:MedDRATerm ;
    skos:definition "distinct descriptor (single medical concept) for a symptom, sign, disease diagnosis, therapeutic indication, investigation, surgical or medical procedure, and medical social or family history characteristic" ;
    skos:note "Each preferred term contains at least itself as lower level term." ;
.

idmp-meddra:MedDRARegistrationAuthority
    a
        owl:NamedIndividual ,
        cmns-ra:RegistrationAuthority ;
    rdfs:label "MedDRA registration authority" ;
    skos:definition "Registration authority (RA) for registration of terms or concepts in the Medical Dictionary for Regulatory Activities (MedDRA) played by the MedDRA Maintenance and Support Services Organization (MSSO)" ;
    cmns-av:abbreviation "MedDRA RA" ;
    cmns-org:manages idmp-meddra:MedicalDictionaryForRegulatoryActivities ;
    cmns-rlcmp:isPlayedBy idmp-meddra:MedDRAMaintenanceAndSupportServicesOrganization ;
.

idmp-meddra:MedDRASystemOrganClass
    a owl:Class ;
    rdfs:label "MedDRA system organ class" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:hasValue idmp-meddra:MedDRATermClassifier-SystemOrganClass ;
            owl:onProperty cmns-cls:isClassifiedBy ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom idmp-meddra:MedDRAHighLevelGroupTerm ;
            owl:onProperty cmns-col:hasMember ;
        ] ,
        idmp-meddra:MedDRATerm ;
    skos:definition "grouping of higher level group terms by etiology, manifestation site or purpose" ;
    skos:note "In addition, there is a System Organ Class (SOC) to contain issues pertaining to products and one to contain social circumstances." ;
    cmns-av:abbreviation "SOC" ;
.

idmp-meddra:MedDRATerm
    a owl:Class ;
    rdfs:label "MedDRA term" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:hasValue idmp-meddra:MedicalDictionaryForRegulatoryActivities ;
            owl:onProperty cmns-ra:isRegisteredIn ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty cmns-cls:isClassifiedBy ;
            owl:someValuesFrom idmp-meddra:MedDRATermClassifier ;
        ] ,
        cmns-cxtdsg:ContextualDesignation ;
    skos:definition "designation, term or concept that is registered in the Medical Dictionary for Regulatory Activities registry" ;
    skos:note "The MedDRA term name is a 100 character alphanumeric field used to describe the concept or term." ;
.

idmp-meddra:MedDRATermClassificationScheme
    a
        owl:NamedIndividual ,
        cmns-cls:ClassificationScheme ,
        cmns-cds:CodeSet ;
    rdfs:label "Medical Dictionary for Regulatory Activities term classification scheme" ;
    skos:definition "classification scheme used in MedDRA for classifying medical terms by hierarchical order" ;
.

idmp-meddra:MedDRATermClassifier
    a owl:Class ;
    rdfs:label "MedDRA term classifier" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:hasValue idmp-meddra:MedDRATermClassificationScheme ;
            owl:onProperty cmns-col:isMemberOf ;
        ] ,
        [
            a owl:Restriction ;
            owl:hasValue idmp-meddra:MedDRATermClassificationScheme ;
            owl:onProperty cmns-dsg:isDefinedIn ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty cmns-cls:classifies ;
            owl:someValuesFrom idmp-meddra:MedDRATerm ;
        ] ,
        cmns-cls:Classifier ,
        cmns-cds:CodeElement ;
    owl:equivalentClass
        [
            a owl:Class ;
            owl:oneOf (
                idmp-meddra:MedDRATermClassifier-HighLevelGroupTerm
                idmp-meddra:MedDRATermClassifier-HighLevelTerm
                idmp-meddra:MedDRATermClassifier-LowestLevelTerm
                idmp-meddra:MedDRATermClassifier-PreferredTerm
                idmp-meddra:MedDRATermClassifier-SystemOrganClass
            ) ;
        ] ;
    skos:definition "classifier indicating that a term appears at a particular level in the hierarchy of terms in the Medical Dictionary for Regulatory Activities registry" ;
    skos:note "Multiple MedDRA terms may be classified at the same level." ;
.

idmp-meddra:MedDRATermClassifier-HighLevelGroupTerm
    a
        owl:NamedIndividual ,
        idmp-meddra:MedDRATermClassifier ,
        cmns-cds:CodeElement ;
    rdfs:label "MedDRA term classifier - high level group term" ;
    skos:definition "classifier for terms that groups together related High Level Terms (HLGT)" ;
    cmns-av:acronym "HLGT" ;
    cmns-av:adaptedFrom "https://www.meddra.org/how-to-use/basics/hierarchy" ;
    cmns-txt:hasTextValue "HLGT" ;
.

idmp-meddra:MedDRATermClassifier-HighLevelTerm
    a
        owl:NamedIndividual ,
        idmp-meddra:MedDRATermClassifier ,
        cmns-cds:CodeElement ;
    rdfs:label "MedDRA term classifier - high level term" ;
    skos:definition "classifier for terms that group together related Preferred Terms (PT)s based upon anatomy, pathology, physiology, etiology or function. HLTs, related to each other by anatomy, pathology, physiology, etiology or function" ;
    cmns-av:acronym "HLT" ;
    cmns-av:adaptedFrom "https://www.meddra.org/how-to-use/basics/hierarchy" ;
    cmns-txt:hasTextValue "HLT" ;
.

idmp-meddra:MedDRATermClassifier-LowestLevelTerm
    a
        owl:NamedIndividual ,
        idmp-meddra:MedDRATermClassifier ,
        cmns-cds:CodeElement ;
    rdfs:label "MedDRA term classifier - lowest level term" ;
    skos:definition "classifier for terms that are the most specific level in the MedDRA hierarchy" ;
    cmns-av:acronym "LLT" ;
    cmns-av:adaptedFrom "https://www.meddra.org/how-to-use/basics/hierarchy" ;
    cmns-txt:hasTextValue "LLT" ;
.

idmp-meddra:MedDRATermClassifier-PreferredTerm
    a
        owl:NamedIndividual ,
        idmp-meddra:MedDRATermClassifier ,
        cmns-cds:CodeElement ;
    rdfs:label "MedDRA term classifier - preferred term" ;
    skos:definition "classifier for terms that are a distinct descriptor (single medical concept) for a symptom, sign, disease diagnosis, therapeutic indication, investigation, surgical or medical procedure, and medical social or family history characteristic" ;
    skos:note "Each LLT is linked to only one PT. Each PT has at least one LLT (itself) as well as synonyms and lexical variants (e.g., abbreviations, different word order)." ;
    cmns-av:acronym "PT" ;
    cmns-av:adaptedFrom "https://www.meddra.org/how-to-use/basics/hierarchy" ;
    cmns-txt:hasTextValue "PT" ;
.

idmp-meddra:MedDRATermClassifier-SystemOrganClass
    a
        owl:NamedIndividual ,
        idmp-meddra:MedDRATermClassifier ,
        cmns-cds:CodeElement ;
    rdfs:label "MedDRA term classifier - system organ class" ;
    skos:definition "classifier for groupings of related High Level Group Terms (HLGT) by etiology, manifestation site or purpose. In addition there is a SOC to contain issues pertaining to products and one to contain social circumstances" ;
    cmns-av:acronym "SOC" ;
    cmns-av:adaptedFrom "https://www.meddra.org/how-to-use/basics/hierarchy" ;
    cmns-txt:hasTextValue "SOC" ;
.

idmp-meddra:MedicalDictionaryForRegulatoryActivities
    a
        owl:NamedIndividual ,
        idmp-dtp:ControlledVocabulary ,
        cmns-cds:CodeSet ,
        cmns-ra:Registry ;
    rdfs:label "Medical Dictionary for Regulatory Activities" ;
    skos:definition "rich and highly specific standardised medical terminology developed by ICH to facilitate sharing of regulatory information internationally for medical products used by humans" ;
    cmns-av:abbreviation "MedDRA" ;
    cmns-av:adaptedFrom
        "https://www.ich.org/page/meddra" ,
        "https://www.meddra.org/" ;
    cmns-id:isIdentifiedBy idmp-meddra:OID-2.16.840.1.113883.6.163 ;
    cmns-org:isManagedBy idmp-meddra:MedDRARegistrationAuthority ;
.

idmp-meddra:OID-2.16.840.1.113883.6.163
    a
        owl:NamedIndividual ,
        idmp-dtp:ObjectIdentifier ,
        cmns-ra:RegisteredIdentifier ;
    rdfs:label "object identifier 2.16.840.1.113883.6.163" ;
    skos:definition "object identifier for the Medical Dictionary for Regulatory Activities" ;
    cmns-av:adaptedFrom
        "https://www.ich.org/page/meddra" ,
        "https://www.meddra.org/" ;
    cmns-id:identifies idmp-meddra:MedicalDictionaryForRegulatoryActivities ;
    cmns-txt:hasTextValue "2.16.840.1.113883.6.163" ;
.

idmp-ucum:AmountOfSubstance
    a
        owl:NamedIndividual ,
        cmns-qtu:BaseQuantityKind ;
    rdfs:label "amount of substance" ;
    dcterms:source "https://ucum.org/ucum.html#section-Base-Units" ;
    skos:definition "base quantity kind defined in the Unified Code for Units Of Measure (UCUM) System of Units for the quantity or number of discrete atomic-scale particles in a given sample of matter divided by the Avogadro constant" ;
    cmns-av:explanatoryNote "The particles or entities may be molecules, atoms, ions, electrons, or other, depending on the context, and should be specified." ;
    cmns-av:symbol "n" ;
    cmns-dsg:isDefinedIn idmp-ucum:UnifiedCodeForUnitsOfMeasure ;
.

idmp-ucum:Ampoule
    a
        owl:NamedIndividual ,
        idmp-uom:UnitOfPresentation ;
    rdfs:label "ampoule" ;
    skos:definition "presentation unit that is a sealed vial made of glass or plastic that contains a sterile medicinal solution or a powder that is usually made into a solution for subcutaneous, intramuscular, or intravenous injection" ;
    skos:exactMatch <https://spor.ema.europa.eu/v1/lists/200000000014/terms/200000002164> ;
.

idmp-ucum:Capsule
    a
        owl:NamedIndividual ,
        idmp-uom:UnitOfPresentation ;
    rdfs:label "capsule" ;
    skos:definition "presentation unit that is a solid dosage form in which one or more medicaments, with or without suitable excipients, are enclosed within a soluble shell" ;
    skos:exactMatch <https://spor.ema.europa.eu/v1/lists/200000000014/terms/200000002113> ;
.

idmp-ucum:Dalton
    a
        owl:NamedIndividual ,
        cmns-qtu:ConversionBasedUnit ;
    rdfs:label "dalton" ;
    dcterms:source "https://ucum.org/ucum.html#section-Derived-Unit-Atoms" ;
    skos:definition "conversion-based unit of mass defined in the Unified Code for Units Of Measure (UCUM) System of Units" ;
    idmp-uom:isSIQuantity false ;
    cmns-av:symbol
        "Da" ,
        "da" ;
    cmns-dsg:hasDescription "1/12 of the mass of an unbound neutral atom of carbon-12 in its nuclear and electronic ground state and at rest, approximately 1.66×10^−27 kg" ;
    cmns-dsg:isDefinedIn idmp-ucum:UnifiedCodeForUnitsOfMeasure ;
    cmns-qtu:hasQuantityKind idmp-ucum:Mass ;
    cmns-qtu:isDerivedFrom idmp-ucum:Kilogram ;
.

idmp-ucum:Dimension-L
    a
        owl:NamedIndividual ,
        cmns-qtu:QuantityDimension ;
    rdfs:label "dimension - L" ;
    skos:definition "dimension that is the measurement of how far apart objects or points are" ;
    cmns-av:symbol "L" ;
    cmns-cls:classifies idmp-ucum:Length ;
    cmns-dsg:isDefinedIn cmns-qtu:InternationalSystemOfQuantities ;
.

idmp-ucum:Dimension-M
    a
        owl:NamedIndividual ,
        cmns-qtu:QuantityDimension ;
    rdfs:label "dimension - M" ;
    skos:definition "dimension that is the measurement of a body's inertial property or how much matter it contains" ;
    cmns-av:symbol "M" ;
    cmns-cls:classifies idmp-ucum:Mass ;
    cmns-dsg:isDefinedIn cmns-qtu:InternationalSystemOfQuantities ;
.

idmp-ucum:Gram
    a
        owl:NamedIndividual ,
        cmns-qtu:BaseUnit ;
    rdfs:label "gram" ;
    dcterms:source "https://ucum.org/ucum.html#section-Base-Units" ;
    skos:definition "base unit of mass defined in the Unified Code for Units Of Measure (UCUM) System of Units" ;
    idmp-uom:isSIQuantity true ;
    cmns-av:explanatoryNote "The kilogram, as of 2019, is defined by the International Bureau of Weights and Measures from the fixed numerical value of the Planck constant (h), which is 6.62607015×10^−34 kg⋅m^2⋅s^−1" ;
    cmns-av:symbol "g" ;
    cmns-dsg:isDefinedIn idmp-ucum:UnifiedCodeForUnitsOfMeasure ;
.

idmp-ucum:GramsPerMole
    a
        owl:NamedIndividual ,
        cmns-qtu:ConversionBasedUnit ;
    rdfs:label "grams per mole" ;
    dcterms:source "https://ucum.org/ucum.html#section-Derived-Unit-Atoms" ;
    skos:definition "conversion-based unit of molecular weight defined in the Unified Code for Units Of Measure (UCUM) System of Units" ;
    idmp-uom:isSIQuantity false ;
    cmns-av:symbol "g/mol" ;
    cmns-dsg:hasDescription "1.66054018667494 × 10^-21 kg" ;
    cmns-dsg:isDefinedIn idmp-ucum:UnifiedCodeForUnitsOfMeasure ;
    cmns-qtu:hasQuantityKind idmp-ucum:MolarMass ;
    cmns-qtu:isDerivedFrom
        idmp-ucum:Gram ,
        idmp-ucum:Mole ;
.

idmp-ucum:Kilo
    a
        owl:NamedIndividual ,
        cmns-qtu:Prefix ;
    rdfs:label "kilo" ;
    dcterms:source "https://ucum.org/ucum.html#section-Prefixes" ;
    skos:definition "prefix defined in the Unified Code for Units Of Measure (UCUM) System of Units" ;
    cmns-av:symbol "k" ;
    cmns-dsg:hasDescription "10^3=(10^3)^1" ;
    cmns-dsg:isDefinedIn idmp-ucum:UnifiedCodeForUnitsOfMeasure ;
.

idmp-ucum:Kilogram
    a
        owl:NamedIndividual ,
        cmns-qtu:PrefixedUnit ;
    rdfs:label "kilogram" ;
    dcterms:source "https://ucum.org/ucum.html#section-Base-Units" ;
    rdfs:seeAlso <https://www.nist.gov/si-redefinition/kilogram> ;
    skos:definition "conversion-based unit of mass" ;
    skos:note "Note that in the International System of Units (SI), the kilogram is considered the base unit rather than the gram, which is the base unit in the UCUM." ;
    idmp-uom:isSIQuantity true ;
    cmns-av:symbol "kg" ;
    cmns-dsg:hasDescription "10^3 grams" ;
    cmns-dsg:isDefinedIn
        idmp-ucum:UnifiedCodeForUnitsOfMeasure ,
        cmns-qtu:InternationalSystemOfUnits ;
    cmns-qtu:hasFactor idmp-ucum:Kilo ;
    cmns-qtu:hasQuantityKind idmp-ucum:Mass ;
    cmns-qtu:isDerivedFrom idmp-ucum:Gram ;
.

idmp-ucum:Length
    a
        owl:NamedIndividual ,
        cmns-qtu:BaseQuantityKind ;
    rdfs:label "length" ;
    dcterms:source "https://ucum.org/ucum.html#section-Base-Units" ;
    skos:definition "base quantity kind that is the quantitative measure of distance, i.e., of how far apart objects or points are" ;
    cmns-av:symbol "l" ;
    cmns-dsg:isDefinedIn
        idmp-ucum:UnifiedCodeForUnitsOfMeasure ,
        cmns-qtu:InternationalSystemOfQuantities ;
    cmns-qtu:hasDimension idmp-ucum:Dimension-L ;
.

idmp-ucum:Liter
    a
        owl:NamedIndividual ,
        cmns-qtu:ConversionBasedUnit ;
    rdfs:label "liter" ;
    dcterms:source "https://ucum.org/ucum.html#section-Derived-Unit-Atoms" ;
    skos:definition "derived unit of volume defined in the Unified Code for Units Of Measure (UCUM) System of Units" ;
    idmp-uom:isSIQuantity true ;
    cmns-av:symbol "l" ;
    cmns-dsg:hasDescription "cubic meter: m^3" ;
    cmns-dsg:isDefinedIn idmp-ucum:UnifiedCodeForUnitsOfMeasure ;
    cmns-qtu:hasQuantityKind idmp-ucum:Volume ;
    cmns-qtu:isDerivedFrom idmp-ucum:Meter ;
.

idmp-ucum:Mass
    a
        owl:NamedIndividual ,
        cmns-qtu:BaseQuantityKind ;
    rdfs:label "mass" ;
    skos:definition "base quantity kind for the measure of a measure of a body's inertial property or how much matter it contains" ;
    cmns-av:explanatoryNote "Note that as of 2018, mass has been redefined in the International System of Units in terms of Planck's constant, h. The kilogram is defined by taking the fixed numerical value of the Planck constant, h, to be 6.626 070 15 × 10-34 when expressed in the unit J s, which is equal to kg m^2 s^−1, where the metre and the second are defined in terms of the speed of light, 𝒸, and the hyperfine transition frequency of the caesium-133 atom, ∆ν, respectively." ;
    cmns-av:symbol "m" ;
    cmns-dsg:isDefinedIn idmp-ucum:UnifiedCodeForUnitsOfMeasure ;
    cmns-qtu:hasDimension idmp-ucum:Dimension-M ;
.

idmp-ucum:MassConcentration
    a
        owl:NamedIndividual ,
        cmns-qtu:DerivedQuantityKind ;
    rdfs:label "mass concentration" ;
    dcterms:source
        "ISO 31-0:1992(E) Quantities and Units - Part 0: General principles, clause A.6.6" ,
        "https://ucum.org/ucum.html#section-Base-Units" ;
    skos:definition "derived quantity kind defined in the International System of Quantities for the quantitative measure of the mass of a constituent divided by the total volume of the mixture" ;
    cmns-av:explanatoryNote
        "For a pure chemical the mass concentration equals its density (mass divided by volume); thus the mass concentration of a component in a mixture can be called the density of a component in a mixture." ,
        "Note that the Unified Code for Units Of Measure (UCUM) uses mass concentration primarily with respect to gram percent, which is a dimensionless unit in that system." ;
    cmns-av:symbol
        "ML^3" ,
        "γ" ,
        "ρ" ;
    cmns-dsg:isDefinedIn cmns-qtu:InternationalSystemOfQuantities ;
    cmns-qtu:isDerivedFrom idmp-ucum:Mass ;
.

idmp-ucum:Meter
    a
        owl:NamedIndividual ,
        cmns-qtu:BaseUnit ;
    rdfs:label "meter" ;
    dcterms:source "https://ucum.org/ucum.html#section-Base-Units" ;
    rdfs:seeAlso
        <https://www.nist.gov/pml/owm/si-units-length> ,
        <https://www.nist.gov/system/files/documents/pml/div683/museum-length.pdf> ;
    skos:definition "base unit of length that is the distance traveled by light in vacuum during the time interval of 1/299 792 458 of a second" ;
    idmp-uom:isSIQuantity true ;
    cmns-av:symbol "m" ;
    cmns-dsg:isDefinedIn
        idmp-ucum:UnifiedCodeForUnitsOfMeasure ,
        cmns-qtu:InternationalSystemOfUnits ;
.

idmp-ucum:Micro
    a
        owl:NamedIndividual ,
        cmns-qtu:Prefix ;
    rdfs:label "micro" ;
    dcterms:source "https://ucum.org/ucum.html#section-Prefixes" ;
    skos:definition "prefix defined in the Unified Code for Units Of Measure (UCUM) System of Units" ;
    cmns-av:symbol "μ" ;
    cmns-dsg:hasDescription "10^-6=(10^3)^-2" ;
    cmns-dsg:isDefinedIn idmp-ucum:UnifiedCodeForUnitsOfMeasure ;
.

idmp-ucum:Microgram
    a
        owl:NamedIndividual ,
        cmns-qtu:PrefixedUnit ;
    rdfs:label "microgram" ;
    dcterms:source "https://ucum.org/ucum.html#section-Derived-Unit-Atoms" ;
    skos:definition "conversion-based unit of mass defined in the Unified Code for Units Of Measure (UCUM) System of Units" ;
    idmp-uom:isSIQuantity true ;
    cmns-av:symbol
        "mcg" ,
        "μg" ;
    cmns-dsg:hasDescription "10^-6 grams" ;
    cmns-dsg:isDefinedIn idmp-ucum:UnifiedCodeForUnitsOfMeasure ;
    cmns-qtu:hasFactor idmp-ucum:Micro ;
    cmns-qtu:hasQuantityKind idmp-ucum:Mass ;
    cmns-qtu:isDerivedFrom idmp-ucum:Gram ;
.

idmp-ucum:MicrogramsPerMilliliter
    a
        owl:NamedIndividual ,
        cmns-qtu:PrefixedUnit ;
    rdfs:label "micrograms per milliliter" ;
    dcterms:source "https://ucum.org/ucum.html#section-Derived-Unit-Atoms" ;
    skos:definition "conversion-based unit of mass concentration (density) used to measure volume in milliliters in order to estimate weight or mass in micrograms" ;
    idmp-uom:isSIQuantity true ;
    cmns-av:symbol "μg/ml" ;
    cmns-dsg:hasDescription "10^-6 grams per 10^-3 liters" ;
    cmns-dsg:isDefinedIn idmp-ucum:UnifiedCodeForUnitsOfMeasure ;
    cmns-qtu:hasFactor idmp-ucum:Micro ;
    cmns-qtu:hasQuantityKind idmp-ucum:MassConcentration ;
    cmns-qtu:isDerivedFrom
        idmp-ucum:Gram ,
        idmp-ucum:Liter ;
.

idmp-ucum:Milli
    a
        owl:NamedIndividual ,
        cmns-qtu:Prefix ;
    rdfs:label "milli" ;
    dcterms:source "https://ucum.org/ucum.html#section-Prefixes" ;
    skos:definition "prefix defined in the Unified Code for Units Of Measure (UCUM) System of Units" ;
    cmns-av:symbol "m" ;
    cmns-dsg:hasDescription "10^-3=(10^3)-1" ;
    cmns-dsg:isDefinedIn idmp-ucum:UnifiedCodeForUnitsOfMeasure ;
.

idmp-ucum:Milligram
    a
        owl:NamedIndividual ,
        cmns-qtu:PrefixedUnit ;
    rdfs:label "milligram" ;
    dcterms:source "https://ucum.org/ucum.html#section-Derived-Unit-Atoms" ;
    skos:definition "conversion-based unit of mass defined in the Unified Code for Units Of Measure (UCUM) System of Units" ;
    idmp-uom:isSIQuantity true ;
    cmns-av:symbol "mg" ;
    cmns-dsg:hasDescription "10^-3 grams" ;
    cmns-dsg:isDefinedIn idmp-ucum:UnifiedCodeForUnitsOfMeasure ;
    cmns-qtu:hasFactor idmp-ucum:Milli ;
    cmns-qtu:hasQuantityKind idmp-ucum:Mass ;
    cmns-qtu:isDerivedFrom idmp-ucum:Gram ;
.

idmp-ucum:MilligramsPerMilliliter
    a
        owl:NamedIndividual ,
        cmns-qtu:PrefixedUnit ;
    rdfs:label "milligrams per milliliter" ;
    dcterms:source "https://ucum.org/ucum.html#section-Derived-Unit-Atoms" ;
    skos:definition "conversion-based unit of mass concentration (density) used to measure volume in milliliters in order to estimate weight or mass in milligrams" ;
    idmp-uom:isSIQuantity true ;
    cmns-av:symbol "mg/ml" ;
    cmns-dsg:hasDescription "10^-3 grams per 10^-3 liters" ;
    cmns-dsg:isDefinedIn idmp-ucum:UnifiedCodeForUnitsOfMeasure ;
    cmns-qtu:hasFactor idmp-ucum:Milli ;
    cmns-qtu:hasQuantityKind idmp-ucum:MassConcentration ;
    cmns-qtu:isDerivedFrom
        idmp-ucum:Gram ,
        idmp-ucum:Liter ;
.

idmp-ucum:Milliliter
    a
        owl:NamedIndividual ,
        cmns-qtu:PrefixedUnit ;
    rdfs:label "milliliter" ;
    dcterms:source "https://ucum.org/ucum.html#section-Derived-Unit-Atoms" ;
    skos:definition "conversion-based unit of volume defined in the Unified Code for Units Of Measure (UCUM) System of Units" ;
    idmp-uom:isSIQuantity true ;
    cmns-av:symbol "ml" ;
    cmns-dsg:hasDescription "10^-3 liters" ;
    cmns-dsg:isDefinedIn idmp-ucum:UnifiedCodeForUnitsOfMeasure ;
    cmns-qtu:hasFactor idmp-ucum:Milli ;
    cmns-qtu:hasQuantityKind idmp-ucum:Volume ;
    cmns-qtu:isDerivedFrom idmp-ucum:Liter ;
.

idmp-ucum:MolarMass
    a
        owl:NamedIndividual ,
        cmns-qtu:DerivedQuantityKind ;
    rdfs:label "molar mass" ;
    dcterms:source "https://ucum.org/ucum.html#section-Derived-Unit-Atoms" ;
    skos:definition "derived quantity kind defined in the Unified Code for Units Of Measure (UCUM) System of Units for the mass of a substance divided by its amount of substance in moles" ;
    skos:example "For example, the molar mass of water (H2O) is approximately 1 × 2 + 16 = 18 g/mol." ;
    skos:note "The molar mass of elements in grams per mole is numerically equal to their atomic mass in unified atomic mass units (u) or daltons (Da). The molar mass of compounds is equal to the sum of molar masses of the atoms which form the compound." ;
    cmns-dsg:isDefinedIn idmp-ucum:UnifiedCodeForUnitsOfMeasure ;
    cmns-qtu:isDerivedFrom idmp-ucum:Mass ;
.

idmp-ucum:Mole
    a
        owl:NamedIndividual ,
        cmns-qtu:BaseUnit ;
    rdfs:label "mole" ;
    dcterms:source "https://ucum.org/ucum.html#section-Base-Units" ;
    rdfs:seeAlso <https://www.nist.gov/system/files/documents/pml/div683/museum-length.pdf> ;
    skos:definition "base unit of amount of substance defined in the Unified Code for Units Of Measure (UCUM) System of Units that is the measure of how many elementary entities of a given substance are in an object or sample" ;
    idmp-uom:isSIQuantity true ;
    cmns-av:symbol "mol" ;
    cmns-dsg:hasDescription "6.02214076×10^23 elementary entities" ;
    cmns-dsg:isDefinedIn idmp-ucum:UnifiedCodeForUnitsOfMeasure ;
.

idmp-ucum:OID-2.16.840.1.113883.6.8
    a
        owl:NamedIndividual ,
        idmp-uom:CodeSystemIdentifier ;
    rdfs:label "Unified Code for Units of Measure identifier" ;
    dcterms:source "ISO 11240:2021, clause 4.6.2.2 and clause 4.6.2.3 Code System, Table 3" ;
    skos:definition "ISO Object Identifier (OID) for the Unified Code for Units of Measure (UCUM) code set" ;
    idmp-dtp:isEncodedAs idmp-dtp:DatatypeCode-ST ;
    cmns-id:identifies idmp-ucum:UnifiedCodeForUnitsOfMeasure ;
    cmns-txt:hasTextValue "2.16.840.1.113883.6.8" ;
.

idmp-ucum:Syringe
    a
        owl:NamedIndividual ,
        idmp-uom:UnitOfPresentation ;
    rdfs:label "syringe" ;
    skos:definition "presentation unit that is a device for injecting or withdrawing a liquid medicinal product, counted as a discrete countable item such as a pre-filled syringe" ;
    skos:exactMatch <https://spor.ema.europa.eu/v1/lists/200000000014/terms/200000002150> ;
.

idmp-ucum:Tablet
    a
        owl:NamedIndividual ,
        idmp-uom:UnitOfPresentation ;
    rdfs:label "tablet" ;
    skos:definition "presentation unit that is a solid unit dosage form of one or more medicaments with or without suitable excipients and prepared either by molding or by compression" ;
    skos:exactMatch <https://spor.ema.europa.eu/v1/lists/200000000014/terms/200000002152> ;
.

idmp-ucum:UnifiedAtomicMassUnit
    a
        owl:NamedIndividual ,
        cmns-qtu:ConversionBasedUnit ;
    rdfs:label "unified atomic mass unit" ;
    dcterms:source "https://ucum.org/ucum.html#section-Derived-Unit-Atoms" ;
    skos:definition "conversion-based unit of mass defined in the Unified Code for Units Of Measure (UCUM) System of Units" ;
    idmp-uom:isSIQuantity true ;
    cmns-av:symbol
        "AMU" ,
        "u" ;
    cmns-dsg:hasDescription "1.6605402 × 10^-24 kg" ;
    cmns-dsg:isDefinedIn idmp-ucum:UnifiedCodeForUnitsOfMeasure ;
    cmns-qtu:hasQuantityKind idmp-ucum:Mass ;
    cmns-qtu:isDerivedFrom idmp-ucum:Kilogram ;
.

idmp-ucum:UnifiedCodeForUnitsOfMeasure
    a
        owl:NamedIndividual ,
        idmp-uom:UnitOfMeasureIdentificationScheme ;
    rdfs:label "Unified Code for Units of Measure" ;
    rdfs:seeAlso
        <https://ucum.nlm.nih.gov/> ,
        <https://ucum.org/trac> ;
    owl:versionInfo "Version: 2.1, Revision: 442" ;
    skos:definition "code system intended to include all units of measures being contemporarily used in international science, engineering, and business" ;
    skos:note "UCUM has been adopted internationally by many organizations such as IEEE, DICOM, LOINC, and HL7, and is also in the ISO 11240:2012 standard" ;
    cmns-av:abbreviation "UCUM" ;
    cmns-av:copyright "Copyright 1999-2021 Regenstrief Institute, Inc. All rights reserved." ;
    cmns-dsg:hasDescription "The Unified Code for Units of Measure (UCUM) was developed by Regenstrief Institute and the UCUM Organization as a unambiguous system of units and their combinations. The purpose is to facilitate unambiguous electronic communication of quantities together with their units. The focus is on electronic communication, as opposed to communication between humans. A typical application of The Unified Code for Units of Measure are electronic data interchange (EDI) protocols, but there is nothing that prevents it from being used in other types of machine communication." ;
    cmns-dsg:hasName
        idmp-ucum:UnifiedCodeForUnitsOfMeasureCodeSystemFullName ,
        idmp-ucum:UnifiedCodeForUnitsOfMeasureCodeSystemName ;
    cmns-id:isIdentifiedBy idmp-ucum:OID-2.16.840.1.113883.6.8 ;
.

idmp-ucum:UnifiedCodeForUnitsOfMeasureCodeSystemFullName
    a
        owl:NamedIndividual ,
        idmp-uom:CodeSystemFullName ;
    rdfs:label "Unified Code for Units of Measure code system full name" ;
    dcterms:source "ISO 11240:2021, clause 4.6.2.3 Code System, Table 3" ;
    skos:definition "official name for the Unified Code for Units of Measure code system" ;
    idmp-dtp:isEncodedAs idmp-dtp:DatatypeCode-ST ;
    cmns-dsg:isNameOf idmp-ucum:UnifiedCodeForUnitsOfMeasure ;
    cmns-txt:hasTextValue "Unified Code for Units of Measure" ;
.

idmp-ucum:UnifiedCodeForUnitsOfMeasureCodeSystemName
    a
        owl:NamedIndividual ,
        idmp-dtp:CodeSystemName ;
    rdfs:label "Unified Code for Units of Measure code system name" ;
    dcterms:source "ISO 11240:2021, clause 4.6.2.3 Code System, Table 3" ;
    skos:definition "short name that uniquely identifies the Unified Code for Units of Measure code system for communications between people" ;
    idmp-dtp:isEncodedAs idmp-dtp:DatatypeCode-ST ;
    cmns-dsg:isNameOf idmp-ucum:UnifiedCodeForUnitsOfMeasure ;
    cmns-txt:hasTextValue "UCUM" ;
.

idmp-ucum:Vial
    a
        owl:NamedIndividual ,
        idmp-uom:UnitOfPresentation ;
    rdfs:label "vial" ;
    skos:definition "presentation unit that is a small glass or plastic container sealed with a stopper, used to hold a liquid or powder medicinal product" ;
    skos:exactMatch <https://spor.ema.europa.eu/v1/lists/200000000014/terms/200000002158> ;
.

idmp-ucum:Volume
    a
        owl:NamedIndividual ,
        cmns-qtu:DerivedQuantityKind ;
    rdfs:label "volume" ;
    dcterms:source "https://ucum.org/ucum.html#section-Derived-Unit-Atoms" ;
    skos:definition "derived quantity kind defined in the Unified Code for Units Of Measure (UCUM) System of Units for the quantitative measure expressing the amount of three-dimensional space enclosed by a closed surface" ;
    cmns-av:symbol "L^3" ;
    cmns-dsg:isDefinedIn idmp-ucum:UnifiedCodeForUnitsOfMeasure ;
    cmns-qtu:isDerivedFrom idmp-ucum:Length ;
.

cmns-av:abbreviation
    a owl:AnnotationProperty ;
    rdfs:label "abbreviation" ;
    rdfs:isDefinedBy cmns-av: ;
    rdfs:subPropertyOf cmns-av:synonym ;
    skos:definition "designation formed by omitting parts from the full form of a term that denotes the same concept" ;
.

cmns-av:acronym
    a owl:AnnotationProperty ;
    rdfs:label "acronym" ;
    rdfs:isDefinedBy cmns-av: ;
    rdfs:subPropertyOf cmns-av:abbreviation ;
    skos:definition "abbreviation that is made up of the initial letters of the components of the full form of a term or proper name or from syllables of the full form" ;
.

cmns-av:adaptedFrom
    a owl:AnnotationProperty ;
    rdfs:label "adapted from" ;
    rdfs:isDefinedBy cmns-av: ;
    rdfs:subPropertyOf dcterms:source ;
    skos:definition "document or other source from which a given term (or its definition) was adapted (i.e., is compatible with but not quoted); the range for this annotation can be a string, URI, or citation" ;
.

cmns-av:copyright
    a owl:AnnotationProperty ;
    rdfs:label "copyright" ;
    rdfs:isDefinedBy cmns-av: ;
    rdfs:subPropertyOf dcterms:rights ;
    skos:definition "exclusive legal right, given to an originator or an assignee to print, publish, perform, film, or record literary, artistic, or musical material, and to authorize others to do the same" ;
.

cmns-av:directSource
    a owl:AnnotationProperty ;
    rdfs:label "direct source" ;
    rdfs:isDefinedBy cmns-av: ;
    rdfs:subPropertyOf dcterms:source ;
    skos:definition "quoted reference for the subject resource; the range for this annotation can be a string, URI, or bibliographic citation" ;
.

cmns-av:explanatoryNote
    a owl:AnnotationProperty ;
    rdfs:label "explanatory note" ;
    rdfs:isDefinedBy cmns-av: ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "note that provides additional explanatory material for a resource" ;
.

cmns-av:symbol
    a owl:AnnotationProperty ;
    rdfs:label "symbol" ;
    rdfs:isDefinedBy cmns-av: ;
    rdfs:subPropertyOf cmns-av:synonym ;
    skos:definition "abbreviation that is a design or mark, or other non-alpha-numeric character(s) conventionally used to represent something, such as a currency or mathematical sign or operator" ;
.

cmns-av:synonym
    a owl:AnnotationProperty ;
    rdfs:label "synonym" ;
    rdfs:isDefinedBy cmns-av: ;
    rdfs:subPropertyOf skos:altLabel ;
    skos:definition "designation that can be substituted for the primary representation of something" ;
.

cmns-av:usageNote
    a owl:AnnotationProperty ;
    rdfs:label "usage note" ;
    rdfs:isDefinedBy cmns-av: ;
    rdfs:subPropertyOf skos:note ;
    skos:definition "note that provides information about how a given resource is used or may be extended" ;
.

cmns-bauth:Authorization
    a owl:Class ;
    rdfs:label
        "authorisation"@en-GB ,
        "authorization"@en-US ;
    rdfs:isDefinedBy cmns-bauth: ;
    rdfs:subClassOf cmns-pts:Situation ;
    skos:definition "situation in which a party authorizes someone to act on their behalf or to have specific capabilities under certain conditions for some period of time" ;
    skos:prefLabel "authorization" ;
.

cmns-bauth:AuthorizedParty
    a owl:Class ;
    rdfs:label
        "authorised party"@en-GB ,
        "authorized party"@en-US ;
    rdfs:isDefinedBy cmns-bauth: ;
    rdfs:subClassOf cmns-rlcmp:FunctionalRole ;
    skos:definition "party that has been given the ability to act on behalf of another party or to have specified capabilities under some set of guidelines for some period of time" ;
    skos:prefLabel "authorized party" ;
.

cmns-bauth:AuthorizingParty
    a owl:Class ;
    rdfs:label
        "authorising party"@en-GB ,
        "authorizing party"@en-US ;
    rdfs:isDefinedBy cmns-bauth: ;
    rdfs:subClassOf cmns-pts:Actor ;
    skos:definition "party that delegates some role, authority, or control to another party" ;
.

cmns-bauth:authorizes
    a owl:ObjectProperty ;
    rdfs:label "authorizes" ;
    rdfs:domain cmns-bauth:AuthorizingParty ;
    rdfs:isDefinedBy cmns-bauth: ;
    rdfs:range cmns-bauth:AuthorizedParty ;
    rdfs:subPropertyOf cmns-pts:actsOn ;
    owl:inverseOf cmns-bauth:isAuthorizedBy ;
    skos:definition "endorses, enables, empowers, or gives permission to" ;
.

cmns-bauth:authorizesThrough
    a owl:ObjectProperty ;
    rdfs:label "authorizes through" ;
    rdfs:domain cmns-bauth:AuthorizingParty ;
    rdfs:isDefinedBy cmns-bauth: ;
    rdfs:range cmns-bauth:Authorization ;
    rdfs:subPropertyOf cmns-pts:actsIn ;
    owl:inverseOf cmns-bauth:hasAuthorizingParty ;
    skos:definition "indicates the situation that facilitates designation of an authorized party by the authorizing party for some purpose" ;
.

cmns-bauth:hasAuthorization
    a owl:ObjectProperty ;
    rdfs:label "has authorization" ;
    rdfs:isDefinedBy cmns-bauth: ;
    rdfs:range cmns-bauth:Authorization ;
    rdfs:subPropertyOf cmns-cxtdsg:isApplicableIn ;
    skos:definition "relates something to a specific authorization that is applicable to it in some context" ;
.

cmns-bauth:hasAuthorizedParty
    a owl:ObjectProperty ;
    rdfs:label "has authorized party" ;
    rdfs:domain cmns-bauth:Authorization ;
    rdfs:isDefinedBy cmns-bauth: ;
    rdfs:range cmns-bauth:AuthorizedParty ;
    rdfs:subPropertyOf cmns-pts:hasUndergoer ;
    skos:definition "indicates the party (role) that is endorsed, enabled, empowered, or otherwise permitted to do something in the situation" ;
.

cmns-bauth:hasAuthorizingParty
    a owl:ObjectProperty ;
    rdfs:label "has authorizing party" ;
    rdfs:domain cmns-bauth:Authorization ;
    rdfs:isDefinedBy cmns-bauth: ;
    rdfs:range cmns-bauth:AuthorizingParty ;
    rdfs:subPropertyOf cmns-pts:hasActor ;
    skos:definition "indicates the party (role) that endorses, enables, empowers, or gives permission in the situation" ;
.

cmns-bauth:isAuthorizedBy
    a owl:ObjectProperty ;
    rdfs:label "is authorized by" ;
    rdfs:domain cmns-bauth:AuthorizedParty ;
    rdfs:isDefinedBy cmns-bauth: ;
    rdfs:range cmns-bauth:AuthorizingParty ;
    rdfs:subPropertyOf cmns-pts:isAffectedBy ;
    skos:definition "is endorsed, enabled, empowered, or otherwise permitted by" ;
.

cmns-bauth:isAuthorizedThrough
    a owl:ObjectProperty ;
    rdfs:label "is authorized through" ;
    rdfs:domain cmns-bauth:AuthorizedParty ;
    rdfs:isDefinedBy cmns-bauth: ;
    rdfs:range cmns-bauth:Authorization ;
    rdfs:subPropertyOf cmns-pts:undergoes ;
    owl:inverseOf cmns-bauth:hasAuthorizedParty ;
    skos:definition "indicates the situation that facilitates endorsement of the authorized party for some purpose" ;
.

cmns-cls:Aspect
    a owl:Class ;
    rdfs:label "aspect" ;
    rdfs:isDefinedBy cmns-cls: ;
    skos:definition "characteristic or feature that can be used to dimensionalize, filter, or subset a class, collection, or set of things" ;
.

cmns-cls:ClassificationScheme
    a owl:Class ;
    rdfs:label "classification scheme" ;
    rdfs:isDefinedBy cmns-cls: ;
    rdfs:subClassOf cmns-col:Arrangement ;
    skos:definition "system for allocating classifiers to things" ;
.

cmns-cls:Classifier
    a owl:Class ;
    rdfs:label "classifier" ;
    rdfs:isDefinedBy cmns-cls: ;
    rdfs:subClassOf cmns-cls:Aspect ;
    skos:definition "standardized classification or delineation for something, per some scheme for such delineation, within a specified context" ;
.

cmns-cls:characterizes
    a owl:ObjectProperty ;
    rdfs:label "characterizes" ;
    rdfs:isDefinedBy cmns-cls: ;
    rdfs:subPropertyOf cmns-dsg:describes ;
    skos:definition "provides a discriminating feature or quality of" ;
.

cmns-cls:classifies
    a owl:ObjectProperty ;
    rdfs:label "classifies" ;
    rdfs:isDefinedBy cmns-cls: ;
    rdfs:subPropertyOf cmns-cls:characterizes ;
    skos:definition "arranges in categories according to one or more shared characteristics" ;
.

cmns-cls:isCharacterizedBy
    a owl:ObjectProperty ;
    rdfs:label "is characterized by" ;
    rdfs:isDefinedBy cmns-cls: ;
    rdfs:subPropertyOf cmns-dsg:isDescribedBy ;
    owl:inverseOf cmns-cls:characterizes ;
    skos:definition "indicates a quality or feature of something, distinguishing it from something else" ;
.

cmns-cls:isClassifiedBy
    a owl:ObjectProperty ;
    rdfs:label "is classified by" ;
    rdfs:isDefinedBy cmns-cls: ;
    rdfs:subPropertyOf cmns-cls:isCharacterizedBy ;
    owl:inverseOf cmns-cls:classifies ;
    skos:definition "is systematically grouped based on characteristics by" ;
.

cmns-cds:CodeElement
    a owl:Class ;
    rdfs:label "code element" ;
    dcterms:source "ISO 21090:2011 Health informatics - Harmonized data types for information interchange, clause 3.3" ;
    rdfs:isDefinedBy cmns-cds: ;
    rdfs:subClassOf cmns-dsg:Designation ;
    skos:definition "sequence of characters denoting something for some purpose, within a specified context, according to some rule set" ;
    cmns-av:explanatoryNote "A code element is a concept representation published by the author of a code system as part of the code system, being an entity of that code system." ;
    cmns-av:synonym "code" ;
.

cmns-cds:CodeSet
    a owl:Class ;
    rdfs:label "code set" ;
    dcterms:source "ISO 21090:2011 Health informatics - Harmonized data types for information interchange, clause 3.4" ;
    rdfs:isDefinedBy cmns-cds: ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:string ;
            owl:onProperty idmp-dtp:hasVersion ;
        ] ,
        [
            a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass idmp-dtp:CodeSystemName ;
            owl:onProperty cmns-dsg:hasName ;
        ] ,
        cmns-col:Arrangement ,
        cmns-col:Collection ;
    skos:definition "system of alpha-numeric symbols, or combinations of symbols, that stand for specified values in some context" ;
    skos:example "ICD-9, LOINC and SNOMED" ;
    skos:note "They are often described as collections of uniquely identifiable concepts with associated representations, designations, associations and meanings." ;
    cmns-av:explanatoryNote "A code system is a managed collection of concept identifiers, usually codes, but sometimes more complex sets of rules and references." ;
    cmns-av:synonym "code system" ;
.

cmns-col:Arrangement
    a owl:Class ;
    rdfs:label "arrangement" ;
    rdfs:isDefinedBy cmns-col: ;
    skos:definition "systematic plan, manner, or method for making, doing, achieving, or organizing something" ;
.

cmns-col:Collection
    a owl:Class ;
    rdfs:label "collection" ;
    rdfs:isDefinedBy cmns-col: ;
    skos:definition "grouping of things (may be zero) that have some shared significance" ;
.

cmns-col:Constituent
    a owl:Class ;
    rdfs:label "constituent" ;
    rdfs:isDefinedBy cmns-col: ;
    skos:definition "component of a collection or combination of things" ;
.

cmns-col:StructuredCollection
    a owl:Class ;
    rdfs:label "structured collection" ;
    rdfs:isDefinedBy cmns-col: ;
    rdfs:subClassOf cmns-col:Collection ;
    skos:definition "collection that has a clearly defined structure or organization" ;
.

cmns-col:compliesWith
    a owl:ObjectProperty ;
    rdfs:label "complies with" ;
    rdfs:isDefinedBy cmns-col: ;
    rdfs:range cmns-col:Arrangement ;
    rdfs:subPropertyOf cmns-col:hasArrangement ;
    skos:definition "adheres to policies or rules specified in" ;
.

cmns-col:comprises
    a owl:ObjectProperty ;
    rdfs:label "comprises" ;
    rdfs:isDefinedBy cmns-col: ;
    skos:definition "includes, consists of, or contains, especially within a particular scope" ;
.

cmns-col:hasArrangement
    a owl:ObjectProperty ;
    rdfs:label "has arrangement" ;
    rdfs:isDefinedBy cmns-col: ;
    rdfs:range cmns-col:Arrangement ;
    skos:definition "is structured or organized according to" ;
.

cmns-col:hasConstituent
    a owl:ObjectProperty ;
    rdfs:label "has constituent" ;
    rdfs:isDefinedBy cmns-col: ;
    rdfs:subPropertyOf cmns-col:comprises ;
    skos:definition "consists of or contains" ;
.

cmns-col:hasDirectPart
    a owl:ObjectProperty ;
    rdfs:label "has direct part" ;
    rdfs:isDefinedBy cmns-col: ;
    rdfs:subPropertyOf cmns-col:hasPart ;
    skos:definition "indicates an immediate 'child' part of something" ;
.

cmns-col:hasMember
    a owl:ObjectProperty ;
    rdfs:label "has member" ;
    rdfs:isDefinedBy cmns-col: ;
    rdfs:subPropertyOf cmns-col:comprises ;
    skos:definition "includes, as a discrete element" ;
.

cmns-col:hasMethod
    a owl:DatatypeProperty ;
    rdfs:label "has method" ;
    rdfs:isDefinedBy cmns-col: ;
    rdfs:subPropertyOf cmns-txt:hasTextValue ;
    skos:definition "provides a text description of an approach or method used to accomplish something" ;
.

cmns-col:hasPart
    a owl:ObjectProperty ;
    rdfs:label "has part" ;
    rdfs:isDefinedBy cmns-col: ;
    skos:definition "indicates any portion of something, regardless of whether the portion itself is attached to the remainder or detached; cognitively salient or arbitrarily demarcated; self-connected or disconnected; homogeneous or gerrymandered; material or immaterial; extended or unextended; spatial or temporal" ;
.

cmns-col:isConstituentOf
    a owl:ObjectProperty ;
    rdfs:label "is constituent of" ;
    rdfs:isDefinedBy cmns-col: ;
    rdfs:subPropertyOf cmns-col:isIncludedIn ;
    owl:inverseOf cmns-col:hasConstituent ;
    skos:definition "is a component of something else" ;
.

cmns-col:isDirectPartOf
    a owl:ObjectProperty ;
    rdfs:label "is direct part of" ;
    rdfs:isDefinedBy cmns-col: ;
    rdfs:subPropertyOf cmns-col:isPartOf ;
    owl:inverseOf cmns-col:hasDirectPart ;
    skos:definition "indicates an immediate 'parent' of this part" ;
.

cmns-col:isIncludedIn
    a owl:ObjectProperty ;
    rdfs:label "is included in" ;
    rdfs:isDefinedBy cmns-col: ;
    owl:inverseOf cmns-col:comprises ;
    skos:definition "is contained in or an element of" ;
.

cmns-col:isMemberOf
    a owl:ObjectProperty ;
    rdfs:label "is member of" ;
    rdfs:isDefinedBy cmns-col: ;
    rdfs:subPropertyOf cmns-col:isIncludedIn ;
    owl:inverseOf cmns-col:hasMember ;
    skos:definition "is a discrete element of" ;
.

cmns-col:isPartOf
    a owl:ObjectProperty ;
    rdfs:label "is part of" ;
    rdfs:isDefinedBy cmns-col: ;
    owl:inverseOf cmns-col:hasPart ;
    skos:definition "relates something to another thing that it is some component or portion of, regardless of how that whole-part relationship is manifested" ;
.

cmns-cxtdsg:Context
    a owl:Class ;
    rdfs:label "context" ;
    rdfs:isDefinedBy cmns-cxtdsg: ;
    skos:definition "situation or frame of reference in which something applies, exists, happens, or is used and that helps to illustrate or explain it" ;
.

cmns-cxtdsg:ContextualDesignation
    a owl:Class ;
    rdfs:label "contextual designation" ;
    rdfs:isDefinedBy cmns-cxtdsg: ;
    rdfs:subClassOf cmns-dsg:Designation ;
    skos:definition "designation that applies to something in some context" ;
.

cmns-cxtdsg:ContextualName
    a owl:Class ;
    rdfs:label "contextual name" ;
    rdfs:isDefinedBy cmns-cxtdsg: ;
    rdfs:subClassOf
        cmns-cxtdsg:ContextualDesignation ,
        cmns-dsg:Name ;
    skos:definition "designation by which someone, some place, or something is known in some context" ;
.

cmns-cxtdsg:appliesTo
    a owl:ObjectProperty ;
    rdfs:label "applies to" ;
    rdfs:isDefinedBy cmns-cxtdsg: ;
    skos:definition "indicates something for which a context is material, germane, or relevant in some way" ;
.

cmns-cxtdsg:hasApplicablePeriod
    a owl:ObjectProperty ;
    rdfs:label "has applicable period" ;
    rdfs:isDefinedBy cmns-cxtdsg: ;
    rdfs:range cmns-dt:DatePeriod ;
    rdfs:subPropertyOf
        cmns-cxtdsg:isApplicableIn ,
        cmns-dt:hasDatePeriod ;
    skos:definition "indicates a date period during which something may be used, applies, is valid or is accurate or relevant" ;
.

cmns-cxtdsg:isApplicableIn
    a owl:ObjectProperty ;
    rdfs:label "is applicable in" ;
    rdfs:isDefinedBy cmns-cxtdsg: ;
    owl:inverseOf cmns-cxtdsg:appliesTo ;
    skos:definition "indicates a context in which something is relevant" ;
.

cmns-cxtdsg:isUsedBy
    a owl:ObjectProperty ;
    rdfs:label "is used by" ;
    rdfs:isDefinedBy cmns-cxtdsg: ;
    owl:inverseOf cmns-cxtdsg:uses ;
    skos:definition "serves a function or purpose for" ;
.

cmns-cxtdsg:uses
    a owl:ObjectProperty ;
    rdfs:label "uses" ;
    rdfs:isDefinedBy cmns-cxtdsg: ;
    skos:definition "employs to accomplish some task or achieve some result" ;
.

cmns-cxtid:ContextualIdentifier
    a owl:Class ;
    rdfs:label "contextual identifier" ;
    rdfs:isDefinedBy cmns-cxtid: ;
    rdfs:subClassOf
        cmns-cxtdsg:ContextualDesignation ,
        cmns-id:Identifier ;
    skos:definition "sequence of characters uniquely identifying that with which it is associated, within a specified context" ;
.

cmns-cxtid:StructuredIdentifier
    a owl:Class ;
    rdfs:label "structured identifier" ;
    rdfs:isDefinedBy cmns-cxtid: ;
    rdfs:subClassOf cmns-id:Identifier ;
    skos:definition "sequence of characters uniquely identifying that with which it is associated, that includes other codes or identifiers, or that is constructed from other notions" ;
.

cmns-dt:CombinedDateTime
    a rdfs:Datatype ;
    rdfs:label "combined date time" ;
    rdfs:isDefinedBy cmns-dt: ;
    owl:equivalentClass
        [
            a rdfs:Datatype ;
            owl:unionOf (
                xsd:string
                xsd:dateTime
                xsd:dateTimeStamp
            ) ;
        ] ;
    skos:definition "datatype that maps to several base types for dates and times" ;
    skos:note "Valid values must use the ISO 8601 representation for a date, or the corresponding XML Schema Datatypes representation for a date and time, or date and time including the time zone." ;
    skos:scopeNote "There are many cases where the representation of a date may or may not include a time, and where the underlying data representation varies. This composite datatype should only be used in cases where a standard representation using one of the options in the union for date or date and time value specification does not work." ;
.

cmns-dt:Date
    a owl:Class ;
    rdfs:label "date" ;
    rdfs:isDefinedBy cmns-dt: ;
    rdfs:subClassOf cmns-dt:TimeInstant ;
    skos:definition "calendar day on some calendar" ;
.

cmns-dt:DatePeriod
    a owl:Class ;
    rdfs:label "date period" ;
    rdfs:isDefinedBy cmns-dt: ;
    rdfs:subClassOf cmns-dt:TimeInterval ;
    skos:definition "time span over one or more calendar days" ;
.

cmns-dt:Duration
    a owl:Class ;
    rdfs:label "duration" ;
    rdfs:isDefinedBy cmns-dt: ;
    rdfs:subClassOf cmns-dt:TimeInterval ;
    skos:definition "interval of time of some specific length" ;
.

cmns-dt:ExplicitDate
    a owl:Class ;
    rdfs:label "explicit date" ;
    rdfs:isDefinedBy cmns-dt: ;
    rdfs:subClassOf cmns-dt:Date ;
    skos:definition "date in which the 'has date value' property is required" ;
.

cmns-dt:ExplicitDatePeriod
    a owl:Class ;
    rdfs:label "explicit date period" ;
    rdfs:isDefinedBy cmns-dt: ;
    rdfs:subClassOf
        cmns-dt:DatePeriod ,
        cmns-dt:ProperInterval ;
    skos:definition "date period for which the start date, end date, and/or duration are required" ;
.

cmns-dt:ProperInterval
    a owl:Class ;
    rdfs:label "proper interval" ;
    rdfs:isDefinedBy cmns-dt: ;
    rdfs:subClassOf cmns-dt:TimeInterval ;
    skos:definition "time interval with a non-zero extent or duration" ;
.

cmns-dt:TemporalEntity
    a owl:Class ;
    rdfs:label "temporal entity" ;
    rdfs:isDefinedBy cmns-dt: ;
    skos:definition "time interval or instant" ;
.

cmns-dt:TimeInstant
    a owl:Class ;
    rdfs:label "time instant" ;
    rdfs:isDefinedBy cmns-dt: ;
    rdfs:subClassOf cmns-dt:TemporalEntity ;
    skos:definition "temporal entity that is a member of a time scale, with no extent or duration" ;
.

cmns-dt:TimeInterval
    a owl:Class ;
    rdfs:label "time interval" ;
    rdfs:isDefinedBy cmns-dt: ;
    rdfs:subClassOf cmns-dt:TemporalEntity ;
    skos:definition "segment of the time axis, a location in time, with an extent or duration" ;
.

cmns-dt:hasDate
    a owl:ObjectProperty ;
    rdfs:label "has date" ;
    rdfs:isDefinedBy cmns-dt: ;
    rdfs:range cmns-dt:Date ;
    rdfs:subPropertyOf cmns-dt:hasTime ;
    skos:definition "identifies a calendar day, month and year" ;
.

cmns-dt:hasDatePeriod
    a owl:ObjectProperty ;
    rdfs:label "has date period" ;
    rdfs:isDefinedBy cmns-dt: ;
    rdfs:range cmns-dt:DatePeriod ;
    rdfs:subPropertyOf cmns-dt:hasTime ;
    skos:definition "identifies a specific window of time, including a start date, end date and/or duration" ;
.

cmns-dt:hasDateValue
    a owl:DatatypeProperty ;
    rdfs:label "has date value" ;
    rdfs:isDefinedBy cmns-dt: ;
    rdfs:range xsd:string ;
    skos:definition "specifies an actual literal (explicit) date captured in the format specified for xsd:date (i.e., ISO 8601 format), WITHOUT the time or timezone information; the semantics are identical to those of xsd:date" ;
.

cmns-dt:hasDuration
    a owl:ObjectProperty ;
    rdfs:label "has duration" ;
    rdfs:isDefinedBy cmns-dt: ;
    rdfs:range cmns-dt:Duration ;
    rdfs:subPropertyOf cmns-dt:hasTime ;
    skos:definition "specifies the time during which something continues" ;
.

cmns-dt:hasEnd
    a owl:ObjectProperty ;
    rdfs:label "has end" ;
    rdfs:isDefinedBy cmns-dt: ;
    rdfs:range cmns-dt:TimeInstant ;
    rdfs:subPropertyOf cmns-dt:hasTime ;
    skos:definition "indicates the final or ending time point associated with something" ;
.

cmns-dt:hasEndDate
    a owl:ObjectProperty ;
    rdfs:label "has end date" ;
    rdfs:isDefinedBy cmns-dt: ;
    rdfs:range cmns-dt:Date ;
    rdfs:subPropertyOf
        cmns-dt:hasDate ,
        cmns-dt:hasEnd ;
    skos:definition "indicates the final or ending date associated with something" ;
.

cmns-dt:hasExplicitDate
    a owl:ObjectProperty ;
    rdfs:label "has explicit date" ;
    rdfs:isDefinedBy cmns-dt: ;
    rdfs:range cmns-dt:ExplicitDate ;
    rdfs:subPropertyOf cmns-dt:hasDate ;
    skos:definition "indicates a stated date, as opposed to a calculated or unknown date, associated with something" ;
.

cmns-dt:hasObservedDateTime
    a owl:DatatypeProperty ;
    rdfs:label "has observed date and time" ;
    rdfs:isDefinedBy cmns-dt: ;
    rdfs:range cmns-dt:CombinedDateTime ;
    skos:definition "indicates a date and time associated with an event, measurement, record, or observation" ;
.

cmns-dt:hasStart
    a owl:ObjectProperty ;
    rdfs:label "has start" ;
    rdfs:isDefinedBy cmns-dt: ;
    rdfs:range cmns-dt:TimeInstant ;
    rdfs:subPropertyOf cmns-dt:hasTime ;
    skos:definition "indicates the initial time point associated with something" ;
.

cmns-dt:hasStartDate
    a owl:ObjectProperty ;
    rdfs:label "has start date" ;
    rdfs:isDefinedBy cmns-dt: ;
    rdfs:range cmns-dt:Date ;
    rdfs:subPropertyOf
        cmns-dt:hasDate ,
        cmns-dt:hasStart ;
    skos:definition "indicates the initial date associated with something" ;
.

cmns-dt:hasTime
    a owl:ObjectProperty ;
    rdfs:label "has time" ;
    rdfs:isDefinedBy cmns-dt: ;
    rdfs:range cmns-dt:TemporalEntity ;
    skos:definition "specifies a general time that can be associated with any element" ;
.

cmns-dsg:Designation
    a owl:Class ;
    rdfs:label "designation" ;
    rdfs:isDefinedBy cmns-dsg: ;
    skos:definition "representation for something, or for a conceptualization thereof, that denotes it in a domain or subject" ;
.

cmns-dsg:Name
    a owl:Class ;
    rdfs:label "name" ;
    rdfs:isDefinedBy cmns-dsg: ;
    rdfs:subClassOf cmns-dsg:Designation ;
    skos:definition "designation for something by a linguistic expression" ;
.

cmns-dsg:defines
    a owl:ObjectProperty ;
    rdfs:label "defines" ;
    rdfs:isDefinedBy cmns-dsg: ;
    owl:inverseOf cmns-dsg:isDefinedIn ;
    skos:definition "specifies the meaning of something in terms of one or more of its essential qualities" ;
.

cmns-dsg:denotes
    a owl:ObjectProperty ;
    rdfs:label "denotes" ;
    rdfs:domain cmns-dsg:Designation ;
    rdfs:isDefinedBy cmns-dsg: ;
    skos:definition "serves as a sign for something, or for a conceptualization thereof" ;
.

cmns-dsg:describes
    a owl:ObjectProperty ;
    rdfs:label "describes" ;
    rdfs:isDefinedBy cmns-dsg: ;
    owl:inverseOf cmns-dsg:isDescribedBy ;
    skos:definition "conveys the nature of" ;
.

cmns-dsg:hasDescription
    a owl:DatatypeProperty ;
    rdfs:label "has description" ;
    rdfs:isDefinedBy cmns-dsg: ;
    rdfs:subPropertyOf cmns-txt:hasTextValue ;
    skos:definition "provides a textual statement, picture in words, or account that describes something" ;
    idmp-dtp:isEncodedAs idmp-dtp:DatatypeCode-ST ;
.

cmns-dsg:hasName
    a owl:ObjectProperty ;
    rdfs:label "has name" ;
    rdfs:isDefinedBy cmns-dsg: ;
    rdfs:range cmns-dsg:Name ;
    rdfs:subPropertyOf cmns-dsg:isSignifiedBy ;
    owl:inverseOf cmns-dsg:isNameOf ;
    skos:definition "is known by" ;
.

cmns-dsg:hasTextualName
    a owl:DatatypeProperty ;
    rdfs:label "has textual name" ;
    rdfs:isDefinedBy cmns-dsg: ;
    rdfs:subPropertyOf cmns-txt:hasTextValue ;
    skos:definition "associates a name, reference name, or appellation with an individual concept" ;
.

cmns-dsg:isDefinedIn
    a owl:ObjectProperty ;
    rdfs:label "is defined in" ;
    rdfs:isDefinedBy cmns-dsg: ;
    skos:definition "indicates something that specifies the meaning associated with the subject" ;
.

cmns-dsg:isDescribedBy
    a owl:ObjectProperty ;
    rdfs:label "is described by" ;
    rdfs:isDefinedBy cmns-dsg: ;
    skos:definition "has general nature or description of" ;
.

cmns-dsg:isNameOf
    a owl:ObjectProperty ;
    rdfs:label "is name of" ;
    rdfs:domain cmns-dsg:Name ;
    rdfs:isDefinedBy cmns-dsg: ;
    rdfs:subPropertyOf cmns-dsg:denotes ;
    skos:definition "denotes in some context" ;
.

cmns-dsg:isSignifiedBy
    a owl:ObjectProperty ;
    rdfs:label "is signified by" ;
    rdfs:isDefinedBy cmns-dsg: ;
    rdfs:range cmns-dsg:Designation ;
    owl:inverseOf cmns-dsg:denotes ;
    skos:definition "has representation, denotation or sign of" ;
.

cmns-doc:Document
    a owl:Class ;
    rdfs:label "document" ;
    rdfs:isDefinedBy cmns-doc: ;
    skos:definition "unitary expression of some realization of an intellectual or artistic work" ;
.

cmns-doc:Record
    a owl:Class ;
    rdfs:label "record" ;
    rdfs:isDefinedBy cmns-doc: ;
    rdfs:subClassOf cmns-doc:Document ;
    skos:definition "memorialization and objective evidence of activities performed, events occurred, results achieved, or statements made, regardless of its characteristics, media, physical form, or the manner in which it is recorded or stored" ;
.

cmns-doc:Reference
    a owl:Class ;
    rdfs:label "reference" ;
    dcterms:source "ISO/TS 19844:2018(E) Health informatics - Identification of medicinal products (IDMP) - Implementation guidelines for ISO 11238 for data elements and structures for the unique identification and exchange of regulated information on substances, clause 6.4" ;
    rdfs:isDefinedBy cmns-doc: ;
    rdfs:subClassOf
        [
            a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty idmp-sub:isPublic ;
        ] ;
    skos:definition "source that may be used to ascertain, interpret, or understand something" ;
    skos:note "These sources could be regulatory submissions, publications by naming authorities such as INN or USAN, pharmacopoeias, books, journals, web sites, meeting materials or public databases such as Chemical Abstracts." ;
    cmns-av:synonym "reference source" ;
.

cmns-doc:ReferenceDocument
    a owl:Class ;
    rdfs:label "reference document" ;
    dcterms:source "ISO/TS 19844:2018(E) Health informatics - Identification of medicinal products (IDMP) - Implementation guidelines for ISO 11238 for data elements and structures for the unique identification and exchange of regulated information on substances, clause 6.4" ;
    rdfs:isDefinedBy cmns-doc: ;
    rdfs:subClassOf
        cmns-doc:Document ,
        cmns-doc:Reference ;
    skos:definition "document that is used as a reference for something" ;
    cmns-av:synonym "reference source document" ;
.

cmns-doc:Specification
    a owl:Class ;
    rdfs:label "specification" ;
    dcterms:source "ISO 11238:2018 Health informatics - Identification of medicinal products (IDMP) - Data elements and structures for the unique identification and exchange of regulated information on substances, clause 3.77" ;
    rdfs:isDefinedBy cmns-doc: ;
    skos:definition "explicit requirement or set of requirements to be satisfied by something, such as a product, material, model, process or system" ;
    skos:note
        "'Conformance to specifications' means that the drug substance, when tested according to the listed analytical procedures, will meet the listed acceptance criteria. Specifications are critical quality standards that are proposed and justified by the manufacturer and approved by regulatory authorities as conditions of approval." ,
        "In the context of IDMP, a specification is further refined to include a list of tests, references to analytical procedures, and appropriate acceptance criteria, which are numerical limits, ranges, or other criteria for the tests described. It establishes the set of criteria to which a drug substance should conform to be considered acceptable for its intended use. This definition is narrower than the general notion of a specification, as used herein." ;
.

cmns-doc:isAbout
    a owl:ObjectProperty ;
    rdfs:label "is about" ;
    rdfs:isDefinedBy cmns-doc: ;
    skos:definition "indicates the subject or topic of something, such as a document" ;
.

cmns-doc:isReferredToBy
    a owl:ObjectProperty ;
    rdfs:label "is referred to by" ;
    rdfs:isDefinedBy cmns-doc: ;
    owl:inverseOf cmns-doc:refersTo ;
    skos:definition "indicates something that is referenced as a source for information or explanation" ;
.

cmns-doc:isSpecifiedIn
    a owl:ObjectProperty ;
    rdfs:label "is specified in" ;
    rdfs:isDefinedBy cmns-doc: ;
    rdfs:subPropertyOf cmns-doc:refersTo ;
    owl:inverseOf cmns-doc:specifies ;
    skos:definition "indicates the explicit source for some requirement, fact, or set of facts" ;
.

cmns-doc:records
    a owl:ObjectProperty ;
    rdfs:label "records" ;
    rdfs:isDefinedBy cmns-doc: ;
    skos:definition "documents for later reference" ;
.

cmns-doc:refersTo
    a owl:ObjectProperty ;
    rdfs:label "refers to" ;
    rdfs:isDefinedBy cmns-doc: ;
    skos:definition "makes reference to as a source for information or explanation" ;
.

cmns-doc:specifies
    a owl:ObjectProperty ;
    rdfs:label "specifies" ;
    rdfs:isDefinedBy cmns-doc: ;
    skos:definition "mentions, names or states something clearly and definitively" ;
.

cmns-id:IdentificationScheme
    a owl:Class ;
    rdfs:label "identification scheme" ;
    rdfs:isDefinedBy cmns-id: ;
    rdfs:subClassOf cmns-col:Arrangement ;
    skos:definition "system for minting identifiers for things that specifies constraints on the structure of the identifier" ;
.

cmns-id:Identifier
    a owl:Class ;
    rdfs:label "identifier" ;
    rdfs:isDefinedBy cmns-id: ;
    rdfs:subClassOf cmns-dsg:Designation ;
    skos:definition "sequence of characters uniquely identifying that with which it is associated" ;
.

cmns-id:identifies
    a owl:ObjectProperty ;
    rdfs:label "identifies" ;
    rdfs:domain cmns-id:Identifier ;
    rdfs:isDefinedBy cmns-id: ;
    rdfs:subPropertyOf cmns-dsg:denotes ;
    skos:definition "recognizes or establishes identity within some context" ;
.

cmns-id:isIdentifiedBy
    a owl:ObjectProperty ;
    rdfs:label "is identified by" ;
    rdfs:isDefinedBy cmns-id: ;
    rdfs:range cmns-id:Identifier ;
    rdfs:subPropertyOf cmns-dsg:isSignifiedBy ;
    owl:inverseOf cmns-id:identifies ;
    skos:definition "has an identifier that is unique within some context" ;
.

cmns-lang:Language
    a owl:Class ;
    rdfs:label "language" ;
    rdfs:isDefinedBy cmns-lang: ;
    rdfs:subClassOf cmns-col:Arrangement ;
    skos:definition "systematic use of sounds, visual-spatial signs, characters or other written symbols or signs that can be combined to express or communicate meaning, understood by a community" ;
.

cmns-lang:LanguageIdentifier
    a owl:Class ;
    rdfs:label "language identifier" ;
    rdfs:isDefinedBy cmns-lang: ;
    rdfs:subClassOf
        cmns-cds:CodeElement ,
        cmns-id:Identifier ;
    skos:definition "string of characters assigned to an individual language or a language group for the purpose of identifying it unequivocally" ;
.

cmns-lang:hasLanguage
    a owl:ObjectProperty ;
    rdfs:label "has language" ;
    rdfs:isDefinedBy cmns-lang: ;
    rdfs:range cmns-lang:Language ;
    rdfs:subPropertyOf cmns-cxtdsg:uses ;
    skos:definition "is expressed in or uses a given language in some context" ;
.

cmns-loc:Country
    a owl:Class ;
    rdfs:label "country" ;
    rdfs:isDefinedBy cmns-loc: ;
    rdfs:subClassOf cmns-loc:GeopoliticalEntity ;
    skos:definition "geopolitical entity representing a distinct territorial body or political entity or dependent territory" ;
.

cmns-loc:GeographicRegion
    a owl:Class ;
    rdfs:label "geographic region" ;
    rdfs:isDefinedBy cmns-loc: ;
    rdfs:subClassOf cmns-loc:Region ;
    skos:definition "area of land that has common features" ;
.

cmns-loc:GeographicRegionIdentifier
    a owl:Class ;
    rdfs:label "geographic region identifier" ;
    rdfs:isDefinedBy cmns-loc: ;
    rdfs:subClassOf
        cmns-cds:CodeElement ,
        cmns-id:Identifier ;
    skos:definition "string of letters that indicates a code or other identifier for geographical region, assigned for the purpose of uniquely identifying it within some context" ;
.

cmns-loc:GeopoliticalEntity
    a owl:Class ;
    rdfs:label "geopolitical entity" ;
    rdfs:isDefinedBy cmns-loc: ;
    rdfs:subClassOf cmns-loc:GeographicRegion ;
    skos:definition "geographic area that represents a geophysical location associated with some form of political structure" ;
.

cmns-loc:Location
    a owl:Class ;
    rdfs:label "location" ;
    rdfs:isDefinedBy cmns-loc: ;
    skos:definition "place or position in time and/or space, including a virtual place" ;
.

cmns-loc:PhysicalLocation
    a owl:Class ;
    rdfs:label "physical location" ;
    rdfs:isDefinedBy cmns-loc: ;
    rdfs:subClassOf cmns-loc:Location ;
    skos:definition "location in physical space" ;
.

cmns-loc:Region
    a owl:Class ;
    rdfs:label "region" ;
    rdfs:isDefinedBy cmns-loc: ;
    skos:definition "area that is a continuous part of a surface, space, or body" ;
.

cmns-loc:hasCountry
    a owl:ObjectProperty ;
    rdfs:label "has country" ;
    rdfs:isDefinedBy cmns-loc: ;
    rdfs:range cmns-loc:Country ;
    rdfs:subPropertyOf cmns-loc:hasRegion ;
    skos:definition "indicates a country, such as one that is recognized by the United Nations" ;
.

cmns-loc:hasLocation
    a owl:ObjectProperty ;
    rdfs:label "has location" ;
    rdfs:isDefinedBy cmns-loc: ;
    rdfs:range cmns-loc:Location ;
    skos:definition "relates something to a location, which might be physical or virtual" ;
.

cmns-loc:hasRegion
    a owl:ObjectProperty ;
    rdfs:label "has region" ;
    rdfs:isDefinedBy cmns-loc: ;
    rdfs:range cmns-loc:GeographicRegion ;
    skos:definition "indicates a demarcated area on the surface of the Earth" ;
.

cmns-org:FormalOrganization
    a owl:Class ;
    rdfs:label
        "formal organisation"@en-GB ,
        "formal organization"@en-US ;
    rdfs:isDefinedBy cmns-org: ;
    rdfs:subClassOf cmns-org:Organization ;
    skos:definition "organization that is recognized in some legal jurisdiction, with associated rights and responsibilities" ;
    skos:prefLabel "formal organization" ;
.

cmns-org:LegalEntity
    a owl:Class ;
    rdfs:label "legal entity" ;
    rdfs:isDefinedBy cmns-org: ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass idmp-mprd:ConfidentialityIndicator ;
            owl:onProperty idmp-mprd:hasConfidentialityIndicator ;
        ] ,
        [
            a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass idmp-mprd:SmallToMediumEnterprise ;
            owl:onProperty cmns-cls:isClassifiedBy ;
        ] ,
        cmns-org:FormalOrganization ,
        cmns-org:LegalPerson ;
    skos:definition "legal person that is a partnership, corporation, or other organization having the capacity to negotiate contracts, assume financial obligations, and pay off debts, organized under the laws of some jurisdiction" ;
    skos:note "The confidentiality level of the organization information can be specified using an appropriate controlled vocabulary. The controlled term and a term identifier shall be specified." ;
    cmns-av:adaptedFrom "ISO 11615:2017 Health informatics - Identification of medicinal products (IDMP) - Data elements and structures for the unique identification and exchange of regulated medicinal product information, clause 9.4.2.2.5" ;
.

cmns-org:LegalPerson
    a owl:Class ;
    rdfs:label "legal person"@en ;
    rdfs:isDefinedBy cmns-org: ;
    rdfs:subClassOf cmns-pts:Party ;
    skos:definition "party that is recognized as having rights and obligations under the law, including but not limited to the right to sue and be sued, enter into contracts, own property, and incur financial and other obligations" ;
.

cmns-org:Organization
    a owl:Class ;
    rdfs:label
        "organisation"@en-GB ,
        "organization"@en-US ;
    rdfs:isDefinedBy cmns-org: ;
    rdfs:subClassOf cmns-pts:Party ;
    skos:definition "framework of authority within which a person, persons, or groups of people act, or are designated to act, towards some purpose, such as to meet a need or pursue collective goals" ;
    skos:prefLabel "organization" ;
.

cmns-org:OrganizationName
    a owl:Class ;
    rdfs:label
        "organisation name"@en-GB ,
        "organization name"@en-US ;
    rdfs:isDefinedBy cmns-org: ;
    rdfs:subClassOf cmns-cxtdsg:ContextualName ;
    skos:definition "designation by which some organization is known in some context" ;
    skos:prefLabel "organization name" ;
.

cmns-org:OrganizationalSubUnit
    a owl:Class ;
    rdfs:label
        "organisational sub-unit"@en-GB ,
        "organizational sub-unit"@en-US ;
    rdfs:isDefinedBy cmns-org: ;
    rdfs:subClassOf cmns-org:Organization ;
    skos:definition "any department or other entity within a larger organization that only has full recognition within the context of that organization, but requires identification for some purpose" ;
    skos:prefLabel "organizational sub-unit" ;
.

cmns-org:Service
    a owl:Class ;
    rdfs:label "service" ;
    rdfs:isDefinedBy cmns-org: ;
    skos:definition "intangible activity performed by some party for the benefit of another party" ;
.

cmns-org:ServiceProvider
    a owl:Class ;
    rdfs:label "service provider" ;
    rdfs:isDefinedBy cmns-org: ;
    rdfs:subClassOf
        cmns-pts:AgentRole ,
        cmns-rlcmp:FunctionalRole ;
    skos:definition "role of an agent that provides some service, including but not limited to commercial or professional services" ;
.

cmns-org:hasSubUnit
    a owl:ObjectProperty ;
    rdfs:label "has sub-unit" ;
    rdfs:domain cmns-org:Organization ;
    rdfs:isDefinedBy cmns-org: ;
    rdfs:range cmns-org:OrganizationalSubUnit ;
    rdfs:subPropertyOf cmns-col:hasPart ;
    owl:inverseOf cmns-org:isSubUnitOf ;
    skos:definition "relates an organization to a part of that organization" ;
.

cmns-org:hasURL
    a owl:DatatypeProperty ;
    rdfs:label "has URL" ;
    rdfs:isDefinedBy cmns-org: ;
    rdfs:range xsd:anyURI ;
    skos:definition "links something to a web resource that specifies its location on a computer network and a method for retrieving it" ;
.

cmns-org:isDomiciledIn
    a owl:ObjectProperty ;
    rdfs:label "is domiciled in" ;
    rdfs:domain cmns-org:FormalOrganization ;
    rdfs:isDefinedBy cmns-org: ;
    rdfs:range cmns-loc:GeopoliticalEntity ;
    rdfs:subPropertyOf cmns-loc:hasRegion ;
    skos:definition "indicates the principal place where an entity conducts business within some country, such as where its headquarters is located" ;
.

cmns-org:isManagedBy
    a owl:ObjectProperty ;
    rdfs:label "is managed by" ;
    rdfs:isDefinedBy cmns-org: ;
    rdfs:range cmns-pts:PartyRole ;
    rdfs:subPropertyOf cmns-pts:hasPartyRole ;
    skos:definition "indicates the role of a party that directs the affairs or administration of something or someone" ;
.

cmns-org:isProvidedBy
    a owl:ObjectProperty ;
    rdfs:label "is provided by" ;
    rdfs:isDefinedBy cmns-org: ;
    owl:inverseOf cmns-org:provides ;
    skos:definition "is made available by" ;
.

cmns-org:isSubUnitOf
    a owl:ObjectProperty ;
    rdfs:label "is sub-unit of" ;
    rdfs:domain cmns-org:OrganizationalSubUnit ;
    rdfs:isDefinedBy cmns-org: ;
    rdfs:range cmns-org:Organization ;
    rdfs:subPropertyOf cmns-col:isPartOf ;
    skos:definition "relates a part of an organization to the larger entity" ;
.

cmns-org:manages
    a owl:ObjectProperty ;
    rdfs:label "manages" ;
    rdfs:domain cmns-pts:PartyRole ;
    rdfs:isDefinedBy cmns-org: ;
    rdfs:subPropertyOf cmns-rlcmp:isRoleIn ;
    owl:inverseOf cmns-org:isManagedBy ;
    skos:definition "relates a party role to something or someone that it directs or administers in some way" ;
.

cmns-org:provides
    a owl:ObjectProperty ;
    rdfs:label "provides" ;
    rdfs:isDefinedBy cmns-org: ;
    skos:definition "makes available" ;
.

cmns-pts:Actor
    a owl:Class ;
    rdfs:label "actor" ;
    rdfs:isDefinedBy cmns-pts: ;
    rdfs:subClassOf cmns-pts:PartyRole ;
    skos:definition "primary performer in a relationship between parties, i.e., the party that does something, causes something to happen, or otherwise plays an agentive role in the relationship" ;
.

cmns-pts:Agent
    a owl:Class ;
    rdfs:label "agent" ;
    rdfs:isDefinedBy cmns-pts: ;
    skos:definition "something autonomous that can adapt to and interact with its environment" ;
.

cmns-pts:AgentRole
    a owl:Class ;
    rdfs:label "agent role" ;
    rdfs:isDefinedBy cmns-pts: ;
    rdfs:subClassOf cmns-rlcmp:Role ;
    skos:definition "role played by any agent" ;
.

cmns-pts:Party
    a owl:Class ;
    rdfs:label "party" ;
    rdfs:isDefinedBy cmns-pts: ;
    rdfs:subClassOf cmns-pts:Agent ;
    skos:definition "person or organization" ;
.

cmns-pts:PartyRole
    a owl:Class ;
    rdfs:label "party role" ;
    rdfs:isDefinedBy cmns-pts: ;
    rdfs:subClassOf cmns-pts:AgentRole ;
    skos:definition "role played by an organization or individual that may be time bound" ;
.

cmns-pts:Situation
    a owl:Class ;
    rdfs:label "situation" ;
    rdfs:isDefinedBy cmns-pts: ;
    skos:definition "setting, state of being, or relationship that is relatively stable for some period of time" ;
.

cmns-pts:Undergoer
    a owl:Class ;
    rdfs:label "undergoer" ;
    rdfs:isDefinedBy cmns-pts: ;
    rdfs:subClassOf cmns-rlcmp:Role ;
    skos:definition "something that plays the role of the object or recipient in a situation, i.e., the thing (or party) that the situation impacts, affects, or that otherwise plays a passive recipient / patient or thematic role" ;
.

cmns-pts:actsIn
    a owl:ObjectProperty ;
    rdfs:label "acts in" ;
    rdfs:domain cmns-pts:Actor ;
    rdfs:isDefinedBy cmns-pts: ;
    rdfs:range cmns-pts:Situation ;
    rdfs:subPropertyOf cmns-pts:isSubjectRoleIn ;
    owl:inverseOf cmns-pts:hasActor ;
    skos:definition "indicates a situation in which the actor plays a primary role" ;
.

cmns-pts:actsOn
    a owl:ObjectProperty ;
    rdfs:label "acts on" ;
    rdfs:isDefinedBy cmns-pts: ;
    owl:inverseOf cmns-pts:isAffectedBy ;
    skos:definition "relates an actor in a given situation to the undergoer that they affect under the circumstances" ;
.

cmns-pts:experiences
    a owl:ObjectProperty ;
    rdfs:label "experiences" ;
    rdfs:isDefinedBy cmns-pts: ;
    skos:definition "relates something to a situation that affects them in some way" ;
.

cmns-pts:hasActor
    a owl:ObjectProperty ;
    rdfs:label "has actor" ;
    rdfs:domain cmns-pts:Situation ;
    rdfs:isDefinedBy cmns-pts: ;
    rdfs:range cmns-pts:Actor ;
    rdfs:subPropertyOf
        cmns-pts:hasPartyRole ,
        cmns-pts:hasSubjectRole ;
    skos:definition "identifies the primary party acting in a specific role with respect to a given situation" ;
.

cmns-pts:hasObjectRole
    a owl:ObjectProperty ;
    rdfs:label "has object role" ;
    rdfs:isDefinedBy cmns-pts: ;
    rdfs:range cmns-rlcmp:Role ;
    rdfs:subPropertyOf cmns-rlcmp:hasRole ;
    skos:definition "identifies a person or thing that is affected by, or is a secondary argument in a specific role with respect to a given relation or situation" ;
.

cmns-pts:hasPartyRole
    a owl:ObjectProperty ;
    rdfs:label "has party role" ;
    rdfs:isDefinedBy cmns-pts: ;
    rdfs:range cmns-pts:PartyRole ;
    rdfs:subPropertyOf cmns-rlcmp:hasRole ;
    skos:definition "identifies a specific role played by some person or organization as related to a situation, agreement, contract, policy, regulation, activity or other relationship" ;
.

cmns-pts:hasSubjectRole
    a owl:ObjectProperty ;
    rdfs:label "has subject role" ;
    rdfs:domain cmns-pts:Situation ;
    rdfs:isDefinedBy cmns-pts: ;
    rdfs:range cmns-rlcmp:Role ;
    rdfs:subPropertyOf cmns-rlcmp:hasRole ;
    skos:definition "identifies the person or thing that is being discussed, described, dealt with, or is the main topic in a specific role with respect to a given situation" ;
.

cmns-pts:hasUndergoer
    a owl:ObjectProperty ;
    rdfs:label "has undergoer" ;
    rdfs:domain cmns-pts:Situation ;
    rdfs:isDefinedBy cmns-pts: ;
    rdfs:range cmns-pts:Undergoer ;
    rdfs:subPropertyOf cmns-pts:hasObjectRole ;
    skos:definition "identifies an experiencer / passive or other object role in a given situation" ;
.

cmns-pts:holdsDuring
    a owl:ObjectProperty ;
    rdfs:label "holds during" ;
    rdfs:isDefinedBy cmns-pts: ;
    rdfs:range cmns-dt:DatePeriod ;
    rdfs:subPropertyOf cmns-cxtdsg:hasApplicablePeriod ;
    skos:definition "indicates a date period during which something is true" ;
.

cmns-pts:isAffectedBy
    a owl:ObjectProperty ;
    rdfs:label "is affected by" ;
    rdfs:isDefinedBy cmns-pts: ;
    skos:definition "relates an undergoer in a given situation to the actor that has an impact on them under the circumstances" ;
.

cmns-pts:isExperiencedBy
    a owl:ObjectProperty ;
    rdfs:label "is experienced by" ;
    rdfs:isDefinedBy cmns-pts: ;
    owl:inverseOf cmns-pts:experiences ;
    skos:definition "relates a situation to something that is directly involved in or affected by it" ;
.

cmns-pts:isObjectRoleIn
    a owl:ObjectProperty ;
    rdfs:label "is object role in" ;
    rdfs:domain cmns-rlcmp:Role ;
    rdfs:isDefinedBy cmns-pts: ;
    rdfs:subPropertyOf cmns-rlcmp:isRoleIn ;
    owl:inverseOf cmns-pts:hasObjectRole ;
    skos:definition "indicates a situation in which the role is secondary, such as an experiencer or passive participant" ;
.

cmns-pts:isSubjectRoleIn
    a owl:ObjectProperty ;
    rdfs:label "is subject role in" ;
    rdfs:domain cmns-rlcmp:Role ;
    rdfs:isDefinedBy cmns-pts: ;
    rdfs:range cmns-pts:Situation ;
    rdfs:subPropertyOf cmns-rlcmp:isRoleIn ;
    owl:inverseOf cmns-pts:hasSubjectRole ;
    skos:definition "indicates a situation in which the role is the primary topic" ;
.

cmns-pts:undergoes
    a owl:ObjectProperty ;
    rdfs:label "undergoes" ;
    rdfs:domain cmns-pts:Undergoer ;
    rdfs:isDefinedBy cmns-pts: ;
    rdfs:range cmns-pts:Situation ;
    rdfs:subPropertyOf cmns-pts:isObjectRoleIn ;
    owl:inverseOf cmns-pts:hasUndergoer ;
    skos:definition "indicates a situation that the undergoer experiences" ;
.

cmns-prd:Buyer
    a owl:Class ;
    rdfs:label "buyer" ;
    rdfs:isDefinedBy cmns-prd: ;
    rdfs:subClassOf cmns-pts:PartyRole ;
    skos:definition "party that purchases something in exchange for money or other consideration under a contract of sale" ;
.

cmns-prd:CommercialProduct
    a owl:Class ;
    rdfs:label "commercial product" ;
    rdfs:isDefinedBy cmns-prd: ;
    rdfs:subClassOf cmns-prd:Product ;
    skos:definition "commercially distributed good that is (1) tangible property, (2) the output or result of a fabrication, manufacturing, or production process, or (3) something that passes through a distribution channel before being consumed or used" ;
.

cmns-prd:Good
    a owl:Class ;
    rdfs:label "good" ;
    rdfs:isDefinedBy cmns-prd: ;
    rdfs:subClassOf idmp-sub:Matter ;
    skos:definition "physical, produced item over which ownership rights can be established, whose ownership can be passed from one party to another by engaging in transactions, and that is not money or real estate" ;
    cmns-av:explanatoryNote "Note that the concept of 'good' as used in IDMP and by definition is a physical concept, and includes raw materials, intermediate materials, physical products, and substances of a defined amount." ;
.

cmns-prd:MonetaryAmount
    a owl:Class ;
    rdfs:label "monetary amount" ;
    rdfs:isDefinedBy cmns-prd: ;
    rdfs:subClassOf cmns-qtu:ScalarQuantityValue ;
    skos:definition "measure that is an amount of money specified in monetary units" ;
.

cmns-prd:MonetaryPrice
    a owl:Class ;
    rdfs:label "monetary price" ;
    rdfs:isDefinedBy cmns-prd: ;
    rdfs:subClassOf
        cmns-prd:MonetaryAmount ,
        cmns-prd:Price ;
    skos:definition "price that that is expressed as a monetary amount" ;
.

cmns-prd:Price
    a owl:Class ;
    rdfs:label "price" ;
    rdfs:isDefinedBy cmns-prd: ;
    rdfs:subClassOf cmns-qtu:ScalarQuantityValue ;
    skos:definition "amount of money, goods, or services requested, expected, required, or given in exchange for something else" ;
.

cmns-prd:Producer
    a owl:Class ;
    rdfs:label "producer" ;
    rdfs:isDefinedBy cmns-prd: ;
    rdfs:subClassOf
        cmns-pts:Actor ,
        cmns-rlcmp:FunctionalRole ;
    skos:definition "grower, maker, fabricator, or manufacturer of some product or other good" ;
.

cmns-prd:Product
    a owl:Class ;
    rdfs:label "product" ;
    rdfs:isDefinedBy cmns-prd: ;
    rdfs:subClassOf idmp-sub:Matter ;
    skos:definition "something that is produced by, results from, or obtained as a consequence of some process or transformation" ;
.

cmns-prd:Right
    a owl:Class ;
    rdfs:label "right" ;
    rdfs:isDefinedBy cmns-prd: ;
    skos:definition "entitlement (not) to perform certain actions, or (not) to be in certain states; or entitlement that others (not) perform certain actions or (not) be in certain states" ;
.

cmns-prd:Sale
    a owl:Class ;
    rdfs:label "sale" ;
    rdfs:isDefinedBy cmns-prd: ;
    rdfs:subClassOf cmns-pts:Situation ;
    skos:definition "exchange of goods or services for money" ;
.

cmns-prd:Seller
    a owl:Class ;
    rdfs:label "seller" ;
    rdfs:isDefinedBy cmns-prd: ;
    rdfs:subClassOf cmns-pts:PartyRole ;
    skos:definition "party that makes, offers or contracts to make a sale to an actual or potential buyer" ;
.

cmns-prd:StockKeepingUnit
    a owl:Class ;
    rdfs:label "stock keeping unit" ;
    rdfs:isDefinedBy cmns-prd: ;
    rdfs:subClassOf
        cmns-cls:Classifier ,
        cmns-cxtdsg:ContextualDesignation ;
    skos:definition "unique classifier for a class of items for sale, purchased, and/or tracked in inventory, sometimes represented via a barcode for scanning and tracking, used within the context of an organization" ;
.

cmns-prd:TradeItem
    a owl:Class ;
    rdfs:label "trade item" ;
    rdfs:isDefinedBy cmns-prd: ;
    skos:definition "any item (product or service) upon which there is a need to retrieve predefined information and that may be priced, or ordered, or invoiced at any point in any supply chain" ;
.

cmns-prd:buys
    a owl:ObjectProperty ;
    rdfs:label "buys" ;
    rdfs:domain cmns-prd:Buyer ;
    rdfs:isDefinedBy cmns-prd: ;
    rdfs:range cmns-prd:Product ;
    skos:definition "links a party in the role of purchaser to something that they have purchased or plan to purchase" ;
.

cmns-prd:hasBuyer
    a owl:ObjectProperty ;
    rdfs:label "has buyer"@en ;
    rdfs:isDefinedBy cmns-prd: ;
    rdfs:range cmns-prd:Buyer ;
    rdfs:subPropertyOf
        cmns-pts:hasPartyRole ,
        cmns-pts:hasUndergoer ;
    skos:definition "indicates the purchasing party in the context of a sales transaction" ;
.

cmns-prd:hasPrice
    a owl:ObjectProperty ;
    rdfs:label "has price" ;
    rdfs:isDefinedBy cmns-prd: ;
    rdfs:range cmns-prd:Price ;
    rdfs:subPropertyOf cmns-qtu:hasQuantityValue ;
    skos:definition "indicates the value of something expressed as an amount of money or goods" ;
.

cmns-prd:hasSeller
    a owl:ObjectProperty ;
    rdfs:label "has seller"@en ;
    rdfs:isDefinedBy cmns-prd: ;
    rdfs:range cmns-prd:Seller ;
    rdfs:subPropertyOf cmns-pts:hasActor ;
    skos:definition "indicates the vendor in the context of a sales transaction" ;
.

cmns-prd:isPriceFor
    a owl:ObjectProperty ;
    rdfs:label "is price for" ;
    rdfs:domain cmns-prd:Price ;
    rdfs:isDefinedBy cmns-prd: ;
    rdfs:subPropertyOf cmns-doc:refersTo ;
    owl:inverseOf cmns-prd:hasPrice ;
    skos:definition "links a price to something it provides a value for" ;
.

cmns-prd:isProducedBy
    a owl:ObjectProperty ;
    rdfs:label "is produced by" ;
    rdfs:isDefinedBy cmns-prd: ;
    rdfs:range cmns-prd:Producer ;
    owl:inverseOf cmns-prd:produces ;
    skos:definition "is fabricated, manufactured or otherwise created by, through some production process" ;
.

cmns-prd:produces
    a owl:ObjectProperty ;
    rdfs:label "produces" ;
    rdfs:domain cmns-prd:Producer ;
    rdfs:isDefinedBy cmns-prd: ;
    skos:definition "creates through a fabrication, manufacturing or production process" ;
.

cmns-prd:sells
    a owl:ObjectProperty ;
    rdfs:label "sells" ;
    rdfs:domain cmns-prd:Seller ;
    rdfs:isDefinedBy cmns-prd: ;
    rdfs:range cmns-prd:Product ;
    skos:definition "links a party in the role of broker, dealer, vendor, or merchandiser to something that they make available for sale" ;
.

cmns-qtu:BaseQuantityKind
    a owl:Class ;
    rdfs:label "base quantity kind" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:subClassOf cmns-qtu:QuantityKind ;
    skos:definition "quantity in a conventionally chosen subset of a given system of quantities, where no quantity in the subset can be expressed in terms of the other quantities within that subset" ;
.

cmns-qtu:BaseUnit
    a owl:Class ;
    rdfs:label "base unit" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:subClassOf cmns-qtu:PhysicalUnit ;
    skos:definition "measurement unit that is defined by a system of units to be the reference measurement unit for a base quantity" ;
.

cmns-qtu:ConversionBasedUnit
    a owl:Class ;
    rdfs:label "conversion-based unit" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:subClassOf cmns-qtu:DerivedUnit ;
    skos:definition "derived unit that is defined with respect to another reference unit through an explicit conversion relationship" ;
.

cmns-qtu:DerivedQuantityKind
    a owl:Class ;
    rdfs:label "derived quantity kind" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:subClassOf cmns-qtu:QuantityKind ;
    skos:definition "quantity, in a system of quantities, defined in terms of the base quantities of that system" ;
.

cmns-qtu:DerivedUnit
    a owl:Class ;
    rdfs:label "derived unit" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:subClassOf cmns-qtu:PhysicalUnit ;
    skos:definition "measurement unit for a derived quantity, i.e., one that is defined with respect to one or more base units, such as as a product of powers of one or more other measurement units" ;
.

cmns-qtu:Expression
    a owl:Class ;
    rdfs:label "expression" ;
    rdfs:isDefinedBy cmns-qtu: ;
    skos:definition "finite combination of symbols that are well-formed according to applicable rules" ;
.

cmns-qtu:Factor
    a owl:Class ;
    rdfs:label "factor" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:subClassOf cmns-cls:Aspect ;
    skos:definition "number or quantity that when multiplied with another produces a given number or expression" ;
.

cmns-qtu:InternationalSystemOfQuantities
    a
        owl:NamedIndividual ,
        cmns-qtu:SystemOfQuantities ;
    rdfs:label "International System of Quantities" ;
    rdfs:isDefinedBy cmns-qtu: ;
    skos:definition "system of quantities based on the seven base quantities: length, mass, time, electric current, thermodynamic temperature, amount of substance, and luminous intensity" ;
.

cmns-qtu:InternationalSystemOfUnits
    a
        owl:NamedIndividual ,
        cmns-qtu:SystemOfUnits ;
    rdfs:label "International System of Units" ;
    rdfs:isDefinedBy cmns-qtu: ;
    skos:definition "system of units, based on the International System of Quantities, their names and symbols, including a series of prefixes and their names and symbols, together with rules for their use, adopted by the General Conference on Weights and Measures (CGPM)" ;
.

cmns-qtu:MeasurementReference
    a owl:Class ;
    rdfs:label "measurement reference" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:subClassOf cmns-doc:Reference ;
    skos:definition "measurement unit, measurement procedure, reference material, or a combination of such" ;
.

cmns-qtu:MeasurementUnit
    a owl:Class ;
    rdfs:label "measurement unit" ;
    dcterms:source "ISO 11240 Health informatics - Identification of medicinal products - Data elements and structures for the unique identification and exchange of units of measurement, clause 4.6.2.1, Table 1" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:onProperty cmns-id:isIdentifiedBy ;
            owl:someValuesFrom idmp-uom:UnitOfMeasureIdentifier ;
        ] ,
        [
            a owl:Restriction ;
            owl:onDataRange xsd:boolean ;
            owl:onProperty idmp-uom:isSIQuantity ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        ] ,
        [
            a owl:Restriction ;
            owl:onDataRange cmns-txt:Text ;
            owl:onProperty cmns-dsg:hasDescription ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        ] ,
        cmns-qtu:MeasurementReference ,
        cmns-qtu:ScalarQuantity ;
    skos:definition "real scalar quantity, defined and adopted by convention, with which any other quantity of the same kind can be compared to express the ratio of the second quantity to the first one as a number" ;
    skos:note
        "Each core unit of measurement concept may have one or more associated unit of measurement code entries from different CodeSystems, reflecting the fact that a unit of measurement concept can be present in multiple unit of measurement dictionaries or coding systems (e.g. UCUM, NCI Thesaurus, SNOMED)." ,
        "The two core attributes (identifier and definition) refer to the abstract concept, and shall be part of its core definition. The identifier represents a particular unit quantity and refers to the underlying metrological or published definitions, e.g. the SI base units, through the intrinsic formalism that is provided by the reference code system." ;
.

cmns-qtu:PhysicalUnit
    a owl:Class ;
    rdfs:label "physical unit" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:subClassOf cmns-qtu:MeasurementUnit ;
    skos:definition "unit of measurement that is defined using a physical quantity" ;
.

cmns-qtu:Prefix
    a owl:Class ;
    rdfs:label "prefix" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:subClassOf cmns-qtu:Factor ;
    skos:definition "named multiple or sub-multiple multiplication factor used in the specification of a derived unit" ;
.

cmns-qtu:PrefixedUnit
    a owl:Class ;
    rdfs:label "prefixed unit" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:subClassOf cmns-qtu:ConversionBasedUnit ;
    skos:definition "conversion-based unit that is defined with respect to another measurement reference unit through a linear conversion relationship with a named prefix that represents a multiple or submultiple of a unit" ;
.

cmns-qtu:QuantityDimension
    a owl:Class ;
    rdfs:label "quantity dimension" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:subClassOf cmns-cls:Classifier ;
    skos:definition "expression of the dependence of a quantity on the base quantities of a system of quantities as a product of powers of factors corresponding to the base quantities, omitting any numerical factor" ;
.

cmns-qtu:QuantityKind
    a owl:Class ;
    rdfs:label "quantity kind" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:subClassOf cmns-cls:Classifier ;
    skos:definition "aspect common to mutually comparable quantities" ;
.

cmns-qtu:ScalarQuantity
    a owl:Class ;
    rdfs:label "scalar quantity" ;
    rdfs:isDefinedBy cmns-qtu: ;
    skos:definition "property of a phenomenon, body, or substance, where the property has a magnitude that can be expressed by means of a number and a reference" ;
.

cmns-qtu:ScalarQuantityValue
    a owl:Class ;
    rdfs:label "scalar quantity value" ;
    rdfs:isDefinedBy cmns-qtu: ;
    skos:definition "number and reference together expressing the magnitude of a quantity" ;
.

cmns-qtu:ScalarQuantityValueRange
    a owl:Class ;
    rdfs:label "scalar quantity value range" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:subClassOf cmns-qtu:Expression ;
    skos:definition "expression of the lowest possible value and/or highest possible value for some scalar quantity" ;
.

cmns-qtu:SystemOfQuantities
    a owl:Class ;
    rdfs:label "system of quantities"@en ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:subClassOf cmns-cls:ClassificationScheme ;
    skos:definition "set of quantities together with a set of non-contradictory equations relating those quantities" ;
.

cmns-qtu:SystemOfUnits
    a owl:Class ;
    rdfs:label "system of units" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:subClassOf cmns-cls:ClassificationScheme ;
    skos:definition "set of base units and derived units, together with their multiples and submultiples, defined in accordance with given rules, for a given system of quantities" ;
.

cmns-qtu:expressesTheMagnitudeOf
    a owl:ObjectProperty ;
    rdfs:label "expresses the magnitude of" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:range cmns-qtu:ScalarQuantity ;
    skos:definition "specifies the quantity that some quantity value reflects" ;
.

cmns-qtu:hasArgument
    a owl:ObjectProperty ;
    rdfs:label "has argument" ;
    rdfs:isDefinedBy cmns-qtu: ;
    skos:definition "indicates a specific input to a function, formula or expression, also known as an independent variable" ;
.

cmns-qtu:hasDenominator
    a owl:ObjectProperty ;
    rdfs:label "has denominator" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:subPropertyOf cmns-qtu:hasArgument ;
    skos:definition "specifies the quantity value that is the part of a fraction 'below the line' and signifies the value by which the numerator should be divided" ;
.

cmns-qtu:hasDimension
    a owl:ObjectProperty ;
    rdfs:label "has dimension" ;
    rdfs:domain cmns-qtu:QuantityKind ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:range cmns-qtu:QuantityDimension ;
    rdfs:subPropertyOf cmns-cls:isClassifiedBy ;
    skos:definition "indicates a measurable extent associated with a given quantity kind in some system of quantities, which may be derived, depending on the choice of base quantity" ;
.

cmns-qtu:hasExpression
    a owl:ObjectProperty ;
    rdfs:label "has expression" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:range cmns-qtu:Expression ;
    skos:definition "specifies a finite combination of symbols, including constants, variables that may be ordered via one or more operators, that is well-formed according to rules that depend on the language and context" ;
.

cmns-qtu:hasFactor
    a owl:ObjectProperty ;
    rdfs:label "has factor" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:subPropertyOf cmns-qtu:hasArgument ;
    skos:definition "indicates a number or quantity that when multiplied with another produces a given number or expression" ;
.

cmns-qtu:hasLowerBound
    a owl:ObjectProperty ;
    rdfs:label "has lower bound" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:range cmns-qtu:ScalarQuantityValue ;
    rdfs:subPropertyOf
        cmns-qtu:hasArgument ,
        cmns-qtu:hasQuantityValue ;
    skos:definition "specifies the quantity value that is the lower value of a pair of values representing a range" ;
.

cmns-qtu:hasMeasurementReference
    a owl:ObjectProperty ;
    rdfs:label "has measurement reference" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:range cmns-qtu:MeasurementReference ;
    skos:definition "indicates the reference against which a quantity can be expressed with respect to a number" ;
.

cmns-qtu:hasMeasurementUnit
    a owl:ObjectProperty ;
    rdfs:label "has measurement unit" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:range cmns-qtu:MeasurementUnit ;
    rdfs:subPropertyOf cmns-qtu:hasMeasurementReference ;
    skos:definition "indicates the unit against which a quantity can be expressed in a quantity value" ;
.

cmns-qtu:hasNumerator
    a owl:ObjectProperty ;
    rdfs:label "has numerator" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:subPropertyOf cmns-qtu:hasArgument ;
    skos:definition "specifies the quantity value that is the part of a fraction 'above the line' and signifies the value to be divided by the denominator" ;
.

cmns-qtu:hasNumericValue
    a owl:DatatypeProperty ;
    rdfs:label "has numeric value" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:range xsd:decimal ;
    skos:definition "indicates a particular magnitude or designation for a given observable characteristic that is a number" ;
.

cmns-qtu:hasQuantityKind
    a owl:ObjectProperty ;
    rdfs:label "has quantity kind" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:range cmns-qtu:QuantityKind ;
    rdfs:subPropertyOf cmns-cls:isClassifiedBy ;
    skos:definition "indicates the class of mutually comparable quantities involved in the definition of an individual quantity or factor" ;
.

cmns-qtu:hasQuantityValue
    a owl:ObjectProperty ;
    rdfs:label "has quantity value" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:range cmns-qtu:ScalarQuantityValue ;
    skos:definition "relates something (an expression, formula, etc.) to its magnitude expressed as a number together with its unit of measure (if applicable)" ;
    idmp-sub:hasBusinessRules "A quantity value is an individual value rather than a range, and should not be used with low limit or high limit, or a non-numeric value." ;
    idmp-sub:hasConformanceLevel idmp-sub:ConformanceLevel-Conditional ;
    idmp-sub:hasValuesAllowed "Exact or approximate quantitative value or an average value for a given element. NOTE The element 'Amount Type' is used to distinguish." ;
    idmp-dtp:isEncodedAs idmp-dtp:DatatypeCode-PQ ;
.

cmns-qtu:hasQuantityValueRange
    a owl:ObjectProperty ;
    rdfs:label "has quantity value range" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:range cmns-qtu:ScalarQuantityValueRange ;
    rdfs:subPropertyOf cmns-qtu:hasExpression ;
    skos:definition "relates something (an expression, formula, etc.) to its magnitude expressed as range of numbers together with their unit(s) of measure (if applicable)" ;
    idmp-sub:hasBusinessRules "Not to be used with Quantity or Non-numeric Value. Both limits must have the same dimension and units." ;
    idmp-sub:hasConformanceLevel idmp-sub:ConformanceLevel-Conditional ;
    idmp-dtp:isEncodedAs idmp-dtp:DatatypeCode-PQ ;
    cmns-av:explanatoryNote "A quantity value range includes the lower and upper bound which can be mapped, using SPARQL, to the low limit (ISO 19844 clause 6.8.3) and high limit (ISO 19844 clause 6.8.4) and ensures consistency across both limits through common dimensions and units." ;
.

cmns-qtu:hasUpperBound
    a owl:ObjectProperty ;
    rdfs:label "has upper bound" ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:range cmns-qtu:ScalarQuantityValue ;
    rdfs:subPropertyOf
        cmns-qtu:hasArgument ,
        cmns-qtu:hasQuantityValue ;
    skos:definition "specifies the quantity value that is the higher value of a pair of values representing a range" ;
.

cmns-qtu:isDerivedFrom
    a owl:ObjectProperty ;
    rdfs:label "is derived from" ;
    rdfs:isDefinedBy cmns-qtu: ;
    skos:definition "indicates something from which the subject is obtained or determined" ;
.

cmns-qtu:isDimensionOf
    a owl:ObjectProperty ;
    rdfs:label "is dimension of" ;
    rdfs:domain cmns-qtu:QuantityDimension ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:range cmns-qtu:QuantityKind ;
    rdfs:subPropertyOf cmns-cls:classifies ;
    owl:inverseOf cmns-qtu:hasDimension ;
    skos:definition "indicates a measurable extent associated with a given quantity kind in some system of quantities, which may be derived, depending on the choice of base quantity" ;
.

cmns-qtu:isValueOf
    a owl:ObjectProperty ;
    rdfs:label "is value of" ;
    rdfs:domain cmns-qtu:ScalarQuantityValue ;
    rdfs:isDefinedBy cmns-qtu: ;
    rdfs:subPropertyOf cmns-cxtdsg:appliesTo ;
    owl:inverseOf cmns-qtu:hasQuantityValue ;
    skos:definition "is the measure that the value represents" ;
.

cmns-qtu:specializes
    a owl:ObjectProperty ;
    rdfs:label "specializes" ;
    rdfs:isDefinedBy cmns-qtu: ;
    skos:definition "indicates something whose nature is more general (broader than) the subject" ;
.

cmns-ra:RegisteredIdentifier
    a owl:Class ;
    rdfs:label "registered identifier" ;
    rdfs:isDefinedBy cmns-ra: ;
    rdfs:subClassOf cmns-cxtid:ContextualIdentifier ;
    skos:definition "contextual identifier that is registered in a registry by, or on behalf of, a registration authority according to some registration scheme" ;
.

cmns-ra:Registrar
    a owl:Class ;
    rdfs:label "registrar" ;
    rdfs:isDefinedBy cmns-ra: ;
    rdfs:subClassOf
        cmns-org:ServiceProvider ,
        cmns-pts:Actor ;
    skos:definition "role of a party that acts as a representative of a registration authority to provide registration services, including official record keeping" ;
.

cmns-ra:RegistrationAuthority
    a owl:Class ;
    rdfs:label "registration authority" ;
    rdfs:isDefinedBy cmns-ra: ;
    rdfs:subClassOf
        cmns-bauth:AuthorizingParty ,
        cmns-org:ServiceProvider ;
    skos:definition "service provider that is officially responsible for maintaining a registry and providing registration services and/or for delegating of some or all of these roles to a registrar" ;
.

cmns-ra:RegistrationScheme
    a owl:Class ;
    rdfs:label "registration scheme" ;
    rdfs:isDefinedBy cmns-ra: ;
    rdfs:subClassOf cmns-id:IdentificationScheme ;
    skos:definition "scheme for organizing information in a registry and allocating identifiers to registered items" ;
.

cmns-ra:RegistrationService
    a owl:Class ;
    rdfs:label "registration service" ;
    rdfs:isDefinedBy cmns-ra: ;
    rdfs:subClassOf cmns-org:Service ;
    skos:definition "service provided to individuals and/or organizations for the registration of items in a registry" ;
.

cmns-ra:Registry
    a owl:Class ;
    rdfs:label "registry" ;
    rdfs:isDefinedBy cmns-ra: ;
    rdfs:subClassOf
        cmns-col:StructuredCollection ,
        cmns-doc:Record ;
    skos:definition "authoritative record or collection of records relating to something" ;
.

cmns-ra:RegistryEntry
    a owl:Class ;
    rdfs:label "registry entry" ;
    rdfs:isDefinedBy cmns-ra: ;
    rdfs:subClassOf cmns-col:Constituent ;
    skos:definition "constituent of a registry that includes the details for something recorded in that registry" ;
.

cmns-ra:hasRegistrationAuthority
    a owl:ObjectProperty ;
    rdfs:label "has registration authority" ;
    rdfs:isDefinedBy cmns-ra: ;
    rdfs:range cmns-ra:RegistrationAuthority ;
    rdfs:subPropertyOf cmns-pts:hasPartyRole ;
    owl:inverseOf cmns-ra:isRegistrationAuthorityFor ;
    skos:definition "indicates the registration authority for something" ;
.

cmns-ra:hasRegistrationDate
    a owl:DatatypeProperty ;
    rdfs:label "has registration date" ;
    rdfs:isDefinedBy cmns-ra: ;
    rdfs:range cmns-dt:CombinedDateTime ;
    rdfs:subPropertyOf cmns-dt:hasObservedDateTime ;
    skos:definition "indicates the date or date and time on which something is registered" ;
.

cmns-ra:isRegisteredBy
    a owl:ObjectProperty ;
    rdfs:label "is registered by" ;
    rdfs:isDefinedBy cmns-ra: ;
    rdfs:range cmns-ra:Registrar ;
    rdfs:subPropertyOf cmns-pts:hasPartyRole ;
    skos:definition "indicates the registration authority or registrar that registers something" ;
.

cmns-ra:isRegisteredIn
    a owl:ObjectProperty ;
    rdfs:label "is registered in" ;
    rdfs:isDefinedBy cmns-ra: ;
    rdfs:range cmns-ra:Registry ;
    rdfs:subPropertyOf cmns-doc:refersTo ;
    skos:definition "indicates the registry that something is registered in" ;
.

cmns-ra:isRegistrationAuthorityFor
    a owl:ObjectProperty ;
    rdfs:label "is registration authority for" ;
    rdfs:domain cmns-ra:RegistrationAuthority ;
    rdfs:isDefinedBy cmns-ra: ;
    rdfs:subPropertyOf cmns-rlcmp:isRoleIn ;
    skos:definition "indicates something (typically an identifier or code) that the registration authority issues" ;
.

cmns-ra:registers
    a owl:ObjectProperty ;
    rdfs:label "registers" ;
    rdfs:domain cmns-ra:Registrar ;
    rdfs:isDefinedBy cmns-ra: ;
    rdfs:subPropertyOf
        cmns-doc:records ,
        cmns-rlcmp:isRoleIn ;
    owl:inverseOf cmns-ra:isRegisteredBy ;
    skos:definition "records something in a registry or archive" ;
.

cmns-rga:Jurisdiction
    a owl:Class ;
    rdfs:label "jurisdiction"@en ;
    rdfs:isDefinedBy cmns-rga: ;
    rdfs:subClassOf cmns-cxtdsg:Context ;
    skos:definition "power of a court or regulatory agency to adjudicate cases, issue orders, and interpret and apply the law with respect to some specific geographic area" ;
.

cmns-rga:RegulatoryAgency
    a owl:Class ;
    rdfs:label "regulatory agency" ;
    rdfs:isDefinedBy cmns-rga: ;
    rdfs:subClassOf
        cmns-bauth:AuthorizingParty ,
        cmns-org:ServiceProvider ;
    skos:definition "public authority or government agency responsible for exercising authority over something in a regulatory or supervisory capacity" ;
.

cmns-rga:governs
    a owl:ObjectProperty ;
    rdfs:label "governs" ;
    rdfs:isDefinedBy cmns-rga: ;
    skos:definition "has and exercises authority over" ;
.

cmns-rga:hasJurisdiction
    a owl:ObjectProperty ;
    rdfs:label "has jurisdiction" ;
    rdfs:isDefinedBy cmns-rga: ;
    rdfs:range cmns-rga:Jurisdiction ;
    rdfs:subPropertyOf cmns-rga:governs ;
    skos:definition "relates a polity, government entity or regulatory agency to a jurisdiction over which it has some level of legal authority" ;
.

cmns-rga:hasReach
    a owl:ObjectProperty ;
    rdfs:label "has reach" ;
    rdfs:domain cmns-rga:Jurisdiction ;
    rdfs:isDefinedBy cmns-rga: ;
    rdfs:range cmns-loc:GeographicRegion ;
    rdfs:subPropertyOf cmns-cxtdsg:isApplicableIn ;
    skos:definition "indicates the geographic region covered by the jurisdiction" ;
.

cmns-rga:isApplicableInJurisdiction
    a owl:ObjectProperty ;
    rdfs:label "is applicable in jurisdiction" ;
    rdfs:isDefinedBy cmns-rga: ;
    skos:definition "indicates the geopolitical region identifier for the jurisdiction in which something is applicable" ;
.

cmns-rga:isGovernedBy
    a owl:ObjectProperty ;
    rdfs:label "is governed by" ;
    rdfs:isDefinedBy cmns-rga: ;
    owl:inverseOf cmns-rga:governs ;
    skos:definition "relates a contract, agreement, jurisdiction, or other legal construct and the regulation, policy, procedure, or legal person that regulates or oversees (governs) it" ;
.

cmns-rga:isJurisdictionOf
    a owl:ObjectProperty ;
    rdfs:label "is jurisdiction of" ;
    rdfs:domain cmns-rga:Jurisdiction ;
    rdfs:isDefinedBy cmns-rga: ;
    rdfs:subPropertyOf cmns-rga:isGovernedBy ;
    owl:inverseOf cmns-rga:hasJurisdiction ;
    skos:definition "relates a jurisdiction to a polity or other government entity or court that has some level of legal authority over it" ;
.

cmns-rga:isOrganizedIn
    a owl:ObjectProperty ;
    rdfs:label "is organized in" ;
    rdfs:domain cmns-org:LegalEntity ;
    rdfs:isDefinedBy cmns-rga: ;
    rdfs:range cmns-rga:Jurisdiction ;
    rdfs:subPropertyOf cmns-rga:isRecognizedIn ;
    skos:definition "indicates the jurisdiction whose laws a legal entity is organized under" ;
.

cmns-rga:isRecognizedIn
    a owl:ObjectProperty ;
    rdfs:label "is recognized in" ;
    rdfs:isDefinedBy cmns-rga: ;
    rdfs:range cmns-rga:Jurisdiction ;
    rdfs:subPropertyOf cmns-rga:isGovernedBy ;
    skos:definition "indicates the jurisdiction in which a legal person is considered competent to enter into a contract, conduct business, or participate in other activities, or in which an agreement may be acknowledged and possibly enforceable" ;
.

cmns-rga:isRegulatedBy
    a owl:ObjectProperty ;
    rdfs:label "is regulated by" ;
    rdfs:isDefinedBy cmns-rga: ;
    rdfs:range cmns-rga:RegulatoryAgency ;
    rdfs:subPropertyOf
        cmns-pts:hasPartyRole ,
        cmns-rga:isGovernedBy ;
    skos:definition "specifies a regulatory agency that has regulatory authority for something" ;
.

cmns-rga:regulates
    a owl:ObjectProperty ;
    rdfs:label "regulates" ;
    rdfs:domain cmns-rga:RegulatoryAgency ;
    rdfs:isDefinedBy cmns-rga: ;
    rdfs:subPropertyOf cmns-rga:governs ;
    skos:definition "has regulatory authority over or directs according to rule or law, typically an industry, organization, or product" ;
.

cmns-rlcmp:Composition
    a owl:Class ;
    rdfs:label "composition" ;
    rdfs:isDefinedBy cmns-rlcmp: ;
    skos:definition "distinct thing resulting from bringing together other things, possibly in specific roles, for a particular purpose" ;
.

cmns-rlcmp:FunctionalRole
    a owl:Class ;
    rdfs:label "functional role" ;
    rdfs:isDefinedBy cmns-rlcmp: ;
    rdfs:subClassOf cmns-rlcmp:Role ;
    skos:definition "role representing an underlying functionality that something, such as a person, organization, process, or service, is expected to perform or deliver" ;
.

cmns-rlcmp:Role
    a owl:Class ;
    rdfs:label "role" ;
    rdfs:isDefinedBy cmns-rlcmp: ;
    skos:definition "named specific behavior of something participating in a particular context" ;
.

cmns-rlcmp:hasRole
    a owl:ObjectProperty ;
    rdfs:label "has role" ;
    rdfs:isDefinedBy cmns-rlcmp: ;
    rdfs:range cmns-rlcmp:Role ;
    skos:definition "identifies something or someone playing a part in something, such as a composition" ;
.

cmns-rlcmp:isManifestedIn
    a owl:ObjectProperty ;
    rdfs:label "is manifested in" ;
    rdfs:domain cmns-rlcmp:Role ;
    rdfs:isDefinedBy cmns-rlcmp: ;
    owl:inverseOf cmns-rlcmp:manifests ;
    skos:definition "indicates something in which the role is realized, appears, or occurs" ;
.

cmns-rlcmp:isPlayedBy
    a owl:ObjectProperty ;
    rdfs:label "is played by" ;
    rdfs:domain cmns-rlcmp:Role ;
    rdfs:isDefinedBy cmns-rlcmp: ;
    owl:inverseOf cmns-rlcmp:playsRole ;
    skos:definition "indicates something or someone, such as a person, organization, or other thing filling a role" ;
.

cmns-rlcmp:isRoleIn
    a owl:ObjectProperty ;
    rdfs:label "is role in" ;
    rdfs:domain cmns-rlcmp:Role ;
    rdfs:isDefinedBy cmns-rlcmp: ;
    owl:inverseOf cmns-rlcmp:hasRole ;
    skos:definition "identifies something, such as a composition, situation, or contract, involving the role" ;
.

cmns-rlcmp:manifests
    a owl:ObjectProperty ;
    rdfs:label "manifests" ;
    rdfs:isDefinedBy cmns-rlcmp: ;
    rdfs:range cmns-rlcmp:Role ;
    skos:definition "indicates a role that realizes, displays, or shows something, typically in some context" ;
.

cmns-rlcmp:playsRole
    a owl:ObjectProperty ;
    rdfs:label "plays role" ;
    rdfs:isDefinedBy cmns-rlcmp: ;
    rdfs:range cmns-rlcmp:Role ;
    skos:definition "indicates a part that someone or something plays under some circumstance" ;
.

cmns-sfc:Facility
    a owl:Class ;
    rdfs:label "facility" ;
    rdfs:isDefinedBy cmns-sfc: ;
    skos:definition "something established to serve a particular purpose, make some course of action or operation easier, or provide some capability or service" ;
.

cmns-sfc:Site
    a owl:Class ;
    rdfs:label "site" ;
    rdfs:isDefinedBy cmns-sfc: ;
    rdfs:subClassOf cmns-cxtdsg:Context ;
    skos:definition "place, setting, or context in which something, such as a facility, is situated" ;
.

cmns-sfc:isSituatedAt
    a owl:ObjectProperty ;
    rdfs:label "is situated at" ;
    rdfs:isDefinedBy cmns-sfc: ;
    skos:definition "is placed at" ;
.

cmns-sfc:situates
    a owl:ObjectProperty ;
    rdfs:label "situates" ;
    rdfs:isDefinedBy cmns-sfc: ;
    owl:inverseOf cmns-sfc:isSituatedAt ;
    skos:definition "indicates the place, setting, or context in which something is placed" ;
.

cmns-txt:Text
    a rdfs:Datatype ;
    rdfs:label "text" ;
    dcterms:source "ISO/IEC 11179-3 Information technology - Metadata registries (MDR) - Registry metamodel and basic attributes, Third edition, 2013-02-15" ;
    rdfs:isDefinedBy cmns-txt: ;
    owl:equivalentClass
        [
            a rdfs:Datatype ;
            owl:unionOf (
                xsd:string
                rdf:langString
            ) ;
        ] ;
    skos:definition "datatype that maps to xsd:string and rdf:langString base types for string-valued data properties and annotations" ;
    skos:note
        "Text is data in the form of characters, symbols, words, phrases, paragraphs, sentences, tables, or other character arrangements, intended to convey a meaning, and whose interpretation is essentially based upon the reader's knowledge of some natural language or artificial language." ,
        "There are cases where the representation of certain features of something, such as a name, which might be multilingual or might not, defaults to rdfs:Literal when left unspecified, although it should be limited to plain strings or language-typed strings (i.e., exclude numbers, binary types, and so forth). There is no combined datatype available in RDF or OWL, however, which is the role that this datatype is intended to fulfill." ;
    skos:scopeNote "This composite datatype should be used in cases where a standard representation using one of the options in the union for string values does not work. Note that certain tools may not support rdf:langString, including, but not limited to some versions of Protege, and that custom datatypes are not supported in OWL 2 RL so it may need to be ignored or commented out in OWL 2 RL applications." ;
    cmns-av:usageNote "Commons users that depend on tools that lack support for rdf:langString may not want to use this datatype in their applications. Testing with specific reasoners, for example, is advised." ;
.

cmns-txt:hasTextValue
    a owl:DatatypeProperty ;
    rdfs:label "has text value" ;
    rdfs:isDefinedBy cmns-txt: ;
    skos:definition "provides a string value for something, with or without a language tag" ;
    idmp-dtp:isEncodedAs idmp-dtp:DatatypeCode-ST ;
.

lcc-cr:Country
    a owl:Class ;
    rdfs:label "country" ;
    rdfs:isDefinedBy lcc-cr: ;
    rdfs:subClassOf lcc-cr:GeopoliticalEntity ;
    skos:definition "geopolitical entity representing a distinct territorial body or political entity or dependent territory" ;
.

lcc-cr:GeographicRegion
    a owl:Class ;
    rdfs:label "geographic region" ;
    rdfs:isDefinedBy lcc-cr: ;
    rdfs:subClassOf lcc-cr:Region ;
    skos:definition "area of land that has common features" ;
.

lcc-cr:GeopoliticalEntity
    a owl:Class ;
    rdfs:label "geopolitical entity" ;
    rdfs:isDefinedBy lcc-cr: ;
    rdfs:subClassOf lcc-cr:GeographicRegion ;
    skos:definition "any country, federal province, city or other administrative unit that represents a geophysical location and has some political identity" ;
.

lcc-cr:Region
    a owl:Class ;
    rdfs:label "region" ;
    rdfs:isDefinedBy lcc-cr: ;
    skos:definition "area that is a continuous part of a surface, space, or body" ;
.

lcc-3166-1:Argentina
    a
        owl:NamedIndividual ,
        lcc-cr:Country ;
    rdfs:label "Argentina (la)"@es ;
    rdfs:isDefinedBy lcc-3166-1: ;
    skos:definition "the country of Argentina" ;
.

lcc-3166-1:Canada
    a
        owl:NamedIndividual ,
        lcc-cr:Country ;
    rdfs:label
        "Canada"@en ,
        "Canada (le)"@fr ;
    rdfs:isDefinedBy lcc-3166-1: ;
    skos:definition "the country of Canada" ;
.

lcc-3166-1:Chile
    a
        owl:NamedIndividual ,
        lcc-cr:Country ;
    rdfs:label "Chile"@es ;
    rdfs:isDefinedBy lcc-3166-1: ;
    skos:definition "the country of Chile" ;
.

lcc-3166-1:Denmark
    a
        owl:NamedIndividual ,
