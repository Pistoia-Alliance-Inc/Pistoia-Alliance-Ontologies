    skos:note "MeSH Unique ID finds Descriptor, Qualifier, and Supplemental Concept Records by their Record Unique Identifier." ;
    cmns-av:synonym "MeSH Unique ID" ;
.

idmp-nara:NationalCancerInstitute
    a
        owl:NamedIndividual ,
