idmp-spor:SPORControlledVocabulary
    a owl:Class ;
    rdfs:label "SPOR controlled vocabulary" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:hasValue idmp-spor:ReferentialsManagementServicesRegistry ;
            owl:onProperty cmns-col:isIncludedIn ;
        ] ,
        [
            a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass idmp-spor:SPORListName ;
            owl:onProperty cmns-dsg:isSignifiedBy ;
        ] ,
        [
            a owl:Restriction ;
            owl:onClass idmp-spor:SPORListIdentifier ;
            owl:onProperty cmns-id:isIdentifiedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        ] ,
        idmp-dtp:ControlledVocabulary ,
        cmns-cls:ClassificationScheme ,
        cmns-cds:CodeSet ;
    skos:definition "controlled vocabulary used to classify entities included in the Substances Products Organisations Referentials (SPOR) Referentials Management Services (RMS) related services and repositories" ;
    cmns-av:synonym "SPOR List" ;
.

idmp-spor:SPORControlledVocabularyTerm
    a owl:Class ;
    rdfs:label "SPOR controlled vocabulary term" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:onClass idmp-spor:SPOR-RecordStatus ;
            owl:onProperty idmp-spor:hasSPORStatus ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        ] ,
        [
            a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass idmp-spor:SPORControlledVocabulary ;
            owl:onProperty cmns-col:isIncludedIn ;
        ] ,
        [
            a owl:Restriction ;
            owl:onClass idmp-spor:SPORTermIdentifier ;
            owl:onProperty cmns-id:isIdentifiedBy ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        ] ,
        [
            a owl:Restriction ;
            owl:onClass idmp-spor:SPOR-DataClassification ;
            owl:onProperty idmp-spor:hasSPORVisibility ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        ] ,
        [
            a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass idmp-spor:SPORTermName ;
            owl:onProperty idmp-spor:hasSPOROtherName ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty idmp-spor:hasSPORTermName ;
            owl:someValuesFrom idmp-spor:SPORTermName ;
        ] ,
        [
            a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass
                [
                    a owl:Class ;
                    owl:unionOf (
                        idmp-sub:Substance
                        cmns-prd:Product
                    ) ;
                ] ;
            owl:onProperty cmns-cls:classifies ;
        ] ,
        [
            a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass
                [
                    a owl:Class ;
                    owl:unionOf (
                        idmp-sub:Substance
                        cmns-prd:Product
                    ) ;
                ] ;
            owl:onProperty cmns-dsg:denotes ;
        ] ,
        [
            a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass idmp-spor:SPORTermDescription ;
            owl:onProperty idmp-spor:hasSPORTermDescription ;
        ] ,
        [
            a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass idmp-spor:SPORTermName ;
            owl:onProperty idmp-spor:hasSPORShortName ;
        ] ,
        idmp-dtp:ISO21090-ConceptDescriptor ,
        cmns-cls:Classifier ;
    skos:definition "term in a controlled vocabulary whose values describe some substance or product from a Substances Products Organisations Referentials (SPOR) perspective" ;
    cmns-av:synonym "SPOR term" ;
.

idmp-spor:SPORListIdentifier
    a owl:Class ;
    rdfs:label "SPOR list identifier" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:hasValue idmp-spor:ReferentialsManagementServicesRegistrationScheme ;
            owl:onProperty cmns-col:compliesWith ;
        ] ,
        [
            a owl:Restriction ;
            owl:hasValue idmp-spor:ReferentialsManagementServicesRegistry ;
            owl:onProperty cmns-ra:isRegisteredIn ;
        ] ,
        cmns-ra:RegisteredIdentifier ;
    skos:definition "contextual identifier for a controlled vocabulary (list) that is registered in the Substances Products Organisations Referentials (SPOR) Referentials Management Services (RMS) registry" ;
.

idmp-spor:SPORListName
    a owl:Class ;
    rdfs:label "SPOR list name" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:hasValue idmp-spor:SubstancesProductsOrganisationsReferentialsDataManagementServices ;
            owl:onProperty cmns-cxtdsg:isApplicableIn ;
        ] ,
        [
            a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass cmns-lang:Language ;
            owl:onProperty cmns-lang:hasLanguage ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty cmns-dsg:isNameOf ;
            owl:someValuesFrom idmp-spor:SPORControlledVocabulary ;
        ] ,
        cmns-cxtdsg:ContextualName ;
    skos:definition "name for a controlled vocabulary (list) managed in the Substances Products Organisations Referentials (SPOR) Referentials Management Services (RMS) registry" ;
.

idmp-spor:SPORTermDescription
    a owl:Class ;
    rdfs:label "SPOR term description" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:hasValue idmp-spor:SubstancesProductsOrganisationsReferentialsDataManagementServices ;
            owl:onProperty cmns-cxtdsg:isApplicableIn ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty cmns-dsg:describes ;
            owl:someValuesFrom idmp-spor:SPORControlledVocabularyTerm ;
        ] ,
        [
            a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass cmns-lang:Language ;
            owl:onProperty cmns-lang:hasLanguage ;
        ] ,
        cmns-cls:Aspect ;
    skos:definition "description of a term in a controlled vocabulary (list) that is registered in the Substances Products Organisations Referentials (SPOR) Referentials Management Services (RMS) registry" ;
.

idmp-spor:SPORTermIdentifier
    a owl:Class ;
    rdfs:label "SPOR term identifier" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:hasValue idmp-spor:ReferentialsManagementServicesRegistrationScheme ;
            owl:onProperty cmns-col:compliesWith ;
        ] ,
        [
            a owl:Restriction ;
            owl:hasValue idmp-spor:ReferentialsManagementServicesRegistry ;
            owl:onProperty cmns-ra:isRegisteredIn ;
        ] ,
        cmns-ra:RegisteredIdentifier ;
    skos:definition "contextual identifier for a term in a controlled vocabulary (list) that is registered in the Substances Products Organisations Referentials (SPOR) Referentials Management Services (RMS) registry" ;
.

idmp-spor:SPORTermName
    a owl:Class ;
    rdfs:label "SPOR term name" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:minQualifiedCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onClass cmns-lang:Language ;
            owl:onProperty cmns-lang:hasLanguage ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty cmns-dsg:isNameOf ;
            owl:someValuesFrom idmp-spor:SPORControlledVocabularyTerm ;
        ] ,
        [
            a owl:Restriction ;
            owl:hasValue idmp-spor:SubstancesProductsOrganisationsReferentialsDataManagementServices ;
            owl:onProperty cmns-cxtdsg:isApplicableIn ;
        ] ,
        cmns-cxtdsg:ContextualName ;
    skos:definition "name for a term in a controlled vocabulary in Substances Products Organisations Referentials (SPOR)" ;
.

idmp-spor:SubstanceManagementServices
    a
        owl:NamedIndividual ,
        cmns-ra:RegistrationService ;
    rdfs:label "Substance Management Services (SMS)" ;
    skos:definition "services supporting a central dictionary of substance data in multiple languages" ;
    cmns-av:abbreviation "SMS service" ;
    cmns-av:directSource <https://spor.ema.europa.eu/> ;
    cmns-col:isPartOf idmp-spor:SubstancesProductsOrganisationsReferentialsDataManagementServices ;
    cmns-org:isProvidedBy idmp-eura:EuropeanMedicinesAgencyRegistrationAuthority ;
.

idmp-spor:SubstancesManagementServicesRegistry
    a
        owl:NamedIndividual ,
        cmns-ra:Registry ;
    rdfs:label "Substances Management Services registry" ;
    skos:definition "central dictionary of substance data in multiple languages available through the Substances Products Organisations Referentials (SPOR) Substances Management Services (SMS)" ;
    cmns-av:abbreviation
        "SPOR SMS" ,
        "SPOR-SMS" ;
    cmns-av:directSource <https://spor.ema.europa.eu/> ;
    cmns-av:explanatoryNote "SMS is currently live as an EMA internal system. Until it is onboarded in the SPOR portal, external users should use the following systems: view and search substance data in EUTCT or IRIS; submit substance change requests in the EMA Service Desk portal; Export of substance data are available at https://spor.ema.europa.eu/web-ui-data-backend/download/csv." ;
    cmns-org:isManagedBy idmp-eura:EuropeanMedicinesAgencyRegistrationAuthority ;
.

idmp-spor:SubstancesProductsOrganisationsReferentialsDataManagementServices
    a
        owl:NamedIndividual ,
        cmns-ra:RegistrationService ;
    rdfs:label "Substances Products Organisations Referentials (SPOR) data management services" ;
    skos:definition "data management services for substances, products, organisations and referentials (SPOR) designed to support regulatory activities in the European Union" ;
    cmns-av:abbreviation "SPOR data management services" ;
    cmns-av:directSource <https://spor.ema.europa.eu/> ;
    cmns-col:hasPart
        idmp-spor:OrganisationManagementServices ,
        idmp-spor:ProductManagementServices ,
        idmp-spor:ReferentialsManagementServices ,
        idmp-spor:SubstanceManagementServices ;
    cmns-org:isProvidedBy idmp-eura:EuropeanMedicinesAgencyRegistrationAuthority ;
.

