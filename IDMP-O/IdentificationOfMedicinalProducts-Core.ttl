lcc-lr:Alpha2LanguageCode
    a owl:Class ;
    rdfs:label "alpha-2 language code" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:LanguageIdentifier ;
    skos:definition "language identifier that is a two-letter combination of characters used to represent a language or languages" ;
.

lcc-lr:IndividualLanguage
    a owl:Class ;
    rdfs:label "individual language" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:Language ;
    skos:definition "language that can be distinguished from another language by some set of rules" ;
.

lcc-lr:Language
    a owl:Class ;
    rdfs:label "language" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf cmns-col:Arrangement ;
    skos:definition "systematic use of sounds, characters, symbols or signs to communicate meaning" ;
.

lcc-lr:LanguageIdentifier
    a owl:Class ;
    rdfs:label "language identifier" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf
        cmns-cds:CodeElement ,
        cmns-id:Identifier ;
    skos:definition "string of characters that uniquely identifies a linguistic entity" ;
    skos:prefLabel "language identifier" ;
.

lcc-lr:LanguageVariation
    a owl:Class ;
    rdfs:label "language variation" ;
    rdfs:isDefinedBy lcc-lr: ;
    skos:definition "continuous change within and between individual languages" ;
.

lcc-lr:LivingLanguage
    a owl:Class ;
    rdfs:label "living language" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:Language ;
    skos:definition "individual language or variant in use today by some speech community" ;
.

lcc-lr:Macrolanguage
    a owl:Class ;
    rdfs:label "macrolanguage" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:Language ;
    skos:definition "language that may be viewed in some circumstances as an individual language, but actually represents two or more individual languages" ;
.

[]    a owl:Axiom ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource idmp-sub:OpticalActivity ;
    owl:annotatedTarget
        [
            a owl:Restriction ;
            owl:onProperty cmns-doc:specifies ;
            owl:someValuesFrom idmp-sub:OpticalRotation ;
        ] ;
    idmp-chg:hasDataSupport false ;
.

