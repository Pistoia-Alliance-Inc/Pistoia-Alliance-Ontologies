    skos:definition "National Library of Medicine (NLM) controlled vocabulary and thesaurus used for indexing articles for PubMed" ;
    cmns-av:abbreviation "MeSH" ;
    cmns-av:directSource "https://www.ncbi.nlm.nih.gov/mesh/" ;
    cmns-dsg:hasTextualName "Medical Subject Headings" ;
    cmns-org:isManagedBy idmp-nara:NationalLibraryOfMedicineRegistrationAuthority ;
.

idmp-nara:MedicalSubjectHeadingsEntry
    a owl:Class ;
    rdfs:label "Medical Subject Headings registry entry" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:onProperty cmns-cxtdsg:appliesTo ;
            owl:someValuesFrom idmp-sub:Substance ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom idmp-nara:MedicalSubjectHeadingsUniqueIdentifier ;
        ] ,
        [
            a owl:Restriction ;
            owl:hasValue idmp-nara:MedicalSubjectHeadings ;
            owl:onProperty cmns-col:isIncludedIn ;
        ] ,
        cmns-ra:RegistryEntry ;
    skos:definition "entry in the Medical Subject Headings (MeSH) registry that includes the Medical Subject Headings Unique Identifier (MeSH Unique ID) used in electronic listing and other regulatory activities" ;
.

idmp-nara:MedicalSubjectHeadingsUniqueIdentifier
    a owl:Class ;
    rdfs:label "medical subject headings unique identifier" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:hasValue idmp-nara:NationalLibraryOfMedicineRegistrationAuthority ;
            owl:onProperty cmns-ra:hasRegistrationAuthority ;
        ] ,
        [
            a owl:Restriction ;
