        ] ,
        [
            a owl:Restriction ;
            owl:hasValue idmp-nara:NationalCancerInstituteThesaurus ;
            owl:onProperty cmns-ra:isRegisteredIn ;
        ] ,
        cmns-ra:RegisteredIdentifier ;
    skos:definition "alpha-numeric string that is used to identify records in the National Center for Biotechnology Information Taxonomy registry" ;
    cmns-av:synonym "NCI Thesaurus Code" ;
.

idmp-nara:NationalCancerInstituteThesaurusEntry
    a owl:Class ;
    rdfs:label "National Cancer Institute Thesaurus registry entry" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
