spor-r:100000000006
    a
        owl:NamedIndividual ,
        idmp-spor:SPORControlledVocabulary ;
    rdfs:label "SPOR-RMS, Medical Dictionary For Regulatory Activities Vocabulary" ;
    idmp-spor:hasSPORDomain idmp-spor:SPOR-Domain-HumanUse ;
    cmns-av:copyright "Please be informed that access to the MedDRA list is subject to the terms and conditions of the MSSO subscription policy and that any commercial use of MedDRA terminology should be authorized by the MedDRA MSSO. For more information see http://www.meddra.org/ In respect to MSSO copyright policies: • MSSO has provided MedDRA to EMA and regulatory authorities under a special free of charge license which allows them to use MedDRA in a non-downloadable format in electronic (software) tools for coding and reporting of adverse reactions in line with regulatory requirements. • MSSO has also provided MedDRA to EMA for incorporating it its terminology solution (RMS) where it can be downloaded by NCAs for the uses described above and only browsed by general public." ;
    cmns-av:directSource "MedDRA" ;
    cmns-dsg:hasName spor-r:100000000006-ListName ;
    cmns-id:isIdentifiedBy spor-r:100000000006-ListIdentifier ;
