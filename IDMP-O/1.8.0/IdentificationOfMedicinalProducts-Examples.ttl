idmp-amp:NorvascComposition
    a
        owl:NamedIndividual ,
        idmp-mprd:ProductComposition ;
    rdfs:label "Norvasc composition" ;
    skos:definition "composition of the pharmaceutical product, Norvasc, that is a besylate salt of amlodipine" ;
    skos:note "Norvasc (amlodipine besylate) Tablets are formulated as white tablets equivalent to 2.5, 5, and 10 mg of amlodipine for oral administration. In addition to the active ingredient, amlodipine besylate, each tablet contains the following inactive ingredients: microcrystalline cellulose, dibasic calcium phosphate anhydrous, sodium starch glycolate, and magnesium stearate." ;
    idmp-sub:hasIngredient
        idmp-amp:AnhydrousDibasicCalciumPhosphateAsExcipientInNorvasc ,
        idmp-amp:MagnesiumStearateAsExcipientInNorvasc ,
        idmp-amp:MicrocrystallineCelluloseAsexcipientInNorvasc ,
        idmp-amp:SodiumStarchGlycolateTypeAAsexcipientInNovasc ;
    idmp-mprd:hasActiveIngredient idmp-amp:AmlodipineBesylateAsActiveIngredientInNorvasc ;
    cmns-dsg:defines
        idmp-amp:Norvasc-ManufacturedItem-5mgTablet ,
        idmp-amp:Norvasc-PharmaceuticalProduct ;
.

