        "Crown Point Technologies" ,
        "EDM Association dba EDM Council, Inc." ,
        "European Medicines Agency (EMA)" ,
        "F. Hoffmann-La Roche Ltd" ,
        "GSK plc." ,
        "Johnson & Johnson Services, Inc." ,
        "Merck & Co., Inc." ,
        "Novartis AG" ,
        "Pfizer Inc." ,
        "PharmaLex GmbH." ,
        "Pistoia Alliance, Inc." ,
        "U.S. Food and Drug Administration (FDA)" ;
