idmp-spor:SPOR-Domain
    a owl:Class ;
    rdfs:label "SPOR domain" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:hasValue idmp-spor:SPOR-DomainVocabulary ;
            owl:onProperty cmns-col:isIncludedIn ;
        ] ,
        idmp-spor:SPORControlledVocabularyTerm ;
    skos:definition "classifier and code element that describes the domain in which a particular substance or product is used from a Substances Products Organisations Referentials (SPOR) perspective" ;
    cmns-av:adaptedFrom <https://spor.ema.europa.eu/v1/lists/100000000004> ;
.

