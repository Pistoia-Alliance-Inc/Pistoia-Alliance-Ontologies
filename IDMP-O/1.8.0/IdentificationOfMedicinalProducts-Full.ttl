    a
        owl:NamedIndividual ,
        lcc-lr:Alpha3LanguageCode ;
    rdfs:label "yid" ;
    rdfs:isDefinedBy lcc-639-2: ;
    skos:definition "Alpha-3 language code for Yiddish" ;
    cmns-col:isMemberOf lcc-639-2:ISO639-2-CodeSet ;
    cmns-id:identifies lcc-639-1:Yiddish ;
    lcc-lr:hasTag "yid" ;
.

lcc-639-2:yor
    a
        owl:NamedIndividual ,
        lcc-lr:Alpha3LanguageCode ;
    rdfs:label "yor" ;
    rdfs:isDefinedBy lcc-639-2: ;
    skos:definition "Alpha-3 language code for Yoruba" ;
    cmns-col:isMemberOf lcc-639-2:ISO639-2-CodeSet ;
    cmns-id:identifies lcc-639-1:Yoruba ;
    lcc-lr:hasTag "yor" ;
.

lcc-639-2:ypk
    a
        owl:NamedIndividual ,
        lcc-lr:Alpha3LanguageCode ;
    rdfs:label "ypk" ;
    rdfs:isDefinedBy lcc-639-2: ;
    skos:definition "Alpha-3 language code for Yupik languages" ;
    cmns-col:isMemberOf lcc-639-2:ISO639-2-CodeSet ;
    cmns-id:identifies lcc-639-2:YupikLanguages ;
    lcc-lr:hasTag "ypk" ;
.

lcc-639-2:zap
    a
        owl:NamedIndividual ,
        lcc-lr:Alpha3LanguageCode ;
    rdfs:label "zap" ;
    rdfs:isDefinedBy lcc-639-2: ;
    skos:definition "Alpha-3 language code for Zapotec" ;
    cmns-col:isMemberOf lcc-639-2:ISO639-2-CodeSet ;
    cmns-id:identifies lcc-639-2:Zapotec ;
    lcc-lr:hasTag "zap" ;
.

lcc-639-2:zbl
    a
        owl:NamedIndividual ,
        lcc-lr:Alpha3LanguageCode ;
    rdfs:label "zbl" ;
    rdfs:isDefinedBy lcc-639-2: ;
    skos:definition "Alpha-3 language code for Bliss" ;
    cmns-col:isMemberOf lcc-639-2:ISO639-2-CodeSet ;
    cmns-id:identifies lcc-639-2:Bliss ;
    lcc-lr:hasTag "zbl" ;
.

lcc-639-2:zen
    a
        owl:NamedIndividual ,
        lcc-lr:Alpha3LanguageCode ;
    rdfs:label "zen" ;
    rdfs:isDefinedBy lcc-639-2: ;
    skos:definition "Alpha-3 language code for Zenaga" ;
    cmns-col:isMemberOf lcc-639-2:ISO639-2-CodeSet ;
    cmns-id:identifies lcc-639-2:Zenaga ;
    lcc-lr:hasTag "zen" ;
.

lcc-639-2:zgh
    a
        owl:NamedIndividual ,
        lcc-lr:Alpha3LanguageCode ;
    rdfs:label "zgh" ;
    rdfs:isDefinedBy lcc-639-2: ;
    skos:definition "Alpha-3 language code for Standard Moroccan Tamazight" ;
    cmns-col:isMemberOf lcc-639-2:ISO639-2-CodeSet ;
    cmns-id:identifies lcc-639-2:StandardMoroccanTamazight ;
    lcc-lr:hasTag "zgh" ;
.

lcc-639-2:zha
    a
        owl:NamedIndividual ,
        lcc-lr:Alpha3LanguageCode ;
    rdfs:label "zha" ;
    rdfs:isDefinedBy lcc-639-2: ;
    skos:definition "Alpha-3 language code for Zhuang" ;
    cmns-col:isMemberOf lcc-639-2:ISO639-2-CodeSet ;
    cmns-id:identifies lcc-639-1:Zhuang ;
    lcc-lr:hasTag "zha" ;
.

lcc-639-2:zho
    a
        owl:NamedIndividual ,
        lcc-lr:Alpha3LanguageCode ,
        lcc-lr:TerminologyCode ;
    rdfs:label "zho" ;
    rdfs:isDefinedBy lcc-639-2: ;
    skos:definition "Alpha-3 terminologic language code for Chinese" ;
    cmns-col:isMemberOf lcc-639-2:ISO639-2-CodeSet ;
    cmns-id:identifies lcc-639-1:Chinese ;
    lcc-lr:hasTag "zho" ;
.

lcc-639-2:znd
    a
        owl:NamedIndividual ,
        lcc-lr:Alpha3LanguageCode ;
    rdfs:label "znd" ;
    rdfs:isDefinedBy lcc-639-2: ;
    skos:definition "Alpha-3 language code for Zande languages" ;
    cmns-col:isMemberOf lcc-639-2:ISO639-2-CodeSet ;
    cmns-id:identifies lcc-639-2:ZandeLanguages ;
    lcc-lr:hasTag "znd" ;
.

lcc-639-2:zul
    a
        owl:NamedIndividual ,
        lcc-lr:Alpha3LanguageCode ;
    rdfs:label "zul" ;
    rdfs:isDefinedBy lcc-639-2: ;
    skos:definition "Alpha-3 language code for Zulu" ;
    cmns-col:isMemberOf lcc-639-2:ISO639-2-CodeSet ;
    cmns-id:identifies lcc-639-1:Zulu ;
    lcc-lr:hasTag "zul" ;
.

lcc-639-2:zun
    a
        owl:NamedIndividual ,
        lcc-lr:Alpha3LanguageCode ;
    rdfs:label "zun" ;
    rdfs:isDefinedBy lcc-639-2: ;
    skos:definition "Alpha-3 language code for Zuni" ;
    cmns-col:isMemberOf lcc-639-2:ISO639-2-CodeSet ;
    cmns-id:identifies lcc-639-2:Zuni ;
    lcc-lr:hasTag "zun" ;
.

lcc-639-2:zxx
    a
        owl:NamedIndividual ,
        lcc-lr:Alpha3LanguageCode ;
    rdfs:label "zxx" ;
    rdfs:isDefinedBy lcc-639-2: ;
    skos:definition "Alpha-3 language code for No linguistic content" ;
    cmns-col:isMemberOf lcc-639-2:ISO639-2-CodeSet ;
    cmns-id:identifies lcc-639-2:NoLinguisticContent ;
    lcc-lr:hasTag "zxx" ;
.

lcc-639-2:zza
    a
        owl:NamedIndividual ,
        lcc-lr:Alpha3LanguageCode ;
    rdfs:label "zza" ;
    rdfs:isDefinedBy lcc-639-2: ;
    skos:definition "Alpha-3 language code for Zaza; Dimili; Dimli; Kirdki; Kirmanjki; Zazaki" ;
    cmns-col:isMemberOf lcc-639-2:ISO639-2-CodeSet ;
    cmns-id:identifies lcc-639-2:Zaza ;
    lcc-lr:hasTag "zza" ;
.

lcc-lr:Alpha2LanguageCode
    a owl:Class ;
    rdfs:label "alpha-2 language code" ;
    dcterms:source "Codes for the representation of names of languages - Part 1: Alpha-2 code, clause 4.1" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:LanguageIdentifier ;
    skos:definition "language identifier that is a two-letter combination of characters used to represent a language or languages" ;
    skos:note "In the ISO 639-1 language code, each language identifier is composed of two letters (lower case letters from the Latin alphabet, corresponding to characters 97 through 122 of the UTF-8 encoding), without diacritical marks or other encodings of any kind." ;
    skos:scopeNote "The identifiers are not abbreviations for the languages they identify. They are derived in some way from the indigenous language name or from preferences of the relevant speech community." ;
.

lcc-lr:Alpha3LanguageCode
    a owl:Class ;
    rdfs:label "alpha-3 language code" ;
    dcterms:source "Codes for the representation of names of languages - Part 2: Alpha-3 code, clause 3.2" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:LanguageIdentifier ;
    skos:definition "language identifier that is a three-letter combination of characters used to represent a language or languages" ;
    skos:note
        "In the ISO 639-2 language code, each language identifier is composed of three letters (lower case letters from the Latin alphabet, corresponding to characters 97 through 122 of the UTF-8 encoding), without diacritical marks or other encodings of any kind." ,
        "Two code sets are provided in ISO 639-2, one for bibliographic applications and one for terminology applications. Some of these are considered collective language codes, referring to a family of languages, and there are a few special purpose codes for use in various applications. ISO 639-3 provides a single, three character code for each individual language or macrolanguage. Additional codes for language families and groups are specified in other parts of the standard." ;
.

lcc-lr:AncientLanguage
    a owl:Class ;
    rdfs:label "ancient language" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clauses 3.25 and 4.7" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:ExtinctLanguage ;
    skos:definition "extinct language that has an attested literature and is recognized as having special status in the academic community" ;
    skos:note "Ancient languages may have either individual or collective language codes. See clause 4.1.5, ISO 639-2, for an explanation of the latter case." ;
.

lcc-lr:ArtificialLanguage
    a owl:Class ;
    rdfs:label "artificial language" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clauses 3.28 and 4.8" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:Language ;
    owl:disjointWith lcc-lr:NaturalLanguage ;
    skos:definition "language for human communication that has been artificially devised" ;
    skos:note "Artificial languages do not include reconstructed languages or computer programming languages." ;
.

lcc-lr:BibliographicCode
    a owl:Class ;
    rdfs:label "bibliographic code" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:Alpha3LanguageCode ;
    skos:definition "alpha-3 code that is a member of the set of bibliographic codes specified in ISO 639-2" ;
.

lcc-lr:CollectiveLanguageCode
    a owl:Class ;
    rdfs:label "collective language code" ;
    dcterms:source
        "Codes for the representation of names of languages - Part 2: Alpha-3 code, clauses 3.3 and 4.1.1" ,
        "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 4.6" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:allValuesFrom lcc-lr:LanguageGroup ;
            owl:onProperty cmns-id:identifies ;
        ] ,
        lcc-lr:LanguageIdentifier ;
    owl:disjointWith lcc-lr:SpecialPurposeCode ;
    skos:definition "language identifier or code used to represent a group of languages" ;
    skos:note "See clause 4.1.1, ISO 639-2, for an explanation of the usage of such codes, and clause 4.1.3 to gain understanding of the distinction between collective language and macrolanguage codes." ;
.

lcc-lr:Dialect
    a owl:Class ;
    rdfs:label "dialect" ;
    dcterms:source
        "Codes for the representation of names of languages - Part 2: Alpha-3 code, clauses 4.1.3 and 4.1.4" ,
        "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clauses 3.8, 4.2, and 4.5" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:LanguageVariant ;
    skos:definition "language variant that is specific to a geographical region or speech community" ;
    skos:note "Dialects are typically represented via the same language code as the code for the primary language, with a few exceptions for well-known dialects. See clauses 4.1.3 and 4.1.4, ISO 639-2 for additional details on the treatment of dialects in the standard." ;
.

lcc-lr:ExtinctLanguage
    a owl:Class ;
    rdfs:label "extinct language" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clauses 3.24 and 4.7" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:Language ;
    owl:disjointWith lcc-lr:LivingLanguage ;
    skos:definition "individual language or variant that is no longer in use and has no current descendant" ;
.

lcc-lr:HistoricalLanguage
    a owl:Class ;
    rdfs:label "historical language" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clauses 3.26 and 4.7" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:Language ;
    skos:definition "well-known prior version of a living or extinct language" ;
.

lcc-lr:IndividualLanguage
    a owl:Class ;
    rdfs:label "individual language" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.7" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:Language ;
    skos:definition "language that can be distinguished from another language by some set of rules" ;
    skos:note "Identifiers in Parts 1, 2, and 3 of ISO 639 are assumed to denote distinct individual languages, unless the language name explicitly refers to a language group. See clause 4.2 in ISO 639-4 for a detailed explanation of the definition of individual language in the context of the ISO 639 standard." ;
.

lcc-lr:IndividualLanguageIdentifier
    a owl:Class ;
    rdfs:label "individual language identifier" ;
    dcterms:source "Codes for the representation of names of languages - Part 3: Alpha-3 code for comprehensive coverage of languages, clause 3.7" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:allValuesFrom lcc-lr:IndividualLanguage ;
            owl:onProperty cmns-id:identifies ;
        ] ,
        lcc-lr:LanguageIdentifier ;
    owl:disjointWith lcc-lr:MacrolanguageIdentifier ;
    skos:definition "language identifier whose scope is that of an individual (distinct) language" ;
.

lcc-lr:Language
    a owl:Class ;
    rdfs:label "language" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.6" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty lcc-lr:hasGermanName ;
        ] ,
        [
            a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty lcc-lr:hasIndigenousName ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty lcc-lr:hasEnglishName ;
            owl:someValuesFrom rdfs:Literal ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty lcc-lr:hasFrenchName ;
            owl:someValuesFrom rdfs:Literal ;
        ] ,
        cmns-col:Arrangement ;
    skos:definition "systematic use of sounds, characters, symbols or signs to communicate meaning" ;
.

lcc-lr:LanguageFamily
    a owl:Class ;
    rdfs:label "language family" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.11" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:LanguageGroup ;
    skos:definition "group of individual languages related to each other through common ancestry" ;
.

lcc-lr:LanguageGroup
    a owl:Class ;
    rdfs:label "language group" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.10" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:allValuesFrom lcc-lr:IndividualLanguage ;
            owl:onProperty cmns-col:comprises ;
        ] ,
        cmns-col:Collection ;
    skos:definition "collection of two or more individual languages, treated as a group for some purpose" ;
    skos:note "See clause 4.6 in ISO 639-4 for additional explanatory material for language groups." ;
.

lcc-lr:LanguageIdentifier
    a owl:Class ;
    rdfs:label "language identifier" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.5" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:onProperty cmns-id:identifies ;
            owl:someValuesFrom lcc-lr:Language ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty lcc-lr:hasTag ;
            owl:someValuesFrom xsd:string ;
        ] ,
        cmns-cds:CodeElement ,
        cmns-id:Identifier ;
    skos:definition "string of characters that uniquely identifies a linguistic entity" ;
    skos:prefLabel "language identifier" ;
    skos:scopeNote "In the language codes of Parts 1, 2, 3, and 5 of ISO 639, each language identifier is composed of two or three letters." ;
    cmns-av:synonym "language symbol" ;
.

lcc-lr:LanguageVariant
    a owl:Class ;
    rdfs:label "language variant" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.14" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:IndividualLanguage ;
    skos:definition "variation of an individual language that is sufficiently unique that it can be identified and named" ;
.

lcc-lr:LanguageVariation
    a owl:Class ;
    rdfs:label "language variation" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.13" ;
    rdfs:isDefinedBy lcc-lr: ;
    skos:definition "continuous change within and between individual languages" ;
    skos:note "Language variation may include change over time, space, cultural affiliation, etc." ;
.

lcc-lr:LivingLanguage
    a owl:Class ;
    rdfs:label "living language" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.23" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:Language ;
    skos:definition "individual language or variant in use today by some speech community" ;
.

lcc-lr:Macrolanguage
    a owl:Class ;
    rdfs:label "macrolanguage" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.9" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:Language ;
    skos:definition "language that may be viewed in some circumstances as an individual language, but actually represents two or more individual languages" ;
    skos:note "See clauses 4.1 and 4.3 of ISO 639-4 for an extensive description of macrolanguages and how they are different from language groups." ;
.

lcc-lr:MacrolanguageIdentifier
    a owl:Class ;
    rdfs:label "macrolanguage identifier" ;
    dcterms:source "Codes for the representation of names of languages - Part 3: Alpha-3 code for comprehensive coverage of languages, clause 3.7" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:allValuesFrom lcc-lr:Macrolanguage ;
            owl:onProperty cmns-id:identifies ;
        ] ,
        lcc-lr:LanguageIdentifier ;
    owl:disjointWith lcc-lr:SpecialPurposeCode ;
    skos:definition "language identifier whose scope is that of a macrolanguage" ;
.

lcc-lr:NaturalLanguage
    a owl:Class ;
    rdfs:label "natural language" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.27" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:Language ;
    skos:definition "language used in human communications that is not artificial in nature" ;
.

lcc-lr:Orthography
    a owl:Class ;
    rdfs:label "orthography" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.27" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf cmns-col:Collection ;
    skos:definition "set of conventions and rules for representing language in written form" ;
    skos:note "The orthographic rules for a given language may include rules of spelling, hyphenation, capitalization, word breaks, emphasis, and punctuation. Languages that have multiple writing systems may have distinct orthographies and scripts." ;
.

lcc-lr:RemainderGroup
    a owl:Class ;
    rdfs:label "remainder group" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.12" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:LanguageGroup ;
    skos:definition "group of languages that explicitly excludes certain individual languages" ;
.

lcc-lr:Script
    a owl:Class ;
    rdfs:label "script" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.17" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf cmns-col:Collection ;
    skos:definition "set of graphic characters used to represent one or more languages in writing" ;
    skos:note "Use of multiple writing systems does not mean that multiple language identifiers are necessary for a language. ISO 639 language identifiers may be combined with script identifiers from ISO 15924 (e.g., BCP 47)." ;
.

lcc-lr:SpecialPurposeCode
    a owl:Class ;
    rdfs:label "special purpose code" ;
    dcterms:source "Codes for the representation of names of languages - Part 3: Alpha-3 code for comprehensive coverage of languages, clause 3.7" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:allValuesFrom lcc-lr:SpecialPurposeLanguageConcept ;
            owl:onProperty cmns-id:identifies ;
        ] ,
        lcc-lr:LanguageIdentifier ;
    skos:definition "language identifier whose scope is that of a special purpose language construct" ;
.

lcc-lr:SpecialPurposeLanguageConcept
    a owl:Class ;
    rdfs:label "special purpose language concept" ;
    dcterms:source "Codes for the representation of names of languages - Part 3: Alpha-3 code for comprehensive coverage of languages, clause 4.2.6" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:Language ;
    skos:definition "language concept introduced in ISO 639-3 to satisfy special-purpose requirements, typically to support application constraints" ;
.

lcc-lr:SpokenLanguage
    a owl:Class ;
    rdfs:label "spoken language" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.22" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:Language ;
    skos:definition "individual language or language variant that is articulated through speech (oral or vocal) sounds" ;
.

lcc-lr:StandardVariant
    a owl:Class ;
    rdfs:label "standard variant" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.15" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:LanguageVariant ;
    skos:definition "language variant with a high degree of status and normalization, typically used in public discourse, centers of government and commerce" ;
.

lcc-lr:TerminologyCode
    a owl:Class ;
    rdfs:label "terminology code" ;
    dcterms:source "Codes for the representation of names of languages - Part 3: Alpha-3 code for comprehensive coverage of languages, clause 3.7" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf lcc-lr:Alpha3LanguageCode ;
    skos:definition "language identifier whose scope is that of terminological codes" ;
.

lcc-lr:Transcription
    a owl:Class ;
    rdfs:label "transcription" ;
    dcterms:source
        "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.19" ,
        "ISO 1087 Terminology work and terminology science - Vocabulary, Second edition, 2019-09, clauses 3.4.37" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:onProperty cmns-cxtdsg:uses ;
            owl:someValuesFrom lcc-lr:WritingSystem ;
        ] ,
        cmns-col:Arrangement ;
    skos:definition "the representation of speech or signing in written form" ;
    skos:note
        "From a terminology perspective, transscription is a method for the formation of designations in which the script of a natural language is used to represent the sounds of another natural language." ,
        "The resulting text is also referred to as a transcription." ;
.

lcc-lr:Transliteration
    a owl:Class ;
    rdfs:label "transliteration" ;
    dcterms:source
        "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.20" ,
        "ISO 1087 Terminology work and terminology science - Vocabulary, Second edition, 2019-09, clauses 3.4.36" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:onProperty cmns-cxtdsg:uses ;
            owl:someValuesFrom lcc-lr:Script ;
        ] ,
        cmns-col:Arrangement ;
    skos:definition "the conversion of text from one script to another without loss of information" ;
    skos:note
        "From a terminology perspective, transliteration is a method for the formation of designations in which a designation results from a one-to-one conversion of one script into another." ,
        "The resulting text is also referred to as a transliteration." ,
        "Transliteration makes use of bidirectional correspondence between the characters of the two involved scripts and allows reconstruction of the original script without any loss of information about graphic characters." ;
.

lcc-lr:WritingSystem
    a owl:Class ;
    rdfs:label "writing system" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.16" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom lcc-lr:Orthography ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty cmns-cxtdsg:isUsedBy ;
            owl:someValuesFrom lcc-lr:Language ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom lcc-lr:Script ;
        ] ,
        cmns-col:Arrangement ;
    skos:definition "system for writing a language, including the requisite script and character set" ;
.

lcc-lr:WrittenLanguage
    a owl:Class ;
    rdfs:label "written language" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.21" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:onProperty cmns-cxtdsg:uses ;
            owl:someValuesFrom lcc-lr:Orthography ;
        ] ,
        lcc-lr:Language ;
    skos:definition "the representation of a language via a writing system, with a relatively normalized orthography" ;
.

lcc-lr:hasEarlierForm
    a owl:ObjectProperty ;
    rdfs:label "has earlier form" ;
    rdfs:domain lcc-lr:Language ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:range lcc-lr:Language ;
    rdfs:subPropertyOf cmns-doc:refersTo ;
    skos:definition "relates a language to an earlier form (historically significant) of that same language" ;
.

lcc-lr:hasEnglishName
    a owl:DatatypeProperty ;
    rdfs:label "has English name" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.4" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subPropertyOf lcc-lr:hasTextualName ;
    skos:definition "associates a name in English with an individual concept" ;
.

lcc-lr:hasFrenchName
    a owl:DatatypeProperty ;
    rdfs:label "has French name" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.4" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subPropertyOf lcc-lr:hasTextualName ;
    skos:definition "associates a name in French with an individual concept" ;
.

lcc-lr:hasGermanName
    a owl:DatatypeProperty ;
    rdfs:label "has German name" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subPropertyOf lcc-lr:hasTextualName ;
    skos:definition "associates a name in German with an individual concept" ;
.

lcc-lr:hasIndigenousName
    a owl:DatatypeProperty ;
    rdfs:label "has indigenous name" ;
    dcterms:source "Codes for the representation of names of languages - Part 4: General principles of coding of the representation of names of languages and related entities, and application guidelines, clause 3.4" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subPropertyOf lcc-lr:hasTextualName ;
    skos:definition "associates a local regional or cultural name with an individual concept" ;
.

lcc-lr:hasTag
    a owl:DatatypeProperty ;
    rdfs:label "has tag" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cmns-txt:hasTextValue ;
    skos:definition "associates unique combination of alphanumeric characters corresponding to a designator for something" ;
    skos:note "Text-valued tags are included here as they may be useful for automated transformation or encoding systems, such as those used to produce IETF compliant language tags in XML." ;
.

lcc-lr:hasTextualName
    a owl:DatatypeProperty ;
    rdfs:label "has textual name" ;
    dcterms:source "Codes for the representation of names of languages - Part 3: Alpha-3 code for comprehensive coverage of languages, clause 3.4" ;
    rdfs:isDefinedBy lcc-lr: ;
    rdfs:subPropertyOf cmns-txt:hasTextValue ;
    skos:definition "associates a name, reference name, or appellation with an individual concept" ;
    skos:note "Note that the hasName properties defined herein have an implicit range of rdfs:Literal. This is purposeful, so that users can specify any element that has a name with or without a language tag without concern for conflicting datatypes (i.e., xsd:string vs. rdf:langString, which are logically disjoint)." ;
.

