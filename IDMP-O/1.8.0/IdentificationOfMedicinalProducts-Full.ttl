    dcterms:title "Identification of Medicinal Products Ontology (IDMP-O) Full" ;
    owl:versionIRI <https://spec.pistoiaalliance.org/idmp/ontology/2026-10-10/IdentificationOfMedicinalProducts-Full/> ;
    owl:versionInfo "v1.8.0" ;
    idmp-chg:hasMaturityLevel idmp-chg:Release ;
    cmns-av:abbreviation "idmp-full" ;
    cmns-av:explanatoryNote "Note that this ontology represents an abridged, merged version of the individual released ontologies developed over the course of the project, and does not fully support some constructs of the IDMP standards. Users may contact Pistoia Alliance, at https://www.pistoiaalliance.org/, for membership information and access to the complete ontology, including reference data, controlled vocabularies, examples, and documentation." ;
    cmns-av:usageNote "This IDMP-O artifact, v1.8.0, is planned for release on 2026-10-10 and is freely available via GitHub under the MIT license, https://opensource.org/licenses/MIT. The Full artifact merges the released IDMP-O modules and the full external modules they depend on into one self contained file. Only external modules without a local copy are imported." ;
.

idmp-chg:Informative
    a
        owl:NamedIndividual ,
        idmp-chg:MaturityLevel ;
    rdfs:label "informative" ;
    skos:definition "entity that demonstrates how to use some elements of the ontology"@en ;
    cmns-av:explanatoryNote "Informative content includes examples that are useful but should not be incorporated in any application. They have been created to support testing and provide guidance to users with respect to how to implement certain constructs."@en ;
.

idmp-chg:MaturityLevel
    a owl:Class ;
    rdfs:label "maturity level" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf cmns-cls:Classifier ;
    skos:definition "classifier used to indicate the state of an artifact with respect to the IDMP data management and governance lifecycle" ;
.

idmp-chg:Module
    a owl:Class ;
    rdfs:label "module" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf cmns-col:Collection ;
    skos:definition "separable component of something else, organized by topic or functional area"@en ;
    skos:note """Modularization of any engineering model, including a large ontology, involves principles of the model driven architecture methodology (MDA), such as separation of concerns, coherence, and establishing clear logical boundaries in order to increase reusability and maintainability.

A module should be designed to reflect these principles, including a small number of models that have well-defined relationships with one another, that form a coherent and cohesive whole for some purpose, and that have clear boundaries or interfaces to other external modules."""@en ;
.

idmp-chg:Preliminary
    a
        owl:NamedIndividual ,
        idmp-chg:MaturityLevel ;
    rdfs:label "preliminary" ;
    skos:definition "entity that is considered to be in early stages of development"@en ;
    cmns-av:explanatoryNote "Preliminary content is subject to significant change, and may be renamed or moved to another ontology prior to achieving provisional status. Users should be aware that it is not dependable, but could be used for reference and as the basis for further work."@en ;
.

idmp-chg:Provisional
    a
        owl:NamedIndividual ,
        idmp-chg:MaturityLevel ;
    rdfs:label "provisional" ;
    skos:definition "entity that is considered to be in later stages of development"@en ;
    cmns-av:explanatoryNote "Provisional content may change prior to release but is more stable and reliable than preliminary content."@en ;
.

idmp-chg:Release
    a
        owl:NamedIndividual ,
        idmp-chg:MaturityLevel ;
    rdfs:label "release" ;
    skos:definition "entity that is considered to be stable and mature from a development perspective"@en ;
    cmns-av:explanatoryNote "Release notes will be provided for any changes with respect to released content, and any revisions will be backwards compatible with the prior version to the degree possible."@en ;
.

idmp-chg:hasDataSupport
    a owl:AnnotationProperty ;
    rdfs:label "has data support"@en ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:range xsd:boolean ;
    skos:definition "indicates that a given constraint may be used to validate instance data"@en ;
    cmns-av:explanatoryNote "The default value is true."@en ;
.

idmp-chg:hasMaturityLevel
    a owl:AnnotationProperty ;
    rdfs:label "has maturity level" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    skos:definition "links something to its state with respect to a development lifecycle" ;
.

idmp-cmpl:ConformanceToISOLevel
    a owl:Class ;
    rdfs:label "conformance to ISO level" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf cmns-cls:Classifier ;
    skos:definition "classifier used to indicate the representational conformance of element with respect to the ISO IDMP standard(s) it is derived from" ;
.

idmp-cmpl:ConformanceToISOLevel-Conformant
    a
        owl:NamedIndividual ,
        idmp-cmpl:ConformanceToISOLevel ;
    rdfs:label "conformance to ISO level - conformant" ;
    skos:definition "compliance level indicating that the ontology element is conformant with the corresponding ISO class, property, datatype, or other individual, including but not limited to the way it is modeled, its naming, annotations, and relationships"@en ;
.

idmp-cmpl:ConformanceToISOLevel-DefinitionallyConformant
    a
        owl:NamedIndividual ,
        idmp-cmpl:ConformanceToISOLevel ;
    rdfs:label "conformance to ISO level - definitionally conformant" ;
    skos:definition "compliance level indicating that the ontology element is conformant with the corresponding ISO class, property, datatype, or other individual with respect to its definition and other annotations, but may not be conformant with respect to how it is named or otherwise modeled"@en ;
    cmns-av:explanatoryNote "Definitionally conformant elements will have annotations corresponding to what is in the ISO IDMP standard but be named and modeled differently. Examples include elements that are modeled as classes in the IDMP standard but as properties in the ontology, so the name has been rephrased as a verb or verb phrase."@en ;
.

idmp-cmpl:ConformanceToISOLevel-Extension
    a
        owl:NamedIndividual ,
        idmp-cmpl:ConformanceToISOLevel ;
    rdfs:label "conformance to ISO level - extension" ;
    skos:definition "compliance level indicating that the ontology element extends the existing ISO standard with a concept that is either implied by the specification or fills a gap that was not addressed in the standard"@en ;
.

idmp-cmpl:ConformanceToISOLevel-ModelConformant
    a
        owl:NamedIndividual ,
        idmp-cmpl:ConformanceToISOLevel ;
    rdfs:label "conformance to ISO level - model conformant" ;
    skos:definition "compliance level indicating that the ontology element is conformant with the corresponding ISO class, property, datatype, or other individual with respect to how it is modeled, but not necessarily with respect to all of its relationships"@en ;
    cmns-av:explanatoryNote "There are various cases in the ontologies where a given element will be modeled as a text value with some ISO 21090 Harmonized Datatype encoding, whereas we have modeled it as a named individual with additional semantics in the ontology. A class that in other aspects is modeled as defined in the relevant ISO IDMP specifications that has a relationships with this individual rather than having a text attribute for it would be considered model conformant."@en ;
.

idmp-cmpl:ConformanceToISOLevel-NameAndAnnotationConformant
    a
        owl:NamedIndividual ,
        idmp-cmpl:ConformanceToISOLevel ;
    rdfs:label "conformance to ISO level - name and annotation conformant" ;
    skos:definition "compliance level indicating that the ontology element is conformant with the corresponding ISO class, property, datatype, or other individual with respect to its name, definition and other annotations, but may not be conformant with respect to how it is modeled"@en ;
    cmns-av:explanatoryNote "There are various cases in the ontologies where a given element will be modeled as a class, similarly to what is in the ISO IDMP standard, but whose relationships are specified differently. This may be because of inheritance via the patterns we have implemented, the use of restrictions, or other variations with respect to the modeling approach taken. Other cases include concepts that are modeled as roles in the ontology but as classes or properties in the IDMP standard."@en ;
.

idmp-cmpl:ConformanceToISOLevel-NamingConformant
    a
        owl:NamedIndividual ,
        idmp-cmpl:ConformanceToISOLevel ;
    rdfs:label "conformance to ISO level - naming conformant" ;
    skos:definition "compliance level indicating that the ontology element is conformant with the corresponding ISO class, property, datatype, or other individual with respect to its name, and possibly other annotations, but not in terms of its definition or with respect to how it is modeled"@en ;
    cmns-av:explanatoryNote "One such case identified shortly after the initial 0.1 version of the ontology was released is the concept 'ingredient', which is modeled as a role rather than as a subclass of material and where the definition in ISO 11238 is distinct from the definition in the ontology."@en ;
.

idmp-cmpl:ConformanceToISOLevel-NeedsClarification
    a
        owl:NamedIndividual ,
        idmp-cmpl:ConformanceToISOLevel ;
    rdfs:label "conformance to ISO level - needs clarification" ;
    skos:definition "compliance level indicating that the ontology element is conformant with the ISO standard but indicates that the standard should be revised in some fashion for clarification purposes"@en ;
    cmns-av:explanatoryNote "In this case, a usage note should accompany this annotation to say what exactly needs clarification."@en ;
.

idmp-cmpl:ConformanceToISOLevel-NonConformant
    a
        owl:NamedIndividual ,
        idmp-cmpl:ConformanceToISOLevel ;
    rdfs:label "conformance to ISO level - non-conformant" ;
    skos:definition "compliance level indicating that the ontology element is not conformant with the corresponding ISO class, property, datatype, or other individual"@en ;
    cmns-av:explanatoryNote "This annotation should be used when the ontology necessarily differs from the standard in some way due to an inconsistency that would be introduced if it was modeled explicitly as indicated in the UML model, for example. In this case a usage note should be included to state why we believe that the element should be modeled differently."@en ;
.

idmp-cmpl:hasConformanceToISOLevel
    a owl:AnnotationProperty ;
    rdfs:label "has conformance to ISO level" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    skos:definition "links something to its representational compliance with respect to the ISO IDMP standard(s) it is derived from" ;
.

idmp-doco:FigureCaption
    a owl:Class ;
    rdfs:label "figure caption" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:allValuesFrom doco:Figure ;
            owl:onProperty
                [
                    owl:inverseOf idmp-doco:hasCaption ;
                ] ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty
                [
                    owl:inverseOf idmp-doco:hasCaption ;
                ] ;
            owl:someValuesFrom doco:Figure ;
        ] ,
        deo:Caption ,
        po:Block ;
    skos:definition "title or brief explanation appended to a figure" ;
.

idmp-doco:TableBodyCell
    a owl:Class ;
    rdfs:label "table body cell" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf idmp-doco:TableCell ;
    owl:disjointWith
        idmp-doco:TableColumnHeaderCell ,
        idmp-doco:TableRowHeaderCell ;
    skos:definition "table cell that is not a row or column header" ;
    cmns-av:synonym
        "body cell" ,
        "inner cell" ;
.

idmp-doco:TableCaption
    a owl:Class ;
    rdfs:label "table caption" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:allValuesFrom doco:Table ;
            owl:onProperty
                [
                    owl:inverseOf idmp-doco:hasCaption ;
                ] ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty
                [
                    owl:inverseOf idmp-doco:hasCaption ;
                ] ;
            owl:someValuesFrom doco:Table ;
        ] ,
        deo:Caption ,
        po:Block ;
    skos:definition "title or brief explanation on a table" ;
.

idmp-doco:TableCell
    a owl:Class ;
    rdfs:label "table cell" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:onProperty
                [
                    owl:inverseOf po:contains ;
                ] ;
            owl:someValuesFrom doco:Table ;
        ] ,
        po:Block ;
    skos:definition "element in a table that is arranged in a tabular layout, and that is part of a table row, a table column or both" ;
    skos:note "This is similar to the HTML td element." ;
.

idmp-doco:TableColumn
    a owl:Class ;
    rdfs:label "table column" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:onProperty
                [
                    owl:inverseOf po:contains ;
                ] ;
            owl:someValuesFrom doco:Table ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom idmp-doco:TableCell ;
            owl:onProperty po:contains ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom doco:Table ;
            owl:onProperty
                [
                    owl:inverseOf po:contains ;
                ] ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom idmp-doco:TableColumnHeaderCell ;
            owl:onProperty po:containsAsHeader ;
        ] ,
        po:HeadedContainer ,
        cmns-col:Collection ;
    skos:definition "single vertical arrangement of table cells in a table" ;
    cmns-av:synonym "column" ;
.

idmp-doco:TableColumnHeaderCell
    a owl:Class ;
    rdfs:label "table column header cell" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf idmp-doco:TableCell ;
    owl:disjointWith idmp-doco:TableRowHeaderCell ;
    skos:definition "table cell that is a header for the table column" ;
    cmns-av:synonym "column header" ;
.

idmp-doco:TableRow
    a owl:Class ;
    rdfs:label "table row" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:allValuesFrom idmp-doco:TableCell ;
            owl:onProperty po:contains ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom idmp-doco:TableRowHeaderCell ;
            owl:onProperty po:containsAsHeader ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty
                [
                    owl:inverseOf po:contains ;
                ] ;
            owl:someValuesFrom doco:Table ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom doco:Table ;
            owl:onProperty
                [
                    owl:inverseOf po:contains ;
                ] ;
        ] ,
        po:HeadedContainer ,
        cmns-col:Collection ;
    skos:definition "single horizontal arrangement of table cells in a table" ;
    cmns-av:synonym "row" ;
.

idmp-doco:TableRowHeaderCell
    a owl:Class ;
    rdfs:label "table row header cell" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf idmp-doco:TableCell ;
    skos:definition "table cell that is a header for the table row" ;
    cmns-av:synonym "row header" ;
.

idmp-doco:containsText
    a owl:DatatypeProperty ;
    rdfs:label "contains text" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:domain po:Textual ;
    rdfs:subPropertyOf cmns-txt:hasTextValue ;
    skos:definition "relates a textual element to a part of its literal text" ;
.

idmp-doco:hasCaption
    a owl:ObjectProperty ;
    rdfs:label "has caption" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:range deo:Caption ;
    rdfs:subPropertyOf cmns-doc:refersTo ;
    skos:definition "relates a document element to a caption on it" ;
.

idmp-doco:hasExactText
    a owl:DatatypeProperty ;
    rdfs:label "has exact text" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:domain po:Textual ;
    rdfs:subPropertyOf cmns-txt:hasTextValue ;
    skos:definition "relates a textual element to its precise literal text" ;
.

idmp-doco:hasTableColumnIndex
    a owl:DatatypeProperty ;
    rdfs:label "has table column index" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:domain
        [
            a owl:Class ;
            owl:unionOf (
                idmp-doco:TableBodyCell
                idmp-doco:TableColumnHeaderCell
                idmp-doco:TableColumn
            ) ;
        ] ;
    rdfs:range xsd:positiveInteger ;
    rdfs:subPropertyOf idmp-dtp:hasIntegerValue ;
    skos:definition "horizontal position of a table body cell or table column header cell" ;
    skos:note "Column indexes start with 1 and are ordered left to right, with header cells first. Both header and body cells are counted with respect to the index, so if there is a single row header column then the leftmost body cell has a column index of 2." ;
    cmns-av:synonym "has table column index" ;
.

idmp-doco:hasTableColumnSpan
    a owl:DatatypeProperty ;
    rdfs:label "has table column span" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:domain
        [
            a owl:Class ;
            owl:unionOf (
                idmp-doco:TableBodyCell
                idmp-doco:TableRowHeaderCell
            ) ;
        ] ;
    rdfs:range xsd:positiveInteger ;
    rdfs:subPropertyOf idmp-dtp:hasIntegerValue ;
    skos:definition "number of columns the table cell should span" ;
    skos:note
        "The column span is counted beginning with and is including the left most column." ,
        "This is similar to the HTML colspan attribute." ;
    cmns-av:synonym "has table column span" ;
.

idmp-doco:hasTableRowIndex
    a owl:DatatypeProperty ;
    rdfs:label "has table row index" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:domain
        [
            a owl:Class ;
            owl:unionOf (
                idmp-doco:TableBodyCell
                idmp-doco:TableRowHeaderCell
                idmp-doco:TableRow
            ) ;
        ] ;
    rdfs:range xsd:positiveInteger ;
    rdfs:subPropertyOf idmp-dtp:hasIntegerValue ;
    skos:definition "vertical position of a table body cell or table row header cell" ;
    skos:note "Row indexes start with 1 and are ordered top to bottom with header cells first. Both header and body cells are counted with respect to the index, so if there is a single header row, then the topmost body cells has a row index of 2." ;
.

idmp-doco:hasTableRowSpan
    a owl:DatatypeProperty ;
    rdfs:label "has table row span" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:domain
        [
            a owl:Class ;
            owl:unionOf (
                idmp-doco:TableBodyCell
                idmp-doco:TableRowHeaderCell
            ) ;
        ] ;
    rdfs:range xsd:positiveInteger ;
    rdfs:subPropertyOf idmp-dtp:hasIntegerValue ;
    skos:definition "number of rows the table cell should span" ;
    skos:note
        "The row span is counted beginning with and is including the top most row." ,
        "This is similar to the HTML rowspan attribute." ;
.

idmp-doco:hasTextualContent
    a owl:DatatypeProperty ;
    rdfs:label "has textual content" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subPropertyOf cmns-txt:hasTextValue ;
    skos:definition "relates a document element to its textual content" ;
    cmns-av:usageNote "If the element contains mixed content, then the text may be different from the literal text value." ;
.

idmp-sex:ISO5218-Female
    a
        owl:NamedIndividual ,
        idmp-sex:ISO5218-HumanSex ;
    rdfs:label "ISO 5218 - Female" ;
    skos:definition "concept descriptor indicating that the human sex is female" ;
    skos:note "this concept is a classifier for humans based on their sex being female" ;
    idmp-dtp:hasDisplayName "Female" ;
    cmns-dsg:hasName idmp-sex:ISO5218-Female-Name ;
    cmns-txt:hasTextValue "2" ;
.

idmp-sex:ISO5218-Female-Name
    a
        owl:NamedIndividual ,
        idmp-sex:ISO5218-HumanSexName ;
    rdfs:label "ISO 5218 - Female - name" ;
    idmp-dtp:isPreferred true ;
    cmns-dsg:hasTextualName "Female" ;
    cmns-dsg:isNameOf idmp-sex:ISO5218-Female ;
.

idmp-sex:ISO5218-HumanSex
    a owl:Class ;
    rdfs:label "ISO 5218 - human sex" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:hasValue idmp-sex:ISO5218-HumanSexVocabulary ;
            owl:onProperty cmns-col:isIncludedIn ;
        ] ,
        idmp-dtp:ISO21090-ConceptDescriptor ,
        cmns-cls:Classifier ;
    owl:equivalentClass
        [
            a owl:Class ;
            owl:oneOf (
                idmp-sex:ISO5218-Female
                idmp-sex:ISO5218-Male
                idmp-sex:ISO5218-NotApplicable
                idmp-sex:ISO5218-NotKnown
            ) ;
        ] ;
    skos:definition "concept descriptor and code for the classification of human sex or the availability of information about it" ;
    skos:note "Human sex is represented by a one-character numeric code." ;
    cmns-av:adaptedFrom "ISO/IEC 5218 - Information technology - Codes for the representation of human sexes, Second edition, 2022-06, clause 4" ;
.

idmp-sex:ISO5218-HumanSexName
    a owl:Class ;
    rdfs:label "ISO 5218 - human sex name" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:hasValue idmp-sex:ISO5218-HumanSexVocabulary ;
            owl:onProperty cmns-col:isIncludedIn ;
        ] ,
        [
            a owl:Restriction ;
            owl:onClass idmp-sex:ISO5218-HumanSex ;
            owl:onProperty cmns-dsg:isNameOf ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        ] ,
        cmns-cxtdsg:ContextualName ;
    skos:definition "concept descriptor name for the classification of human sex or the availability of information about it" ;
    cmns-av:adaptedFrom "ISO/IEC 5218 - Information technology - Codes for the representation of human sexes, Second edition, 2022-06, clause 4" ;
.

idmp-sex:ISO5218-HumanSexVocabulary
    a
        owl:NamedIndividual ,
        idmp-dtp:ControlledVocabulary ,
        cmns-cls:ClassificationScheme ,
        cmns-cds:CodeSet ;
    rdfs:label "ISO 5218 human sex vocabulary" ;
    skos:definition "controlled vocabulary defining codes for the representation fo human sex according to ISO 5218 standard" ;
    cmns-av:adaptedFrom "ISO/IEC 5218 - Information technology - Codes for the representation of human sexes, Second edition, 2022-06, clause 4" ;
.

idmp-sex:ISO5218-Male
    a
        owl:NamedIndividual ,
        idmp-sex:ISO5218-HumanSex ;
    rdfs:label "ISO 5218 - Male" ;
    skos:definition "concept descriptor indicating that the human sex is male" ;
    idmp-dtp:hasDisplayName "Male" ;
    cmns-dsg:hasName idmp-sex:ISO5218-Male-Name ;
    cmns-txt:hasTextValue "1" ;
.

idmp-sex:ISO5218-Male-Name
    a
        owl:NamedIndividual ,
        idmp-sex:ISO5218-HumanSexName ;
    rdfs:label "ISO 5218 - Male name" ;
    idmp-dtp:isPreferred true ;
    cmns-dsg:hasTextualName "Male" ;
    cmns-dsg:isNameOf idmp-sex:ISO5218-Male ;
.

idmp-sex:ISO5218-NotApplicable
    a
        owl:NamedIndividual ,
        idmp-sex:ISO5218-HumanSex ;
    rdfs:label "ISO 5218 - Not applicable" ;
    skos:definition "concept descriptor indicating that the value for human sex is not applicable in the context that the concept is used" ;
    idmp-dtp:hasDisplayName "Not applicable" ;
    cmns-dsg:hasName idmp-sex:ISO5218-NotApplicable-Name ;
    cmns-txt:hasTextValue "9" ;
.

idmp-sex:ISO5218-NotApplicable-Name
    a
        owl:NamedIndividual ,
        idmp-sex:ISO5218-HumanSexName ;
    rdfs:label "ISO 5218 - Not applicable name" ;
    idmp-dtp:isPreferred true ;
    cmns-dsg:hasTextualName "Not applicable" ;
    cmns-dsg:isNameOf idmp-sex:ISO5218-NotApplicable ;
.

idmp-sex:ISO5218-NotKnown
    a
        owl:NamedIndividual ,
        idmp-sex:ISO5218-HumanSex ;
    rdfs:label "ISO 5218 - Not known" ;
    skos:definition "concept descriptor indicating that the human sex is not known in the context that the concept is used" ;
    idmp-dtp:hasDisplayName "Not known" ;
    cmns-dsg:hasName idmp-sex:ISO5218-NotKnown-Name ;
    cmns-txt:hasTextValue "0" ;
.

idmp-sex:ISO5218-NotKnown-Name
    a
        owl:NamedIndividual ,
        idmp-sex:ISO5218-HumanSexName ;
    rdfs:label "ISO 5218 - Not known name" ;
    idmp-dtp:isPreferred true ;
    cmns-dsg:hasTextualName "Not known" ;
    cmns-dsg:isNameOf idmp-sex:ISO5218-NotKnown ;
.

idmp-ctcae:CTCAE-AdverseEventName
    a owl:Class ;
    rdfs:label "Common Terminology Criteria for Adverse Events adverse event name" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:hasValue idmp-ctcae:CommonTerminologyCriteriaForAdverseEventsVocabulary ;
            owl:onProperty cmns-col:isIncludedIn ;
        ] ,
        [
            a owl:Restriction ;
            owl:allValuesFrom idmp-ctcae:CTCAE-AdverseEventTerm ;
            owl:onProperty cmns-dsg:isNameOf ;
        ] ,
        cmns-dsg:Name ;
    skos:definition "name denoting an adverse event term in the CTCAE vocabulary" ;
.

idmp-ctcae:CTCAE-AdverseEventTerm
    a owl:Class ;
    rdfs:label "Common Terminology Criteria for Adverse Events adverse event term" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:hasValue idmp-meddra:MedicalDictionaryForRegulatoryActivities ;
            owl:onProperty cmns-ra:isRegisteredIn ;
        ] ,
        [
            a owl:Restriction ;
            owl:hasValue idmp-ctcae:CommonTerminologyCriteriaForAdverseEventsVocabulary ;
            owl:onProperty cmns-col:isIncludedIn ;
        ] ,
        idmp-dtp:ISO21090-ConceptDescriptor ,
        idmp-meddra:MedDRATerm ,
        cmns-cls:Classifier ;
    skos:definition "term defined in the Common Terminology Criteria for Adverse Events terminology that is used to describe adverse events (AE)" ;
    cmns-av:abbreviation "CTCAE adverse event term" ;
    cmns-av:adaptedFrom "https://ctep.cancer.gov/protocoldevelopment/electronic_applications/docs/CTCAE_v5_Quick_Reference_5x7.pdf" ;
    cmns-av:explanatoryNote "An Adverse Event (AE) is any unfavorable and unintended sign (including an abnormal laboratory finding), symptom, or disease temporally associated with the use of a medical treatment or procedure that may or may not be considered related to the medical treatment or procedure." ;
.

idmp-ctcae:CTCAE-Grade1
    a
        owl:NamedIndividual ,
        idmp-ctcae:CTCAE-GradeTerm ;
    rdfs:label "Grade 1" ;
    skos:definition "mild; asymptomatic or mild symptoms; clinical or diagnostic observations only; intervention not indicated" ;
    idmp-dtp:hasDisplayName "Grade 1" ;
    cmns-av:directSource "https://ctep.cancer.gov/protocoldevelopment/electronic_applications/docs/CTCAE_v5_Quick_Reference_5x7.pdf" ;
    cmns-txt:hasTextValue "Grade 1" ;
.

idmp-ctcae:CTCAE-Grade2
    a
        owl:NamedIndividual ,
        idmp-ctcae:CTCAE-GradeTerm ;
    rdfs:label "Grade 2" ;
    skos:definition "moderate; minimal, local or noninvasive intervention indicated; limiting age-appropriate instrumental ADL" ;
    idmp-dtp:hasDisplayName "Grade 2" ;
    cmns-av:directSource "https://ctep.cancer.gov/protocoldevelopment/electronic_applications/docs/CTCAE_v5_Quick_Reference_5x7.pdf" ;
    cmns-txt:hasTextValue "Grade 2" ;
.

idmp-ctcae:CTCAE-Grade3
    a
        owl:NamedIndividual ,
        idmp-ctcae:CTCAE-GradeTerm ;
    rdfs:label "Grade 3" ;
    skos:definition "severe or medically significant but not immediately life-threatening; hospitalization or prolongation of hospitalization indicated; disabling; limiting self care ADL" ;
    idmp-dtp:hasDisplayName "Grade 3" ;
    cmns-av:directSource "https://ctep.cancer.gov/protocoldevelopment/electronic_applications/docs/CTCAE_v5_Quick_Reference_5x7.pdf" ;
    cmns-txt:hasTextValue "Grade 3" ;
.

idmp-ctcae:CTCAE-Grade4
    a
        owl:NamedIndividual ,
        idmp-ctcae:CTCAE-GradeTerm ;
    rdfs:label "Grade 4" ;
    skos:definition "life-threatening consequences; urgent intervention indicated" ;
    idmp-dtp:hasDisplayName "Grade 4" ;
