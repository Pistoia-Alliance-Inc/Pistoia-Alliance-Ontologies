    cmns-org:isDomiciledIn lcc-3166-1:Canada ;
.

idmp-narga:RegulatoryContext-ActiveMoietyForFoodAndDrugAdministrationExclusivity
    a
        owl:NamedIndividual ,
        idmp-sub:MarketContext ,
        idmp-sub:RegulatoryContext ,
        cmns-rga:Jurisdiction ;
    rdfs:label "regulatory context - active moiety (for Food and Drug Administration exclusivity)" ;
    skos:definition "regulatory reporting context covering the U.S. jurisdiction for which the FDA is the primary regulator reflecting FDA exclusivity was created by Congress to give 5-year market exclusivity to new uses of old drugs whose patents may have expired before an FDA approval, and which contain active moieties never approved by FDA" ;
    skos:note "The 'active moiety' definition is contained in statute, regulation, and case law." ;
    cmns-rga:hasReach lcc-3166-1:UnitedStatesOfAmerica ;
    cmns-rga:isJurisdictionOf idmp-narga:UnitedStatesFoodAndDrugAdministration ;
.

idmp-narga:RegulatoryContext-FoodAndDrugAdministrationGeneral
    a
        owl:NamedIndividual ,
        idmp-sub:RegulatoryContext ,
        cmns-rga:Jurisdiction ;
    rdfs:label "regulatory context - Food and Drug Administration (general)" ;
    skos:definition "regulatory reporting context covering the U.S. jurisdiction for which the FDA is the primary regulator" ;
    cmns-av:abbreviation "FDA general regulatory context" ;
    cmns-cxtdsg:isApplicableIn fibo-be-ge-usj:UnitedStatesJurisdiction ;
    cmns-rga:hasReach lcc-3166-1:UnitedStatesOfAmerica ;
    cmns-rga:isJurisdictionOf idmp-narga:UnitedStatesFoodAndDrugAdministration ;
.

idmp-narga:RegulatoryContext-HealthProductsandFoodBranchGeneral
    a
        owl:NamedIndividual ,
        idmp-sub:RegulatoryContext ,
        cmns-rga:Jurisdiction ;
    rdfs:label "regulatory context - Health Products and Food Branch (general)" ;
    cmns-cxtdsg:isApplicableIn fibo-be-ge-caj:CanadianJurisdiction ;
    cmns-rga:hasReach lcc-3166-1:Canada ;
    cmns-rga:isJurisdictionOf idmp-narga:CanadaHealthProductsandFoodBranch ;
.

idmp-narga:RegulatoryContext-PatentExclusivity
    a
        owl:NamedIndividual ,
        idmp-sub:MarketContext ,
        idmp-sub:RegulatoryContext ,
        cmns-rga:Jurisdiction ;
    rdfs:label "regulatory context - patent exclusivity" ;
    skos:definition "regulatory reporting context covering the U.S. jurisdiction for which the FDA is the primary regulator reflecting patent exclusivity, giving 20-year exclusivity that is not dependent on the 'active moiety' concept that FDA uses for NCE determination" ;
    cmns-rga:hasReach lcc-3166-1:UnitedStatesOfAmerica ;
    cmns-rga:isJurisdictionOf idmp-narga:UnitedStatesFoodAndDrugAdministration ;
.

idmp-narga:UnitedStatesDepartmentOfAgriculture
    a
        owl:NamedIndividual ,
        fibo-be-ge-ge:GovernmentAgency ;
    rdfs:label "United States Department of Agriculture" ;
    rdfs:seeAlso <https://www.usda.gov/> ;
    skos:definition "U.S. federal executive department responsible for developing and executing federal laws related to farming, forestry, rural economic development, and food, including food safety." ;
    cmns-av:abbreviation "USDA" ;
    cmns-org:isDomiciledIn lcc-3166-1:UnitedStatesOfAmerica ;
.

idmp-narga:UnitedStatesFoodAndDrugAdministration
    a
        owl:NamedIndividual ,
        fibo-be-ge-ge:GovernmentAgency ;
    rdfs:label "United States Food and Drug Administration" ;
    rdfs:seeAlso <https://www.fda.gov/> ;
    skos:definition "U.S. government agency responsible for protecting the public health by ensuring the safety, efficacy, and security of human and veterinary drugs, biological products, and medical devices; and by ensuring the safety of our nation's food supply, cosmetics, and products that emit radiation." ;
    cmns-av:abbreviation "FDA" ;
    cmns-av:explanatoryNote "FDA is responsible for advancing the public health by helping to speed innovations that make medical products more effective, safer, and more affordable and by helping the public get the accurate, science-based information they need to use medical products and foods to maintain and improve their health." ;
    cmns-org:isDomiciledIn lcc-3166-1:UnitedStatesOfAmerica ;
.

idmp-narga:UnitedStatesFoodAndDrugAdministrationAsMedicinesRegulatoryAgency
    a
        owl:NamedIndividual ,
        idmp-mprd:MedicinesRegulatoryAgency ;
    rdfs:label "United States Food and Drug Administration as medicines regulatory agency" ;
    skos:definition "United States Food and Drug Administration in its role as a regulator of medicinal products" ;
    cmns-rga:hasJurisdiction
        fibo-be-ge-usj:UnitedStatesJurisdiction ,
        idmp-narga:RegulatoryContext-ActiveMoietyForFoodAndDrugAdministrationExclusivity ,
        idmp-narga:RegulatoryContext-FoodAndDrugAdministrationGeneral ,
        idmp-narga:RegulatoryContext-PatentExclusivity ;
    cmns-rlcmp:isPlayedBy idmp-narga:UnitedStatesFoodAndDrugAdministration ;
.

<https://spec.pistoiaalliance.org/idmp/ontology/IdentificationOfMedicinalProducts-Full/>
    a owl:Ontology ;
    rdfs:label "Identification of Medicinal Products Ontology Full" ;
    dcterms:abstract """The Identification of Medicinal Products Ontology (IDMP-O) enables deep, semantic interoperability based on FAIR principles to enhance and augment the existing IDMP standards.

The European Medicines Agency (EMA) is the first health agency to mandate compliance with ISO IDMP (as of Q4 2024), with the FDA not far behind. Governance of essential IDMP standards and implementations is not assigned to a specific, overarching governing body. Diverging implementations of IDMP across geographical regions and jurisdictional domains are already causing inconsistencies in the interpretation across implementing organizations. Given that there is no semantic alignment between regulatory bodies, there exists a risk that regulatory compliance needs will lead to large integration and interoperability costs and that the benefits from IDMP in drug safety, innovation, and other areas will not be fully realized. Rather than concentrating on the discovery of new medicines, organizations will be struggling with data issues, e.g., the need to map product data across the organization, throughout the product lifecycle.

IDMP-O provides significant added value to the ISO IDMP standards for data integration, interoperability, and usability across organizational boundaries and regulatory jurisdictions.""" ;
    dcterms:bibliographicCitation "https://www.pistoiaalliance.org/projects/current-projects/idmp-ontology/" ;
    dcterms:contributor
        "AbbVie Inc." ,
