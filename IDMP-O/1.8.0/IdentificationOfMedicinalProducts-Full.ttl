fibo-be-ge-euj:EuropeanCommission
    a
        owl:NamedIndividual ,
        fibo-be-ge-ge:SupranationalEntity ;
    rdfs:label "European Commission" ;
    skos:definition "supranational entity that helps to shape the EU's overall strategy, proposes new EU laws and policies, monitors their implementation and manages the EU budget" ;
    skos:note "The European Commission also plays a significant role in supporting international development and delivering aid." ;
    cmns-av:abbreviation "EC" ;
    cmns-av:directSource <https://ec.europa.eu/info/about-european-commission> ;
.

fibo-be-ge-euj:EuropeanCommissionAsRegulatoryAgency
    a
        owl:NamedIndividual ,
        cmns-rga:RegulatoryAgency ;
    rdfs:label "European Commission as regulatory agency" ;
    skos:definition "European Commission in its role as a regulator with shared jurisdiction over the European Union" ;
    cmns-rga:hasJurisdiction fibo-be-ge-euj:EuropeanUnionJurisdiction ;
    cmns-rlcmp:isPlayedBy fibo-be-ge-euj:EuropeanCommission ;
.

fibo-be-ge-euj:EuropeanEconomicArea
    a
        owl:NamedIndividual ,
        cmns-rga:Jurisdiction ;
    rdfs:label "European Economic Area jurisdiction" ;
    dcterms:source "https://ec.europa.eu/eurostat/statistics-explained/index.php?title=Glossary:European_Economic_Area_(EEA)"^^xsd:anyURI ;
    skos:definition "jurisdiction that consists of the member states of the European Union (EU) and three countries of the European Free Trade Association (EFTA) (Iceland, Liechtenstein and Norway; excluding Switzerland)" ;
    cmns-av:abbreviation "EEA" ;
    cmns-av:explanatoryNote "The Agreement on the EEA entered into force on 1 January 1994. It seeks to strengthen trade and economic relations between the contracting parties and is principally concerned with the four fundamental pillars of the internal market, namely: the free movement of goods, people, services and capital. The availability of comparable statistical data is considered as relevant to the four freedoms and is therefore included in the agreement." ;
    cmns-rga:hasReach
        lcc-3166-1:Austria ,
        lcc-3166-1:Belgium ,
        lcc-3166-1:Bulgaria ,
        lcc-3166-1:Croatia ,
        lcc-3166-1:Cyprus ,
        lcc-3166-1:Czechia ,
        lcc-3166-1:Denmark ,
        lcc-3166-1:Estonia ,
        lcc-3166-1:Finland ,
        lcc-3166-1:France ,
        lcc-3166-1:Germany ,
        lcc-3166-1:Greece ,
        lcc-3166-1:Hungary ,
        lcc-3166-1:Iceland ,
        lcc-3166-1:Ireland ,
        lcc-3166-1:Italy ,
        lcc-3166-1:Latvia ,
        lcc-3166-1:Liechtenstein ,
        lcc-3166-1:Lithuania ,
        lcc-3166-1:Luxembourg ,
        lcc-3166-1:Malta ,
        lcc-3166-1:Netherlands ,
        lcc-3166-1:Norway ,
        lcc-3166-1:Poland ,
        lcc-3166-1:Portugal ,
        lcc-3166-1:Romania ,
        lcc-3166-1:Slovakia ,
        lcc-3166-1:Slovenia ,
        lcc-3166-1:Spain ,
        lcc-3166-1:Sweden ;
    cmns-rga:isJurisdictionOf idmp-eurga:EuropeanMedicinesAgency ;
.

fibo-be-ge-euj:EuropeanFreeTradeAssociation
    a
        owl:NamedIndividual ,
        fibo-be-ge-ge:SupranationalEntity ;
    rdfs:label "European Free Trade Association" ;
    skos:definition "intergovernmental organization of Iceland, Liechtenstein, Norway and Switzerland set up for the promotion of free trade and economic cooperation between its members, within Europe, and globally" ;
    skos:note "EFTA was established in 1960 by its then seven Member States for the promotion of free trade and economic integration between its members. The four EFTA States are competitive in several sectors vital to the global economy and score among the highest in the world in competitiveness, wealth creation per inhabitant, life expectancy and quality of life." ;
    cmns-av:abbreviation "EFTA" ;
    cmns-av:adaptedFrom "https://www.efta.int/about-efta"^^xsd:anyURI ;
    cmns-col:hasMember
        fibo-be-ge-neuj:IcelandicEntity ,
        fibo-be-ge-neuj:NorwegianEntity ,
        fibo-be-ge-weuj:LiechtensteinerEntity ,
        fibo-be-ge-weuj:SwissEntity ;
.

