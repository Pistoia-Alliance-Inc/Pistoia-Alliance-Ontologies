idmp-ctcae:CommonTerminologyCriteriaForAdverseEventsClassificationScheme
    a
        owl:NamedIndividual ,
        cmns-cls:ClassificationScheme ;
    rdfs:label "Common Terminology Criteria for Adverse Events classification scheme" ;
    skos:definition "classification scheme describing criteria for the classification of adverse events by severity" ;
    cmns-org:isManagedBy idmp-nara:NationalCancerInstituteRegistrationAuthority ;
.

idmp-ctcae:CommonTerminologyCriteriaForAdverseEventsVocabulary
    a
        owl:NamedIndividual ,
        idmp-dtp:ControlledVocabulary ;
    rdfs:label "Common Terminology Criteria for Adverse Events vocabulary" ;
    skos:definition "The NCI Common Terminology Criteria for Adverse Events is a descriptive terminology which can be utilized for Adverse Event (AE) reporting. A grading (severity) scale is provided for each AE term." ;
    skos:note "Entries in the vocabulary denoting adverse event types are registered in MedDRA." ;
    cmns-av:abbreviation "CTCAE vocabulary" ;
    cmns-av:synonym
        "CTCAE terminology" ,
        "Common Terminology Criteria for Adverse Events terminology" ;
    cmns-org:isManagedBy idmp-nara:NationalCancerInstituteRegistrationAuthority ;
.

