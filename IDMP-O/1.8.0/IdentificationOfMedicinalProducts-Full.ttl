        cmns-rga:Jurisdiction ;
    rdfs:label "regulatory context - European Medicines Agency (general)" ;
    cmns-cxtdsg:isApplicableIn fibo-be-ge-euj:EuropeanUnionJurisdiction ;
    cmns-rga:isJurisdictionOf idmp-eurga:EuropeanMedicinesAgency ;
.

idmp-eurga:SwissFederalOfficeOfPublicHealth
    a
        owl:NamedIndividual ,
        fibo-be-ge-ge:Instrumentality ;
    rdfs:label "Federal Office of Public Health" ;
    rdfs:seeAlso <https://www.bag.admin.ch/> ;
    skos:definition "agency of the Swiss Confederation responsible for the scientific evaluation, supervision and safety monitoring of medicines" ;
    fibo-be-ge-ge:isInstrumentOf fibo-be-ge-weuj:GovernmentOfTheSwissConfederation ;
    cmns-av:abbreviation "FOPH" ;
.

idmp-eurga:SwissFederalOfficeOfPublicHealth-General
    a
        owl:NamedIndividual ,
        idmp-sub:RegulatoryContext ,
        cmns-rga:Jurisdiction ;
    rdfs:label "regulatory context - Federal Office of Public Health (general)" ;
    cmns-cxtdsg:isApplicableIn fibo-be-ge-weuj:JurisdictionOfSwitzerland ;
    cmns-rga:hasReach lcc-3166-1:Switzerland ;
    cmns-rga:isJurisdictionOf idmp-eurga:SwissFederalOfficeOfPublicHealth ;
.

idmp-nara:AmericanChemicalSociety
    a
        owl:NamedIndividual ,
        cmns-org:FormalOrganization ;
    rdfs:label "American Chemical Society" ;
    skos:definition "scientific society based in the United States that supports scientific inquiry in the field of chemistry" ;
    cmns-av:abbreviation "ACS" ;
    cmns-av:adaptedFrom "ISO 11238:2018 Health informatics - Identification of medicinal products (IDMP) - Data elements and structures for the unique identification and exchange of regulated information on substances, clause A.1.2" ;
    cmns-av:explanatoryNote "Founded in 1876 at New York University, the ACS has more than 155,000 members at all degree levels and in all fields of chemistry, chemical engineering, and related fields. It is one of the world's largest scientific societies by membership. The ACS is a 501(c)(3) non-profit organization and holds a congressional charter under Title 36 of the United States Code. Its headquarters are located in Washington, D.C., and it has a large concentration of staff in Columbus, Ohio." ;
    cmns-org:isDomiciledIn lcc-3166-1:UnitedStatesOfAmerica ;
.

idmp-nara:AmericanChemicalSocietyRegistrationAuthority
    a
        owl:NamedIndividual ,
        cmns-ra:RegistrationAuthority ;
    rdfs:label "American Chemical Society Registration Authority" ;
    skos:definition "American Chemical Society (ACS) in its role as a Registration Authority (RA), which is a function of the ACS for registration of substances in the CAS Registry" ;
    cmns-av:abbreviation "ACS RA" ;
    cmns-av:adaptedFrom "ISO 11238:2018 Health informatics - Identification of medicinal products (IDMP) - Data elements and structures for the unique identification and exchange of regulated information on substances, clause A.1.2" ;
    cmns-org:manages idmp-nara:ChemicalAbstractsServiceRegistry ;
    cmns-org:provides idmp-nara:ChemicalAbstractsService ;
    cmns-rlcmp:isPlayedBy idmp-nara:AmericanChemicalSociety ;
.

idmp-nara:CASRegistryNumber
    a owl:Class ;
    rdfs:label "CAS registry number" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    dcterms:source "ISO 11238:2018 Health informatics - Identification of medicinal products (IDMP) - Data elements and structures for the unique identification and exchange of regulated information on substances, clauses 3.9, A.1.2" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:onProperty cmns-id:identifies ;
            owl:someValuesFrom idmp-sub:Substance ;
        ] ,
        [
            a owl:Restriction ;
            owl:hasValue idmp-nara:ChemicalAbstractsServiceRegistry ;
            owl:onProperty cmns-ra:isRegisteredIn ;
        ] ,
        [
            a owl:Restriction ;
            owl:hasValue idmp-nara:AmericanChemicalSocietyRegistrationAuthority ;
            owl:onProperty cmns-ra:hasRegistrationAuthority ;
        ] ,
        idmp-sub:SubstanceCode ;
    skos:definition "unique numerical identifier of a substance in the CAS Registry system" ;
    skos:note "The numbers are sequential and are assigned as a substance enters the registry system. The numbers do not have a common length and lengths can be up to 10 digits. Each CAS number contains a single check digit. The assignment of chemical names is done according to the chemical nomenclature rules for CA index names, which is slightly different from the internationally standard IUPAC names, according to the rules of IUPAC." ;
    skos:scopeNote "Polymers frequently only have one CAS registry number associated with them, regardless of differences in molecular mass or other defining elements." ;
    cmns-av:synonym
        "CAS Registry Number" ,
        "CAS number" ;
    cmns-av:usageNote "Although CAS numbers are widely used, they cannot be freely used. CAS has guidelines on the use of CAS registry numbers and has attempted to restrict their use in publicly available databases." ;
.

idmp-nara:CentersForDiseaseControlAndPrevention
    a
        owl:NamedIndividual ,
        fibo-be-ge-ge:GovernmentAgency ;
    rdfs:label "Centers for Disease Control and Prevention" ;
    cmns-av:acronym "CDC" ;
    cmns-av:directSource <https://www.cdc.gov/> ;
    cmns-col:isConstituentOf idmp-nara:DepartmentOfHealthAndHumanServices ;
.

idmp-nara:CentersForDiseaseControlAndPreventionRegistrationAuthority
    a
        owl:NamedIndividual ,
        cmns-ra:RegistrationAuthority ;
    rdfs:label "Centers for Disease Control and Prevention Registration Authority" ;
    skos:definition "Centers for Disease Control and Prevention in its role as a Registration Authority (RA)" ;
    cmns-rlcmp:isPlayedBy idmp-nara:CentersForDiseaseControlAndPrevention ;
.

idmp-nara:ChemicalAbstractsService
    a
        owl:NamedIndividual ,
        cmns-ra:RegistrationService ;
    rdfs:label "Chemical Abstracts Service" ;
    skos:definition "service that provides a periodical index that provides numerous tools such as SciFinder as well as tagged keywords, summaries, indexes of disclosures, and structures of compounds in recently published scientific documents" ;
    cmns-av:abbreviation "CAS" ;
    cmns-av:adaptedFrom "ISO 11238:2018 Health informatics - Identification of medicinal products (IDMP) - Data elements and structures for the unique identification and exchange of regulated information on substances, clause A.1.2" ;
    cmns-av:explanatoryNote "Approximately 8,000 journals, technical reports, dissertations, conference proceedings, and new books, available in at least 50 different languages, are monitored yearly, as are patent specifications from 27 countries and two international organizations. Chemical Abstracts ceased print publication on January 1, 2010." ;
    cmns-org:isProvidedBy idmp-nara:AmericanChemicalSocietyRegistrationAuthority ;
.

idmp-nara:ChemicalAbstractsServiceRegistry
    a
        owl:NamedIndividual ,
        cmns-ra:Registry ;
    rdfs:label "Chemical Abstracts Service registry" ;
    skos:definition "registry that contains information on more than 130 million organic and inorganic substances, and more than 64 million protein and nucleic acid sequences" ;
    cmns-av:abbreviation
        "CAS Chemical Registry System" ,
        "CAS Registry" ;
    cmns-av:adaptedFrom "ISO 11238:2018 Health informatics - Identification of medicinal products (IDMP) - Data elements and structures for the unique identification and exchange of regulated information on substances, clause A.1.2" ;
    cmns-av:explanatoryNote "The sequence information comes from CAS and GenBank, produced by the National Institutes of Health. The chemical information is produced by CAS, and is prepared by the CAS Registry System, which identifies each compound with a specific CAS registry number, index name, and graphic representation of its chemical structure. The assignment of chemical names is done according to the chemical nomenclature rules for CA index names, which is slightly different from the internationally standard IUPAC names, according to the rules of IUPAC." ;
    cmns-dsg:hasTextualName "Chemical Abstracts Service Registry" ;
    cmns-org:isManagedBy idmp-nara:AmericanChemicalSocietyRegistrationAuthority ;
.

idmp-nara:ChemicalAbstractsServiceRegistryEntry
    a owl:Class ;
    rdfs:label "Chemical Abstracts Service registry entry" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom idmp-nara:CASRegistryNumber ;
        ] ,
        [
            a owl:Restriction ;
            owl:hasValue idmp-nara:ChemicalAbstractsServiceRegistry ;
            owl:onProperty cmns-col:isIncludedIn ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty cmns-cxtdsg:appliesTo ;
            owl:someValuesFrom idmp-sub:Substance ;
        ] ,
        cmns-ra:RegistryEntry ;
    skos:definition "entry in the Chemical Abstracts Service (CAS) registry, prepared by the CAS Registry System, that identifies each compound with a specific CAS registry number, index name, and graphic representation of its chemical structure" ;
    cmns-av:adaptedFrom "ISO 11238:2018 Health informatics - Identification of medicinal products (IDMP) - Data elements and structures for the unique identification and exchange of regulated information on substances, clause A.1.2" ;
.

idmp-nara:ClinicalTrialsGov
    a
        owl:NamedIndividual ,
        cmns-ra:Registry ;
    rdfs:label "ClinicalTrials.gov" ;
    skos:definition "database of privately and publicly funded clinical studies conducted around the world" ;
    cmns-av:directSource <https://clinicaltrials.gov/> ;
    cmns-dsg:hasTextualName "ClinicalTrials.gov" ;
    cmns-org:isManagedBy idmp-nara:NationalLibraryOfMedicineRegistrationAuthority ;
.

idmp-nara:CosmeticIngredientReview
    a
        owl:NamedIndividual ,
        cmns-org:FormalOrganization ;
    rdfs:label "Cosmetic Ingredient Review" ;
    skos:definition "independent scientific review board in the United States that reviews and assesses the safety of ingredients in an open, unbiased, and expert manner, and publishes the results in the peer-reviewed scientific literature" ;
    cmns-av:abbreviation "CIR" ;
    cmns-av:directSource <https://www.cir-safety.org/> ;
    cmns-av:explanatoryNote "The Cosmetic Ingredient Review was established in 1976 by the industry trade association (then the Cosmetic, Toiletry, and Fragrance Association, now the Personal Care Products Council), with the support of the U.S. Food and Drug Administration and the Consumer Federation of America. Although funded by the Council, CIR, the Expert Panel for Cosmetic Ingredient Safety, and the review process are independent from the Council and the cosmetics industry. CIR and the Expert Panel for Cosmetic Ingredient Safety operate under a set of procedures." ;
    cmns-org:isDomiciledIn lcc-3166-1:UnitedStatesOfAmerica ;
.

idmp-nara:CosmeticIngredientReviewDatabase
    a
        owl:NamedIndividual ,
        cmns-ra:Registry ;
    rdfs:label "Cosmetic Ingredient Review Database" ;
    skos:definition "repository that provides reviews and assesses the safety of ingredients in an open, unbiased, and expert manner, and publish the results in the peer-reviewed scientific literature" ;
    cmns-av:directSource <https://www.cir-safety.org/> ;
    cmns-dsg:hasTextualName "Cosmetic Ingredient Review Database" ;
    cmns-org:isManagedBy idmp-nara:CosmeticIngredientReviewRegistrationAuthority ;
.

idmp-nara:CosmeticIngredientReviewRegistrationAuthority
    a
        owl:NamedIndividual ,
        cmns-ra:RegistrationAuthority ;
    rdfs:label "Cosmetic Ingredient Review Registration Authority" ;
    skos:definition "Cosmetic Ingredient Review (CIR) in its role as a Registration Authority (RA), for content that reflects the review and assessment of the safety of ingredients" ;
    cmns-av:abbreviation "CIR RA" ;
    cmns-org:manages idmp-nara:CosmeticIngredientReviewDatabase ;
    cmns-rlcmp:isPlayedBy idmp-narga:UnitedStatesFoodAndDrugAdministration ;
.

idmp-nara:DepartmentOfAgricultureRegistrationAuthority
    a
        owl:NamedIndividual ,
        cmns-ra:RegistrationAuthority ;
    rdfs:label "Department of Agriculture Registration Authority" ;
    skos:definition "United States Department of Agriculture in its role as a Registration Authority (RA)" ;
    cmns-org:manages idmp-nara:GermplasmResourcesInformationNetwork ;
    cmns-rlcmp:isPlayedBy idmp-narga:UnitedStatesDepartmentOfAgriculture ;
.

idmp-nara:DepartmentOfHealthAndHumanServices
    a
        owl:NamedIndividual ,
        fibo-be-ge-ge:GovernmentDepartment ;
    rdfs:label "U.S. Department of Health and Human Services" ;
    cmns-av:directSource <https://www.hhs.gov> ;
.

idmp-nara:DrugBank
    a
        owl:NamedIndividual ,
        cmns-ra:Registry ;
    rdfs:label "Drug Bank" ;
    skos:definition "online database containing information on drugs and drug targets" ;
    cmns-av:directSource <https://go.drugbank.com/> ;
    cmns-dsg:hasTextualName "Drug Bank" ;
    cmns-org:isManagedBy idmp-nara:OMxPersonalHealthAnalyticsIncAsRegistrationAuthority ;
.

idmp-nara:FoodAndDrugAdministrationRegistrationAuthority
    a
        owl:NamedIndividual ,
        cmns-ra:RegistrationAuthority ;
    rdfs:label "Food and Drug Administration Registration Authority" ;
    skos:definition "Food and Drug Administration (FDA) in its role as a Registration Authority (RA), which is a function of the G-SRS for registration of substances in the FDA/USP Global Substance Registry System" ;
    cmns-av:abbreviation "FDA G-SRS RA" ;
    cmns-av:adaptedFrom "ISO 11238:2018 Health informatics - Identification of medicinal products (IDMP) - Data elements and structures for the unique identification and exchange of regulated information on substances, clause A.1.5" ;
    cmns-org:manages idmp-nara:GlobalSubstanceRegistrationSystem ;
    cmns-rlcmp:isPlayedBy idmp-narga:UnitedStatesFoodAndDrugAdministration ;
.

idmp-nara:GermplasmResourcesInformationNetwork
    a
        owl:NamedIndividual ,
        cmns-ra:Registry ;
    rdfs:label "Germplasm Resources Information Network" ;
    skos:definition "repository that documents animal, microbial, and plant collections through informational pages, searchable databases, and links to USDA-ARS projects that curate the collections" ;
    cmns-av:abbreviation "GRIN" ;
    cmns-av:directSource <https://www.ars-grin.gov/> ;
    cmns-dsg:hasTextualName "Germplasm Resources Information Network" ;
    cmns-org:isManagedBy idmp-nara:DepartmentOfAgricultureRegistrationAuthority ;
.

idmp-nara:GlobalSubstanceRegistrationSystem
    a
        owl:NamedIndividual ,
        cmns-ra:Registry ;
    rdfs:label "Global Substance Registration System" ;
    skos:definition "registry that was developed to assist regulators in managing substance information" ;
    cmns-av:abbreviation
        "G-SRS" ,
        "GSRS" ;
    cmns-av:adaptedFrom "ISO 11238:2018 Health informatics - Identification of medicinal products (IDMP) - Data elements and structures for the unique identification and exchange of regulated information on substances, clause A.1.5" ;
    cmns-av:explanatoryNote "GSRS was designed to facilitate global monitoring of human and animal medicinal, food, tobacco, and cosmetic products. GSRS provides unique substance identifiers consistent with the ISO 11238 standard. FDA's GSRS specifically generates the Unique Ingredient Identifiers (UNIIs) used in electronic listing and other regulatory activities." ;
    cmns-dsg:hasTextualName "Global Substance Registration System - GSRS" ;
    cmns-org:isManagedBy idmp-nara:FoodAndDrugAdministrationRegistrationAuthority ;
.

idmp-nara:GlobalSubstanceRegistrationSystemEntry
    a owl:Class ;
    rdfs:label "Global Substance Registry System registry entry" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:hasValue idmp-nara:GlobalSubstanceRegistrationSystem ;
            owl:onProperty cmns-col:isIncludedIn ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty cmns-cxtdsg:appliesTo ;
            owl:someValuesFrom idmp-sub:Substance ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom idmp-nara:UniqueIngredientNumber ;
        ] ,
        cmns-ra:RegistryEntry ;
    skos:definition "entry in the Global Substance Registry System (GSRS) registry, that includes the Unique Ingredient Identifiers (UNIIs) used in electronic listing and other regulatory activities" ;
    cmns-av:adaptedFrom "ISO 11238:2018 Health informatics - Identification of medicinal products (IDMP) - Data elements and structures for the unique identification and exchange of regulated information on substances, clause A.1.5" ;
.

idmp-nara:GlobalSubstanceRegistryService
    a
        owl:NamedIndividual ,
        cmns-ra:RegistrationService ;
    rdfs:label "global substance registration service" ;
    skos:definition "service with detailed business rules for data entry and generation of UNIIs for both simple and complex substances" ;
    cmns-av:abbreviation "G-SRS service" ;
    cmns-av:adaptedFrom "ISO 11238:2018 Health informatics - Identification of medicinal products (IDMP) - Data elements and structures for the unique identification and exchange of regulated information on substances, clause A.1.5" ;
    cmns-org:isProvidedBy idmp-nara:FoodAndDrugAdministrationRegistrationAuthority ;
.

idmp-nara:IntegratedTaxonomicInformationSystem
    a
        owl:NamedIndividual ,
        cmns-ra:Registry ;
    rdfs:label "Integrated Taxonomic Information System" ;
    rdfs:altLabel "Interagency Taxonomic Information System" ;
    skos:definition "registry that provides standardized information about the vascular plants, mosses, liverworts, hornworts, and lichens of the U.S. and its territories" ;
    cmns-av:abbreviation "ITIS" ;
    cmns-av:explanatoryNote "The ITIS includes names, plant symbols, checklists, distributional data, species abstracts, characteristics, images, crop information, automated tools, onward Web links, and references. This information primarily promotes land conservation in the United States and its territories, but academic, educational, and general use is encouraged." ;
    cmns-dsg:hasTextualName "Integrated Taxonomic Information System" ;
    cmns-org:isManagedBy idmp-nara:IntegratedTaxonomicInformationSystemRegistrationAuthority ;
.

idmp-nara:IntegratedTaxonomicInformationSystemEntry
    a owl:Class ;
    rdfs:label "Integrated Taxonomic Information System registry entry" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:onProperty cmns-col:comprises ;
            owl:someValuesFrom idmp-nara:IntegratedTaxonomicInformationSystemTaxonomicSerialNumber ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty cmns-cxtdsg:appliesTo ;
            owl:someValuesFrom idmp-sub:Substance ;
        ] ,
        [
            a owl:Restriction ;
            owl:hasValue idmp-nara:IntegratedTaxonomicInformationSystem ;
            owl:onProperty cmns-col:isIncludedIn ;
        ] ,
        cmns-ra:RegistryEntry ;
    skos:definition "entry in the Integrated Taxonomic Information System registry comprised of a Taxonomix Serial Number used in electronic listing and other regulatory activities" ;
    cmns-av:abbreviation "ITIS entry" ;
.

idmp-nara:IntegratedTaxonomicInformationSystemOrganization
    a
        owl:NamedIndividual ,
        cmns-org:FormalOrganization ;
    rdfs:label "ITIS Organization" ;
    rdfs:seeAlso <https://www.itis.gov/organ.html> ;
    skos:definition "group of agencies consisting of a steering committee and technical working committees for database design and quality management for the content provided in the Integrated Taxonomic Information System" ;
    cmns-av:explanatoryNote "These agencies signed a Memorandum of Understanding and have formed a Steering Committee that directs two technical work groups - the Database Work Group (DWG) and the Taxonomy Work Group (TWG). The DWG is responsible for the database design and overseeing development of the system to meet the requirements of the ITIS partners. The TWG is responsible for the quality and integrity of the database information. In addition to the database, the working groups have created \"Taxonomic Workbench\" software designed for easy entry and manipulation of taxonomic data." ;
.

idmp-nara:IntegratedTaxonomicInformationSystemRegistrationAuthority
    a
        owl:NamedIndividual ,
        cmns-ra:RegistrationAuthority ;
    rdfs:label "Integrated Taxonomic Information System Registration Authority" ;
    skos:definition "Integrated Taxonomic Information System (ITIS) in its role as a Registration Authority (RA), which is multi-agency organization that involves specialists from around the world to assemble scientific names and their taxonomic relationships, and distribute that data through publicly available software" ;
    cmns-av:abbreviation "ITIS" ;
    cmns-org:manages idmp-nara:IntegratedTaxonomicInformationSystem ;
    cmns-rlcmp:isPlayedBy idmp-nara:IntegratedTaxonomicInformationSystemOrganization ;
.

idmp-nara:IntegratedTaxonomicInformationSystemTaxonomicSerialNumber
    a owl:Class ;
    rdfs:label "Integrated Taxonomic Information System Taxonomic Serial Number" ;
    dcterms:creator "Pistoia Alliance IDMP-O working group" ;
    rdfs:subClassOf 
        [
            a owl:Restriction ;
            owl:hasValue idmp-nara:IntegratedTaxonomicInformationSystem ;
            owl:onProperty cmns-dsg:isDefinedIn ;
        ] ,
        [
            a owl:Restriction ;
            owl:onProperty cmns-cxtdsg:appliesTo ;
            owl:someValuesFrom idmp-sub:Substance ;
        ] ,
        cmns-ra:RegisteredIdentifier ;
    skos:definition "unique identifier for an entry in the Integrated Taxonomic Information System registry used in electronic listing and other regulatory activities" ;
    cmns-av:synonym "TSN" ;
.

