    cmns-rga:hasReach lcc-3166-1:Spain ;
    cmns-rga:isJurisdictionOf fibo-be-ge-seuj:GovernmentOfTheKingdomOfSpain ;
.

fibo-be-ge-seuj:JurisdictionOfTheHolySee
