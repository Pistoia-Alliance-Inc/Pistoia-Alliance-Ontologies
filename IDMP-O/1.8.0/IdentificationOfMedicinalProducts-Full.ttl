    rdfs:seeAlso <http://www.wisconsin.gov/Pages/government.aspx> ;
    skos:definition "individual representing the regional government of the US State of Wisconsin" ;
    cmns-rga:governs lcc-3166-2-us:Wisconsin ;
    cmns-rga:hasJurisdiction fibo-be-ge-usj:StateOfWisconsinJurisdiction ;
.

fibo-be-ge-usj:StateOfWisconsinJurisdiction
    a
        owl:NamedIndividual ,
        cmns-rga:Jurisdiction ;
    rdfs:label "State of Wisconsin jurisdiction" ;
    rdfs:isDefinedBy fibo-be-ge-usj: ;
    rdfs:seeAlso <http://www.wisconsin.gov/Pages/courtsAndLaw.aspx> ;
    skos:definition "individual representing the overall jurisdiction for the US State of Wisconsin, i.e., that of the Wisconsin Supreme Court and Judiciary" ;
    cmns-rga:hasReach lcc-3166-2-us:Wisconsin ;
    cmns-rga:isJurisdictionOf fibo-be-ge-usj:StateOfWisconsinGovernment ;
.

fibo-be-ge-usj:StateOfWyomingEntity
    a
        owl:NamedIndividual ,
        fibo-be-ge-ge:RegionalSovereignty ;
    rdfs:label "State of Wyoming entity" ;
    rdfs:isDefinedBy fibo-be-ge-usj: ;
    rdfs:seeAlso <http://www.wyo.gov/> ;
    skos:definition "individual representing the regional sovereignty and polity that is the US State of Wyoming" ;
    fibo-be-ge-ge:hasSharedSovereigntyOver lcc-3166-2-us:Wyoming ;
    fibo-be-ge-ge:isRepresentedBy fibo-be-ge-usj:StateOfWyomingGovernment ;
.

fibo-be-ge-usj:StateOfWyomingGovernment
    a
        owl:NamedIndividual ,
        fibo-be-ge-ge:RegionalGovernment ;
    rdfs:label "State of Wyoming government" ;
    rdfs:isDefinedBy fibo-be-ge-usj: ;
    rdfs:seeAlso <http://www.wyo.gov/> ;
    skos:definition "individual representing the regional government of the US State of Wyoming" ;
    cmns-rga:governs lcc-3166-2-us:Wyoming ;
    cmns-rga:hasJurisdiction fibo-be-ge-usj:StateOfWyomingJurisdiction ;
.

fibo-be-ge-usj:StateOfWyomingJurisdiction
    a
        owl:NamedIndividual ,
        cmns-rga:Jurisdiction ;
    rdfs:label "State of Wyoming jurisdiction" ;
    rdfs:isDefinedBy fibo-be-ge-usj: ;
    rdfs:seeAlso <http://www.wyo.gov/> ;
    skos:definition "individual representing the overall jurisdiction for the US State of Wyoming, i.e., that of the Wyoming Supreme Court and Judiciary" ;
    cmns-rga:hasReach lcc-3166-2-us:Wyoming ;
    cmns-rga:isJurisdictionOf fibo-be-ge-usj:StateOfWyomingGovernment ;
.

fibo-be-ge-usj:UnitedStatesEntity
    a
        owl:NamedIndividual ,
        fibo-be-ge-ge:FederatedSovereignty ;
    rdfs:label "United States entity" ;
    rdfs:isDefinedBy fibo-be-ge-usj: ;
    rdfs:seeAlso <https://www.usa.gov/> ;
    skos:definition "individual representing the federated sovereignty and polity that is the United States of America" ;
    fibo-be-ge-ge:hasFullSovereigntyOver lcc-3166-1:UnitedStatesOfAmerica ;
    fibo-be-ge-ge:hasSharedSovereigntyOver
        lcc-3166-2-us:Alabama ,
        lcc-3166-2-us:Alaska ,
        lcc-3166-2-us:AmericanSamoa ,
        lcc-3166-2-us:Arizona ,
        lcc-3166-2-us:Arkansas ,
        lcc-3166-2-us:California ,
        lcc-3166-2-us:Colorado ,
        lcc-3166-2-us:Connecticut ,
        lcc-3166-2-us:Delaware ,
        lcc-3166-2-us:DistrictOfColumbia ,
        lcc-3166-2-us:Florida ,
        lcc-3166-2-us:Georgia ,
        lcc-3166-2-us:Guam ,
        lcc-3166-2-us:Hawaii ,
        lcc-3166-2-us:Idaho ,
        lcc-3166-2-us:Illinois ,
        lcc-3166-2-us:Indiana ,
        lcc-3166-2-us:Iowa ,
        lcc-3166-2-us:Kansas ,
