idmp-sub:ISO19844-CodeSet
    a
        owl:NamedIndividual ,
        cmns-cds:CodeSet ;
    rdfs:label "ISO 19844 code set" ;
    rdfs:seeAlso "https://www.iso.org/standard/71965.html"^^xsd:anyURI ;
