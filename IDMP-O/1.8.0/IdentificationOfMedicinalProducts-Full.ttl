idmp-nara:NationalDrugFileReferenceTerminology
    a
        owl:NamedIndividual ,
        cmns-ra:Registry ;
    rdfs:label "National Drug File - Reference Terminology" ;
    skos:definition "legacy registry that was published by the U.S. Department of Veterans Affairs, Veterans Health Administration, providing standard names for (1) mechanism of action, (2) Physiologic Effect and (3) Structural Class for drugs NDF-RT is part of the Federal Medication Terminologies." ;
    skos:scopeNote "NDF-RT is part of the Federal Medication Terminologies. Publication of NDF-RT has ended. The Medication Reference Terminology (MED-RT) is the evolutionary successor to the Veterans Health Administration National Drug File." ;
    cmns-av:abbreviation "NDF-RT" ;
    cmns-av:directSource "https://evs.nci.nih.gov/ftp1/NDF-RT/" ;
    cmns-dsg:hasTextualName "National Drug File - Reference Terminology (NDF-RT)" ;
    cmns-org:isManagedBy idmp-nara:VeteransHealthAdministrationRegistrationAuthority ;
.

